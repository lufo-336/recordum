<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Recordum.Core\Recordum.Core.csproj" />
    <ProjectReference Include="..\Recordum.Plugins.Contracts\Recordum.Plugins.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- .Sqlite.Core, NON .Sqlite: il pacchetto completo tira dentro SQLitePCLRaw.bundle_e_sqlite3,
         che spedisce un SQLitePCLRaw.batteries_v2.dll con lo STESSO nome di quello del bundle cifrato
         (SQLite3MC.PCLRaw.bundle). Nell output ne sopravvive uno solo — vince la versione piu alta — e se
         vince e_sqlite3 il provider registrato e quello in chiaro: PRAGMA key diventa un no-op
         silenzioso e il database viene scritto NON cifrato (SEC-1). Un solo bundle SQLitePCLRaw nel
         grafo; .Sqlite.Core da lo stesso provider EF senza portarsi dietro il bundle. Il formato dei
         file resta SQLCipher 4: lo dichiara Security/CipherPragmas a ogni chiave (D9). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite.Core" />
    <PackageReference Include="SQLite3MC.PCLRaw.bundle" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

  <!-- Nativo di SkiaSharp per RID: v. Recordum.Plugins.ExportEngine.csproj. Su Windows lo porta SkiaSharp. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Richiesto dal generatore di [LibraryImport] (LibsecretSecretStore): il codice utente non ha blocchi unsafe. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Recordum.Data.Tests" />
  </ItemGroup>

</Project>
