<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Recordum.UI.App"
             RequestedThemeVariant="Default">
  <!-- Themes/Tokens.axaml (branch avalonia-linux-slice, sonda styling): merge a livello Application
       così ogni view risolve le chiavi Brush.*/Font.*/Layout.*
       con DynamicResource, e la variante Light/Dark segue Window.RequestedThemeVariant senza bisogno
       di un ThemeService che scambia dizionari come in WPF. La finestra vera (MainWindow) la crea
       App.StartAsync dopo lo sblocco del database. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Themes/Tokens.axaml"/>
        <ResourceInclude Source="/Themes/Icons.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <!-- Ogni finestra prende il font dell'app, anche una Window qualunque (quelle dei test: UX-P2). MainWindow e
         RecordumWindow lo impostano già da sé; questo copre il resto. -->
    <Style Selector=":is(Window)">
      <Setter Property="FontFamily" Value="{DynamicResource Font.Default}"/>
    </Style>
    <!-- FluentTheme.Palettes ritinge l'accento DI SISTEMA (SystemAccentColor e le sue 6 sfumature
         Light1-3/Dark1-3, che CheckBox/ComboBoxItem/ListBoxItem/ScrollBar/Slider Fluent usano per gli
         stati checked/selected/hover) sul Brush.Accent di Recordum invece del blu di Windows
         (#0078D7 di default) — verificato: senza questo, TryGetResource("SystemAccentColor") resta
         Windows-blue anche con Tokens.axaml mergiato, perché i due sistemi di risorse sono separati.
         Stessi hex di Brush.Accent/Brush.Ink in Tokens.axaml (Light #1F1F1D / Dark #E6E5E1, l'inchiostro) duplicati qui: una
         ColorPaletteResources è un oggetto .NET valorizzato all'avvio, non può leggere una
         DynamicResource. -->
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#FF1F1F1D"/>
        <ColorPaletteResources x:Key="Dark" Accent="#FFE6E5E1"/>
      </FluentTheme.Palettes>
    </FluentTheme>
    <!-- Il template di AvaloniaEdit (DiaryEditor). Senza, il TextEditor non ha un template: area di testo 0x0, niente
         a schermo. Prima lo caricava di nascosto Markdown.Avalonia al primo uso, ed era il "priming" dei test headless. -->
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml"/>
    <StyleInclude Source="/Themes/ControlStyles.axaml"/>
    <StyleInclude Source="/Themes/RecordumStyles.axaml"/>
    <!-- Stili delle righe della Home: inclusi qui una volta, non in ogni riga. Inclusi per riga
         costavano un terzo del tempo della Home con 300 righe (F1-PERF1). -->
    <StyleInclude Source="/Views/Rows/RowCardStyles.axaml"/>
  </Application.Styles>
</Application>
