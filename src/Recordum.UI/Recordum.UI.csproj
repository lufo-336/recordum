<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.*" />
    <!-- Sonda editor (branch avalonia-linux-slice): vedi docs/design/2026-09-09-avalonia-editor-probe.md.
         Avalonia.AvaloniaEdit (id NuGet corretto: NON "AvaloniaEdit", che si è fermato a 0.10.12 su
         Avalonia 0.10 pre-1.0) dichiara Avalonia >=12.0.0, quindi 12.1.2 lo soddisfa direttamente e
         funziona (compila E gira, verificato negli screenshot).
         Markdown.Avalonia 11.0.3 COMPILA pulito contro 12.1.2 ma esplode a runtime
         (MissingMethodException su DynamicResourceExtension.ProvideValue dentro il suo stile
         FluentTheme precompilato — un vero breaking change binario Avalonia 11->12, non solo un
         vincolo di nuspec) — vedi il report per lo stack trace. 12.0.0-a3, la riga prerelease dello
         stesso progetto ricompilata esplicitamente per Avalonia 12.0.0 + net10.0, è quella usata qui. -->
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="Markdown.Avalonia" Version="12.0.0-a3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Il font viaggia dentro l'assembly: una faccia sola, identica su Linux, Windows e macOS.
         Un ripiego per-OS (Palatino qui, Noto Serif là) darebbe a Recordum un aspetto diverso su
         ogni macchina, che è il contrario di ciò che l'Onda 3 chiede. Source Serif 4 (SIL OFL 1.1,
         release Adobe 4.005R): TTF statici Regular/Italic/Bold/BoldItalic, tutti famiglia
         "Source Serif 4". Il testo della licenza (Fonts/OFL.txt) viene imbustato con i font, così
         viaggia insieme al binario. -->
    <AvaloniaResource Include="Fonts/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Recordum.Core/Recordum.Core.csproj" />
    <ProjectReference Include="../Recordum.Data/Recordum.Data.csproj" />
    <ProjectReference Include="../Recordum.Plugins.Contracts/Recordum.Plugins.Contracts.csproj" />
    <ProjectReference Include="../Recordum.Presentation/Recordum.Presentation.csproj" />
  </ItemGroup>
</Project>
