<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <!-- Inter, il font dell'interfaccia (direzione visiva §4.1). Il serif del diario resta imbustato in Fonts/. -->
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <!-- L'editor del diario (Controls/DiaryEditor). Id NuGet Avalonia.AvaloniaEdit, NON "AvaloniaEdit" (fermo a
         0.10.12, Avalonia pre-1.0). -->
    <PackageReference Include="Avalonia.AvaloniaEdit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Il font viaggia dentro l'assembly: una faccia sola, identica su Linux, Windows e macOS.
         Un ripiego per-OS (Palatino qui, Noto Serif là) darebbe a Recordum un aspetto diverso su
         ogni macchina, che è il contrario di ciò che l'Onda 3 chiede. Source Serif 4 (SIL OFL 1.1,
         release Adobe 4.005R): TTF statici Regular/Italic/Bold/BoldItalic, tutti famiglia
         "Source Serif 4". Il testo della licenza (Fonts/OFL.txt) viene imbustato con i font, così
         viaggia insieme al binario. -->
    <AvaloniaResource Include="Fonts/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Costruttori/hook test-friendly a visibilità internal (AvaloniaConfirmationDialog,
         gemello dell'InternalsVisibleTo che Recordum.WPF già usa per ThemeService). -->
    <InternalsVisibleTo Include="Recordum.UI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Recordum.Core/Recordum.Core.csproj" />
    <ProjectReference Include="../Recordum.Data/Recordum.Data.csproj" />
    <ProjectReference Include="../Recordum.Plugins.Contracts/Recordum.Plugins.Contracts.csproj" />
    <ProjectReference Include="../Recordum.Presentation/Recordum.Presentation.csproj" />
  </ItemGroup>
</Project>
