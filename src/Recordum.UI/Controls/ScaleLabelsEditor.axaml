<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Recordum.Presentation.Resources"
             xmlns:vm="using:Recordum.Presentation.ViewModels.HabitEditor"
             x:Class="Recordum.UI.Controls.ScaleLabelsEditor"
             x:DataType="vm:ScaleLabelsEditorViewModel">
  <!-- Le etichette di una scala come elenco di campi: il valore a sinistra, il testo a destra. Scala esistente = una riga
       per valore, niente aggiungi/togli; scala nuova = "aggiungi etichetta" e × per togliere (CanRemove: minimo due). -->
  <StackPanel Spacing="6">
    <ItemsControl x:Name="RowsList" ItemsSource="{CompiledBinding Rows}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:ScaleLabelRowViewModel">
          <Grid ColumnDefinitions="28,*,Auto" Margin="0,0,0,6">
            <TextBlock Text="{CompiledBinding Value}" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center"/>
            <TextBox x:Name="LabelBox" Grid.Column="1" Text="{CompiledBinding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <Button x:Name="RemoveButton" Grid.Column="2" Classes="ghost" Margin="4,0,0,0" Padding="6" MinHeight="0" VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Static res:Strings.Editor_ScaleLabels_Remove}"
                    ToolTip.Tip="{x:Static res:Strings.Editor_ScaleLabels_Remove}"
                    IsVisible="{CompiledBinding !Owner.FixedCount}" IsEnabled="{CompiledBinding Owner.CanRemove}"
                    Command="{CompiledBinding Owner.RemoveRowCommand}" CommandParameter="{CompiledBinding}">
              <Path Data="{StaticResource Icon.X}" Width="12" Height="12" Stretch="Uniform" Stroke="{DynamicResource Brush.TextMuted}"
                    StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"/>
            </Button>
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Button x:Name="AddButton" Classes="ghost" HorizontalAlignment="Left" Padding="6,4"
            IsVisible="{CompiledBinding !FixedCount}" Command="{CompiledBinding AddRowCommand}">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Path Data="{StaticResource Icon.Plus}" Width="12" Height="12" Stretch="Uniform" Stroke="{DynamicResource Brush.Text}"
              StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center"/>
        <TextBlock Text="{x:Static res:Strings.Editor_ScaleLabels_Add}"/>
      </StackPanel>
    </Button>
  </StackPanel>
</UserControl>
