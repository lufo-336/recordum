<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ae="using:AvaloniaEdit"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="360"
             x:Class="Recordum.UI.Controls.LivePreviewEditorControl">

  <!--
  Sonda Live Preview (branch avalonia-linux-slice, NON una feature): UNA sola superficie di
  editing — non sorgente+anteprima come in MarkdownEditorControl.axaml (sonda editor
  precedente). Il testo si formatta mentre si digita via MarkdownLivePreviewColorizer +
  MarkdownLivePreviewMarkerGenerator (code-behind), tranne sulla riga del caret, che resta
  grezza per poterla editare. Vedi docs/design/2026-09-10-avalonia-live-preview-probe.md.

  Sorella deliberata di MarkdownEditorControl, non un'estensione: la Live Preview collassa le
  due metà del modello precedente in una, quindi portarsi dietro il pannello Markdown.Avalonia
  di sola lettura sarebbe un secondo rendering ridondante dello stesso documento.
  -->

  <Border Background="{DynamicResource Brush.Surface}">
    <ae:TextEditor x:Name="Editor"
                   ShowLineNumbers="False"
                   WordWrap="True"
                   Padding="10,8"
                   FontFamily="{DynamicResource Font.Default}"
                   FontSize="{DynamicResource FontSize.Body}"
                   Background="{DynamicResource Brush.Surface}"
                   Foreground="{DynamicResource Brush.Text}"/>
  </Border>

</UserControl>
