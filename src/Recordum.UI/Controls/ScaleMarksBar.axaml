<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:Recordum.UI.Controls"
             xmlns:qa="using:Recordum.Presentation.ViewModels.HabitScreen.QuickAdd"
             x:Name="Root"
             x:Class="Recordum.UI.Controls.ScaleMarksBar"
             x:DataType="ctl:ScaleMarksBar">
  <!-- Le tacche di una scala (una per valore se sono al piu' 12) e, sotto, i nomi degli scaglioni. Lo usano l'anteprima
       dell'editor, il cursore di registrazione e la cella di scala. Un figlio senza punti non disegna niente. -->
  <UserControl.Styles>
    <Style Selector="Rectangle.tick"><Setter Property="Width" Value="1"/><Setter Property="Fill" Value="{DynamicResource Brush.TextMuted}"/></Style>
    <Style Selector="Rectangle.tick.named"><Setter Property="Width" Value="2"/><Setter Property="Fill" Value="{DynamicResource Brush.Accent}"/></Style>
  </UserControl.Styles>
  <StackPanel>
    <ItemsControl x:Name="Ticks" ItemsSource="{CompiledBinding #Root.Points}" Height="8">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><ctl:ScalePointsPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="qa:ScalePoint">
          <Rectangle Classes="tick" Classes.named="{CompiledBinding IsNamed}" Height="8" RadiusX="1" RadiusY="1"/>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <ItemsControl x:Name="Names" ItemsSource="{CompiledBinding #Root.Points}" Margin="0,2,0,0"
                  IsVisible="{CompiledBinding #Root.ShowNames}">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><ctl:ScalePointsPanel HideOverlaps="True"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="qa:ScalePoint">
          <TextBlock Text="{CompiledBinding Label}" IsVisible="{CompiledBinding IsNamed}" MaxWidth="96" TextTrimming="CharacterEllipsis"
                     FontSize="{StaticResource FontSize.Small}" Foreground="{DynamicResource Brush.TextMuted}"/>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
