<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    Stili globali (F1 Task 2). A differenza di BaseStyles.xaml in WPF (1046 righe, quasi tutte
    "undo Aero" — v. la sonda docs/design/2026-09-09-avalonia-theme-probe.md), qui la maggior parte
    dei controlli elencati dal piano NON ha bisogno di un ControlTemplate: FluentTheme è già una base
    piatta moderna che coincide col linguaggio di Recordum. La ritinta che serve davvero non è per
    controllo ma GLOBALE — l'accento di sistema (App.axaml, FluentTheme.Palettes) — perché CheckBox
    checked, ComboBoxItem/ListBoxItem selezionati, hover dei MenuItem, thumb dello ScrollBar sono
    TUTTI legati a SystemAccentColor (il blu di Windows #0078D7 di default), non al nostro
    Brush.Accent: senza quella ritinta ogni popup avrebbe un blu diverso da bottoni/CTA. Verificato
    per riflessione (TryGetResource("SystemAccentColor") prima/dopo) e a schermo (gallery screenshot
    nei due temi, vedi Step 5).

    Classificazione per controllo, verificata nello screenshot della galleria (Step 5), stesso
    metodo della sonda-tema:
    - ContextMenu / MenuItem: Classe A. Pannello arrotondato con ombra, hover a tinta accento,
      nessuna colonna-icone riservata quando l'icona è null — già il default Fluent, ora sul nostro
      blu grazie alla ritinta della palette. Nessun ControlTemplate.
    - ToolTip: Classe A. Pannello arrotondato + ombra di serie; ToolTipContentMaxWidth Fluent = 320,
      lo stesso numero che WPF fissava a mano (coincidenza verificata, non uno zero-caso).
    - ComboBox (chrome + popup + ComboBoxItem): Classe A. Stessa famiglia di popup arrotondato-con-
      ombra di ContextMenu; riga selezionata già tinta con l'accento (ora il nostro).
    - CheckBox: Classe A. Il glifo piatto Fluent più la ritinta d'accento riproducono il quadratino
      blu pieno con spunta bianca di WPF senza un ControlTemplate.
    - ScrollViewer / ScrollBar: Classe A. Barra sottile piatta di serie.
    - Button di base (nessuna classe): Classe A. `Button.primary`/`Button.ghost` (RecordumStyles.axaml,
      sonda F0) e `record` (qui sotto, il comando che registra) sono gli unici stili Button — un Button senza classe
      usa il chrome Fluent com'è.
    - ListBoxItem: Classe A per la selezione (tinta d'accento, angoli arrotondati già di serie); un
      solo Setter esplicito sotto per l'angolo, non perché serva a schermo ma per lo stesso principio
      con cui WPF teneva `Recordum.HabitBlock` a `CornerRadius=6`: un numero nostro, non un default
      che potrebbe cambiare a un aggiornamento di Fluent (CLAUDE.md §11, "Esplicito > implicito").
    - Separator (nei ContextMenu): l'UNICA vera eccezione. FluentTheme non espone una chiave di
      risorsa dedicata al suo colore (verificato: nessuna "MenuFlyoutSeparatorBackground" nell'
      assembly, a differenza delle altre famiglie sopra) — il colore che si vede nello screenshot è
      quello che il tema decide di suo. WPF lo forzava esplicitamente a Brush.Border tramite
      `{x:Static MenuItem.SeparatorStyleKey}`; qui si fa lo stesso con un selettore di tipo, per lo
      stesso motivo (un divisore è geometria di layout, non un colore che deve seguire l'umore del
      tema di sistema).
    -->

    <Style Selector="Separator">
        <Setter Property="Background" Value="{DynamicResource Brush.Border}"/>
    </Style>

    <Style Selector="ListBoxItem">
        <Setter Property="CornerRadius" Value="5"/>
    </Style>

    <!-- Gemello di `Recordum.Segment` (BaseStyles.xaml:335): una pillola senza pallino. Globale (F2a): lo usano la
         Home (RadioButton) e i chip della schermata (CheckBox). -->
    <Style Selector="RadioButton.segment">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
      <Setter Property="Padding" Value="11,4"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.segment:pointerover">
      <Setter Property="Background" Value="{DynamicResource Brush.SurfaceElevated}"/>
    </Style>
    <Style Selector="RadioButton.segment:checked">
      <Setter Property="Background" Value="{DynamicResource Brush.SurfaceElevated}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="RadioButton.segment:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
    </Style>

    <Style Selector="CheckBox.segment">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
      <Setter Property="Padding" Value="11,4"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="CheckBox.segment:pointerover">
      <Setter Property="Background" Value="{DynamicResource Brush.SurfaceElevated}"/>
    </Style>
    <Style Selector="CheckBox.segment:checked">
      <Setter Property="Background" Value="{DynamicResource Brush.SurfaceElevated}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="CheckBox.segment:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
    </Style>

    <!-- ToggleButton.pill (W2V-9): il ToggleButton del builder (giorni, Obiettivo, Sessione) acceso nel NOSTRO accento.
         Senza template il Fluent lo tinge con le risorse ToggleButtonBackgroundChecked*, che sullo stato pointerover/
         pressed tornano al blu di sistema: qui lo stato e' deterministico e non dipende da quelle chiavi. -->
    <Style Selector="ToggleButton.pill">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
      <Setter Property="Padding" Value="11,5"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="{DynamicResource Brush.SurfaceElevated}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ToggleButton.pill:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
    </Style>
    <Style Selector="ToggleButton.pill:checked">
      <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}"/>
    </Style>
    <Style Selector="ToggleButton.pill:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
    </Style>

    <!-- Il comando che registra (direzione visiva §4.4, §6.2): bordo e testo nella variante "testo" del colore
         dell'abitudine su una tinta di riga; "fatto" (ToggleButton spuntato) è pieno nel colore. I pennelli Brush.Habit*
         li scrive la schermata dell'abitudine. Fluent ridipinge il ContentPresenter negli stati: lì si ripete. -->
    <Style Selector=":is(Button).record">
      <Setter Property="Background" Value="{DynamicResource Brush.HabitTint}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.HabitText}"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.HabitText}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="14,6"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector=":is(Button).record:pointerover /template/ ContentPresenter#PART_ContentPresenter, :is(Button).record:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.HabitTint}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.HabitText}"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.HabitText}"/>
      <Setter Property="Opacity" Value="0.9"/>
    </Style>
    <Style Selector="ToggleButton.record:checked">
      <Setter Property="Background" Value="{DynamicResource Brush.Habit}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Habit}"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.OnInk}"/>
    </Style>
    <Style Selector="ToggleButton.record:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.Habit}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Habit}"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.OnInk}"/>
    </Style>
    <!-- "Ho ceduto…": lo stesso comando nel colore del pericolo. -->
    <Style Selector="Button.record.danger">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
    </Style>
    <Style Selector="Button.record.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.record.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
    </Style>
    <Style Selector="Path.record-glyph">
      <Setter Property="Width" Value="14"/>
      <Setter Property="Height" Value="14"/>
      <Setter Property="Stretch" Value="Uniform"/>
      <Setter Property="StrokeThickness" Value="1.8"/>
      <Setter Property="StrokeLineCap" Value="Round"/>
      <Setter Property="StrokeJoin" Value="Round"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}"/>
    </Style>

</Styles>
