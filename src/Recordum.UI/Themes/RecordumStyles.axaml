<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    Sonda (branch avalonia-linux-slice): a differenza di BaseStyles.xaml in WPF (1046 righe, 34
    tipi di controllo riscritti da zero), qui c'è SOLO quello che il brief chiede e che FluentTheme
    non dà già di default con i soli token. Ogni Style qui sotto è una decisione di design di
    Recordum (non un'undo di un default dated), e lo dice nel commento.

    Deliberatamente NON qui: ComboBox, CheckBox, Slider, Expander, TabControl — il default
    FluentTheme di questi controlli è già "modern flat neutral" nello spirito del linguaggio
    visivo di Recordum (§9 CLAUDE.md: tono serio, no candy, motion restrained). La galleria li
    esercita con la sola colorazione a token (via override delle chiavi ThemeResource di Fluent,
    non con un ControlTheme nostro) — vedi la galleria in tests/Recordum.UI.Tests/Styles/ControlStylesScreenshotTests.cs.
    -->

    <!-- Pulsante primario: Fluent colora i pulsanti in Background/Foreground neutri di default,
         con l'enfasi (Classes="accent") legata al colore di sistema — non al nostro Brush.Accent.
         Qui puntiamo esplicitamente ai nostri token: 4 Setter, non un ControlTemplate. -->
    <!-- Ogni pulsante: contorno di 1 px e angoli di 6 (direzione visiva §4.4). I colori arrivano dalle chiavi Button* di
         Fluent ridefinite in Tokens.axaml, così caption, rail e le altre classi restano libere di sovrascriverli. -->
    <Style Selector="Button">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
        <Setter Property="Opacity" Value="0.9"/>
    </Style>

    <!-- Pulsante "quiet"/ghost: nessun bordo, nessuno sfondo, testo muto finché non è a fuoco/hover
         — Fluent non ha una variante equivalente pronta all'uso (le sue Classes standard sono
         Accent/Danger, pensate per l'accento di sistema, non per un pulsante "silenzioso"). -->
    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
    </Style>

    <!-- TextBox con la cornice piena (direzione visiva §4.4, UX-15): la sola riga sotto faceva sembrare testo i numeri e
         invisibili i campi vuoti. Il default di Avalonia disegna il bordo da TemplateBinding: bastano i Setter. -->
    <Style Selector="TextBox">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceElevated}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.FieldBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.TextSelection}"/>
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource Brush.Text}"/>
    </Style>
    <!-- Setter diretto su BorderBrush (non su una parte del template): il default TextBox lo
         espone via TemplateBinding, quindi arriva al bordo senza dover conoscere il nome interno
         della parte — stesso principio del commento sopra. -->
    <Style Selector="TextBox:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
    </Style>

    <!-- L'icona Lucide di una voce di menu: 16 px, tratto 1,75, nel testo attenuato (in rosso con la voce pericolosa). -->
    <Style Selector="Path.menuicon">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="StrokeThickness" Value="1.75"/>
        <Setter Property="StrokeLineCap" Value="Round"/>
        <Setter Property="StrokeJoin" Value="Round"/>
        <Setter Property="Stroke" Value="{DynamicResource Brush.TextMuted}"/>
    </Style>
    <Style Selector="MenuItem.danger Path.menuicon">
        <Setter Property="Stroke" Value="{DynamicResource Brush.Danger}"/>
    </Style>

    <!-- Voce di menu pericolosa (Elimina definitivamente, Sposta nel cestino): il testo in rosso, l'icona con lui. -->
    <Style Selector="MenuItem.danger">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
    </Style>

    <!-- Chip dei tag di una voce di diario. "property" = scelto nella riga Tag (pieno); "inline" = scritto con # nel
         testo (solo contorno). Il colore dell'abitudine (Brush.Accent della schermata) li distingue dal resto. -->
    <Style Selector="Border.tag-chip">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="8,1"/>
        <Setter Property="Margin" Value="0,0,4,4"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
    </Style>
    <Style Selector="Border.tag-chip.property">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
    </Style>
    <Style Selector="Border.tag-chip.inline">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- Configura (spec 6.4): il titolo di un blocco (16/600), la riga che spiega una casella (12 attenuata, §6.4.2) e la riga
         di una voce, 40 px a tutta larghezza, senza riempimento: non sembra un pulsante, si apre col clic. -->
    <Style Selector="TextBlock.block">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Heading}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    </Style>
    <Style Selector="TextBlock.help">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style Selector=":is(Button).configrow">
        <Setter Property="Height" Value="40"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector=":is(Button).configrow:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
    </Style>
    <Style Selector="ToggleButton.configrow:checked /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ToggleButton.configrow:checked:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
    </Style>
    <!-- Spenta = una riga attenuata, non un pulsante disabilitato con la cornice (il :disabled di Fluent la ridisegna). -->
    <Style Selector=":is(Button).configrow:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

</Styles>
