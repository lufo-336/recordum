<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    Porting 1:1 di src/Recordum.WPF/Resources/Tokens.xaml + Light.xaml + Dark.xaml — 43 chiavi,
    stesso nome chiave dei tre file WPF, così le due shell si confrontano chiave per chiave.
    NON è un file di produzione: è la sonda probe (branch avalonia-linux-slice) che misura quanto
    del linguaggio visivo di Recordum sopravvive al passaggio da WPF a FluentTheme.

    Differenza di meccanismo rispetto a WPF: là Light.xaml e Dark.xaml sono DUE ResourceDictionary
    separati, scambiati per intero da ThemeService (swap del MergedDictionaries a runtime). Qui le
    due varianti vivono nello STESSO file, sotto ResourceDictionary.ThemeDictionaries con chiave
    "Light"/"Dark": è Avalonia stesso a risolvere quale Brush.* usare in base a
    Window.ActualThemeVariant (o Application.RequestedThemeVariant), non serve un servizio nostro
    che scambia dizionari. Le chiavi non themed (FontSize.*, Font.*, Layout.*) restano al livello
    superiore del ResourceDictionary, fuori da ThemeDictionaries, perché non cambiano con la
    variante.
    -->

    <!-- Font sizes — invarianti, identiche ai valori WPF. -->
    <!-- La scala della direzione visiva (§4.1): 12 note e giorni · 13 etichette e comandi · 14 testo · 16 titoli di
         sezione · 20 titoli di schermata e numeri grandi. -->
    <x:Double x:Key="FontSize.Small">12</x:Double>
    <x:Double x:Key="FontSize.Label">13</x:Double>
    <x:Double x:Key="FontSize.Body">14</x:Double>
    <x:Double x:Key="FontSize.Heading">16</x:Double>
    <x:Double x:Key="FontSize.Title">20</x:Double>

    <!-- In WPF Font.Default era Palatino, scelto a runtime da AppFontService (ui.font). Su Avalonia i font viaggiano
         con l'app, identici su ogni OS, e non si scelgono (direzione visiva §12.5). -->
    <FontFamily x:Key="Font.System">Segoe UI, Ubuntu, Cantarell, Noto Sans, DejaVu Sans, sans-serif</FontFamily>
    <FontFamily x:Key="Font.Serif">avares://Recordum.UI/Fonts/#Source Serif 4,Georgia,Noto Serif,Liberation Serif,serif</FontFamily>
    <!-- L'interfaccia è in Inter (pacchetto Avalonia.Fonts.Inter, OFL); il serif di spedizione (Source Serif 4, OFL,
         imbustato in Fonts/) è solo per il testo dell'utente e il marchio: Font.Serif. -->
    <FontFamily x:Key="Font.Default">avares://Avalonia.Fonts.Inter/Assets#Inter,Noto Sans,sans-serif</FontFamily>

    <!-- I gradini della mappa e della heatmap (§4.3): il colore dell'abitudine a queste opacità sul pannello. -->
    <x:Double x:Key="Opacity.Heat1">0.25</x:Double>
    <x:Double x:Key="Opacity.Heat2">0.5</x:Double>
    <x:Double x:Key="Opacity.Heat3">0.75</x:Double>
    <x:Double x:Key="Opacity.Heat4">1</x:Double>

    <!-- Layout — stessi numeri di WPF Tokens.xaml (px WPF ~= DIP Avalonia, 1:1 a questa densità). -->
    <x:Double x:Key="Layout.RowHeight">36</x:Double>
    <x:Double x:Key="Layout.AccentBarWidth">4</x:Double>
    <x:Double x:Key="Layout.IndentPerLevel">24</x:Double>
    <x:Double x:Key="Layout.HeatmapCell">10</x:Double>
    <x:Double x:Key="Layout.HeatmapGap">2</x:Double>

    <!-- Brush.* — risolte per variante da Avalonia stesso. Non sono più gli hex di WPF: la direzione visiva le ha cambiate. -->
    <ResourceDictionary.ThemeDictionaries>

      <ResourceDictionary x:Key="Light">
        <!-- Il colore dell'abitudine (§4.3): la tinta è un livello col colore pieno e questa opacità sul pannello. -->
        <x:Double x:Key="Opacity.RowTint">0.09</x:Double>
        <x:Double x:Key="Opacity.RowTintSelected">0.16</x:Double>
        <x:Double x:Key="Opacity.TimerTint">0.08</x:Double>
        <!-- Neutri caldi della direzione visiva (§4.2). Ruoli: Background = fondo della finestra; Pane = pannello
             (colonne, schede, finestrelle); Surface = barra a sinistra e zone secondarie; SurfaceElevated = popup e
             campi; Border = la riga leggera; FieldBorder = la cornice dei campi; Selection = segmento o chip scelto.
             Accent = l'inchiostro: il colore dell'azione principale (l'unico colore sullo schermo resta l'abitudine). -->
        <SolidColorBrush x:Key="Brush.Background"      Color="#FFFBFBFA"/>
        <SolidColorBrush x:Key="Brush.Pane"            Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="Brush.Surface"         Color="#FFF4F3F1"/>
        <SolidColorBrush x:Key="Brush.SurfaceElevated" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="Brush.Border"          Color="#FFECEBE8"/>
        <!-- La cella vuota della striscia "Segni": si deve leggere anche sulla tinta della riga (GIO-7). -->
        <SolidColorBrush x:Key="Brush.CellEmpty"       Color="#FFE9E8E4"/>
        <SolidColorBrush x:Key="Brush.FieldBorder"     Color="#FFD6D5D0"/>
        <SolidColorBrush x:Key="Brush.Selection"       Color="#FFECEBE8"/>
        <SolidColorBrush x:Key="Brush.Text"            Color="#FF1F1F1D"/>
        <SolidColorBrush x:Key="Brush.TextMuted"       Color="#FF6B6A65"/>
        <SolidColorBrush x:Key="Brush.TextFaint"       Color="#FFA3A29C"/>
        <SolidColorBrush x:Key="Brush.Ink"             Color="#FF1F1F1D"/>
        <SolidColorBrush x:Key="Brush.OnInk"           Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="Brush.Accent"          Color="#FF1F1F1D"/>
        <SolidColorBrush x:Key="Brush.OnAccent"        Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="Brush.Cell"            Color="#FFF4F3F1"/>
        <SolidColorBrush x:Key="Brush.Success"         Color="#FF3F7A26"/>
        <SolidColorBrush x:Key="Brush.Danger"          Color="#FFB42318"/>
        <SolidColorBrush x:Key="Brush.Warning"         Color="#FFB45309"/>
        <SolidColorBrush x:Key="Brush.WarningSurface"  Color="#FFFDF6EC"/>
            <SolidColorBrush x:Key="Brush.CaptionCloseHover" Color="#FFC42B1C"/>
          <!-- I pulsanti di Fluent ridipinti coi token (§4.4): di base a contorno sul pannello, niente grigio pieno che
             sembra disabilitato. Le classi nostre (primary, ghost, caption, rail…) sovrascrivono sopra. -->
        <StaticResource x:Key="ButtonBackground" ResourceKey="Brush.Pane"/>
        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="Brush.Surface"/>
        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="Brush.Selection"/>
        <StaticResource x:Key="ButtonForeground" ResourceKey="Brush.Text"/>
        <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="Brush.Text"/>
        <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="Brush.Text"/>
        <StaticResource x:Key="ButtonBorderBrush" ResourceKey="Brush.FieldBorder"/>
        <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="Brush.FieldBorder"/>
        <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="Brush.FieldBorder"/>
        <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="Brush.Pane"/>
        <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="Brush.TextFaint"/>
        <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="Brush.Border"/>
        <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="Brush.TextFaint"/>
        <StaticResource x:Key="TextControlPlaceholderForegroundPointerOver" ResourceKey="Brush.TextFaint"/>
        <StaticResource x:Key="TextControlPlaceholderForegroundFocused" ResourceKey="Brush.TextFaint"/>
        <!-- I campi di Fluent coi token: in scuro il fondo a fuoco era nero (visto nel PNG dello sblocco). -->
        <StaticResource x:Key="TextControlBackground" ResourceKey="Brush.SurfaceElevated"/>
        <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="Brush.SurfaceElevated"/>
        <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="Brush.SurfaceElevated"/>
        <StaticResource x:Key="TextControlBorderBrush" ResourceKey="Brush.FieldBorder"/>
        <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="Brush.FieldBorder"/>
        <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="Brush.Ink"/>
        <!-- Il colore dell'abitudine per il comando che registra (Button.record): la schermata dell'abitudine li
             riscrive nelle sue risorse (HabitScreenView.ApplyAccent); fuori di lì valgono questi. -->
        <StaticResource x:Key="Brush.Habit" ResourceKey="Brush.Ink"/>
        <StaticResource x:Key="Brush.HabitText" ResourceKey="Brush.Text"/>
        <StaticResource x:Key="Brush.HabitTint" ResourceKey="Brush.Selection"/>
        <!-- La selezione del testo: un tono neutro col testo normale sopra (non l'inchiostro: review I-1). -->
        <SolidColorBrush x:Key="Brush.TextSelection" Color="#FFD8D5CC"/>
        <!-- Gli stati che Fluent ricava dall'accento, riportati sui token (review I-2, I-3): la spunta sopra l'inchiostro,
             le voci selezionate di elenchi e menu a tendina sulla selezione neutra col testo normale. -->
        <StaticResource x:Key="CheckBoxCheckGlyphForegroundChecked" ResourceKey="Brush.OnInk"/>
        <StaticResource x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" ResourceKey="Brush.OnInk"/>
        <StaticResource x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" ResourceKey="Brush.OnInk"/>
        <StaticResource x:Key="CheckBoxCheckGlyphForegroundIndeterminate" ResourceKey="Brush.OnInk"/>
        <StaticResource x:Key="ComboBoxItemBackgroundSelected" ResourceKey="Brush.Selection"/>
        <StaticResource x:Key="ComboBoxItemBackgroundSelectedPointerOver" ResourceKey="Brush.Selection"/>
        <StaticResource x:Key="ComboBoxItemBackgroundSelectedPressed" ResourceKey="Brush.Selection"/>
        <StaticResource x:Key="ComboBoxItemForegroundSelected" ResourceKey="Brush.Text"/>
        <StaticResource x:Key="ComboBoxItemForegroundSelectedPointerOver" ResourceKey="Brush.Text"/>
        <StaticResource x:Key="ComboBoxItemForegroundSelectedPressed" ResourceKey="Brush.Text"/>
        <StaticResource x:Key="SystemControlHighlightListAccentLowBrush" ResourceKey="Brush.Selection"/>
        <StaticResource x:Key="SystemControlHighlightListAccentMediumBrush" ResourceKey="Brush.Selection"/>
        <StaticResource x:Key="SystemControlHighlightListAccentHighBrush" ResourceKey="Brush.Selection"/>
        <StaticResource x:Key="SystemControlHighlightAltBaseHighBrush" ResourceKey="Brush.Text"/>
      </ResourceDictionary>

      <ResourceDictionary x:Key="Dark">
        <!-- Il colore dell'abitudine (§4.3): la tinta è un livello col colore pieno e questa opacità sul pannello. -->
        <x:Double x:Key="Opacity.RowTint">0.16</x:Double>
        <x:Double x:Key="Opacity.RowTintSelected">0.26</x:Double>
        <x:Double x:Key="Opacity.TimerTint">0.14</x:Double>
        <SolidColorBrush x:Key="Brush.Background"      Color="#FF1B1B1A"/>
        <SolidColorBrush x:Key="Brush.Pane"            Color="#FF222221"/>
        <SolidColorBrush x:Key="Brush.Surface"         Color="#FF181817"/>
        <SolidColorBrush x:Key="Brush.SurfaceElevated" Color="#FF2A2A28"/>
        <SolidColorBrush x:Key="Brush.Border"          Color="#FF2E2E2C"/>
        <SolidColorBrush x:Key="Brush.CellEmpty"       Color="#FF3F3F3B"/>
        <SolidColorBrush x:Key="Brush.FieldBorder"     Color="#FF3A3A37"/>
        <SolidColorBrush x:Key="Brush.Selection"       Color="#FF2E2E2C"/>
        <SolidColorBrush x:Key="Brush.Text"            Color="#FFE6E5E1"/>
        <SolidColorBrush x:Key="Brush.TextMuted"       Color="#FFA3A29C"/>
        <SolidColorBrush x:Key="Brush.TextFaint"       Color="#FF6B6A65"/>
        <SolidColorBrush x:Key="Brush.Ink"             Color="#FFE6E5E1"/>
        <SolidColorBrush x:Key="Brush.OnInk"           Color="#FF1B1B1A"/>
        <SolidColorBrush x:Key="Brush.Accent"          Color="#FFE6E5E1"/>
        <SolidColorBrush x:Key="Brush.OnAccent"        Color="#FF1B1B1A"/>
        <SolidColorBrush x:Key="Brush.Cell"            Color="#FF2A2A28"/>
        <SolidColorBrush x:Key="Brush.Success"         Color="#FF7BC25A"/>
        <SolidColorBrush x:Key="Brush.Danger"          Color="#FFF97066"/>
        <SolidColorBrush x:Key="Brush.Warning"         Color="#FFF5B454"/>
        <SolidColorBrush x:Key="Brush.WarningSurface"  Color="#FF2E2418"/>
            <SolidColorBrush x:Key="Brush.CaptionCloseHover" Color="#FFC42B1C"/>
          <!-- I pulsanti di Fluent ridipinti coi token (§4.4): di base a contorno sul pannello, niente grigio pieno che
             sembra disabilitato. Le classi nostre (primary, ghost, caption, rail…) sovrascrivono sopra. -->
        <StaticResource x:Key="ButtonBackground" ResourceKey="Brush.Pane"/>
        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="Brush.Surface"/>
        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="Brush.Selection"/>
        <StaticResource x:Key="ButtonForeground" ResourceKey="Brush.Text"/>
        <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="Brush.Text"/>
        <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="Brush.Text"/>
        <StaticResource x:Key="ButtonBorderBrush" ResourceKey="Brush.FieldBorder"/>
        <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="Brush.FieldBorder"/>
        <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="Brush.FieldBorder"/>
        <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="Brush.Pane"/>
        <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="Brush.TextFaint"/>
        <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="Brush.Border"/>
        <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="Brush.TextFaint"/>
        <StaticResource x:Key="TextControlPlaceholderForegroundPointerOver" ResourceKey="Brush.TextFaint"/>
        <StaticResource x:Key="TextControlPlaceholderForegroundFocused" ResourceKey="Brush.TextFaint"/>
        <!-- I campi di Fluent coi token: in scuro il fondo a fuoco era nero (visto nel PNG dello sblocco). -->
        <StaticResource x:Key="TextControlBackground" ResourceKey="Brush.SurfaceElevated"/>
        <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="Brush.SurfaceElevated"/>
        <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="Brush.SurfaceElevated"/>
        <StaticResource x:Key="TextControlBorderBrush" ResourceKey="Brush.FieldBorder"/>
        <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="Brush.FieldBorder"/>
        <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="Brush.Ink"/>
        <!-- Il colore dell'abitudine per il comando che registra (Button.record): la schermata dell'abitudine li
             riscrive nelle sue risorse (HabitScreenView.ApplyAccent); fuori di lì valgono questi. -->
        <StaticResource x:Key="Brush.Habit" ResourceKey="Brush.Ink"/>
        <StaticResource x:Key="Brush.HabitText" ResourceKey="Brush.Text"/>
        <StaticResource x:Key="Brush.HabitTint" ResourceKey="Brush.Selection"/>
        <!-- La selezione del testo: un tono neutro col testo normale sopra (non l'inchiostro: review I-1). -->
        <SolidColorBrush x:Key="Brush.TextSelection" Color="#FF57554F"/>
        <!-- Gli stati che Fluent ricava dall'accento, riportati sui token (review I-2, I-3): la spunta sopra l'inchiostro,
             le voci selezionate di elenchi e menu a tendina sulla selezione neutra col testo normale. -->
        <StaticResource x:Key="CheckBoxCheckGlyphForegroundChecked" ResourceKey="Brush.OnInk"/>
        <StaticResource x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" ResourceKey="Brush.OnInk"/>
        <StaticResource x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" ResourceKey="Brush.OnInk"/>
        <StaticResource x:Key="CheckBoxCheckGlyphForegroundIndeterminate" ResourceKey="Brush.OnInk"/>
        <StaticResource x:Key="ComboBoxItemBackgroundSelected" ResourceKey="Brush.Selection"/>
        <StaticResource x:Key="ComboBoxItemBackgroundSelectedPointerOver" ResourceKey="Brush.Selection"/>
        <StaticResource x:Key="ComboBoxItemBackgroundSelectedPressed" ResourceKey="Brush.Selection"/>
        <StaticResource x:Key="ComboBoxItemForegroundSelected" ResourceKey="Brush.Text"/>
        <StaticResource x:Key="ComboBoxItemForegroundSelectedPointerOver" ResourceKey="Brush.Text"/>
        <StaticResource x:Key="ComboBoxItemForegroundSelectedPressed" ResourceKey="Brush.Text"/>
        <StaticResource x:Key="SystemControlHighlightListAccentLowBrush" ResourceKey="Brush.Selection"/>
        <StaticResource x:Key="SystemControlHighlightListAccentMediumBrush" ResourceKey="Brush.Selection"/>
        <StaticResource x:Key="SystemControlHighlightListAccentHighBrush" ResourceKey="Brush.Selection"/>
        <StaticResource x:Key="SystemControlHighlightAltBaseHighBrush" ResourceKey="Brush.Text"/>
      </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
