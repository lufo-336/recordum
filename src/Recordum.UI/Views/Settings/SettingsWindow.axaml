<v:RecordumWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:Recordum.UI.Views"
        xmlns:s="using:Recordum.UI.Views.Settings"
        xmlns:vm="using:Recordum.Presentation.ViewModels.Backup"
        xmlns:res="using:Recordum.Presentation.Resources"
        x:Class="Recordum.UI.Views.Settings.SettingsWindow"
        x:DataType="vm:DataAndBackupPageViewModel"
        Title="{x:Static res:Strings.Settings_Title}"
        Width="640" Height="680" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner">
  <!-- Due pagine scelte da un segmento in testa: il minimo prima delle categorie a sinistra di 3b. La finestra ha per
       DataContext la pagina Dati e backup; Aspetto riceve il suo ViewModel da Appearance (senza, il segmento non c'e'). -->
  <DockPanel>
    <StackPanel x:Name="PageTabs" DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="24,16,24,0" IsVisible="False">
      <RadioButton x:Name="AppearanceTab" Classes="segment" GroupName="settingspage"
                   Content="{x:Static res:Strings.Settings_Category_Appearance}"/>
      <RadioButton x:Name="DataTab" Classes="segment" GroupName="settingspage" IsChecked="True"
                   Content="{x:Static res:Strings.Settings_DataAndBackup}"/>
    </StackPanel>
    <Panel>
      <!-- DataContext nullo finche' non arriva il suo: non eredita quello della finestra, che e' di un altro tipo. -->
      <s:AppearancePage x:Name="AppearancePage" DataContext="{x:Null}" IsVisible="{Binding #AppearanceTab.IsChecked}"/>
      <s:DataAndBackupPage Name="Page" IsVisible="{Binding #DataTab.IsChecked}"/>
    </Panel>
  </DockPanel>
</v:RecordumWindow>
