<v:RecordumWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:Recordum.UI.Views"
        xmlns:s="using:Recordum.UI.Views.Settings"
        xmlns:vm="using:Recordum.Presentation.ViewModels.Backup"
        xmlns:res="using:Recordum.Presentation.Resources"
        x:Class="Recordum.UI.Views.Settings.SettingsWindow"
        x:DataType="vm:DataAndBackupPageViewModel"
        Title="{x:Static res:Strings.Settings_Title}"
        Width="640" Height="680" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner">
  <!-- F2c: la finestra ridotta ha una sola pagina. Le altre categorie arrivano con F6, quando WPF si spegne. -->
  <s:DataAndBackupPage Name="Page"/>
</v:RecordumWindow>
