<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Recordum.Presentation.ViewModels.HabitScreen"
             xmlns:res="using:Recordum.Presentation.Resources"
             xmlns:conv="using:Recordum.UI.Converters"
             xmlns:local="using:Recordum.UI.Views.HabitScreen"
             xmlns:today="using:Recordum.UI.Views.HabitScreen.Today"
             xmlns:journal="using:Recordum.UI.Views.HabitScreen.Journal"
             xmlns:calendar="using:Recordum.UI.Views.HabitScreen.Calendar"
             x:Class="Recordum.UI.Views.HabitScreen.HabitScreenView"
             x:DataType="vm:HabitScreenViewModel"
             Background="{DynamicResource Brush.Surface}">

  <!-- L'accento della schermata e' il colore dell'abitudine: Brush.Accent e le chiavi Fluent
       che il tema legge (FluentAccentKeys) le imposta il code-behind nelle risorse di questa view
       (le risorse non hanno DataContext). -->
  <UserControl.Styles>
    <!-- Pulsanti d'intestazione di colonna: solo icona (Lucide), tinta spenta. -->
    <Style Selector="Button.column-icon">
      <Setter Property="Width" Value="24"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Path.column-icon">
      <Setter Property="Width" Value="13"/>
      <Setter Property="Height" Value="13"/>
      <Setter Property="Stretch" Value="Uniform"/>
      <Setter Property="StrokeThickness" Value="1.5"/>
      <Setter Property="StrokeLineCap" Value="Round"/>
      <Setter Property="StrokeJoin" Value="Round"/>
      <Setter Property="Stroke" Value="{DynamicResource Brush.TextMuted}"/>
    </Style>
    <!-- Maniglia sul bordo destro: invisibile a riposo, tinta d'accento al passaggio e al trascinamento. -->
    <Style Selector="Thumb.column-resize">
      <Setter Property="Width" Value="6"/>
      <Setter Property="Cursor" Value="SizeWestEast"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="bd" Background="Transparent"/>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Thumb.column-resize:pointerover /template/ Border#bd">
      <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
      <Setter Property="Opacity" Value="0.4"/>
    </Style>
    <Style Selector="Thumb.column-resize:pressed /template/ Border#bd">
      <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
      <Setter Property="Opacity" Value="1"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
    <Border Grid.Row="0" Height="3"
            Background="{CompiledBinding Node.Color, Converter={x:Static conv:HexToBrushConverter.Instance}}"/>

    <Border Grid.Row="1" Padding="12" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border}">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Path x:Name="IconPath" Width="22" Height="22" Margin="0,0,8,0" Stretch="Uniform"
                VerticalAlignment="Center" StrokeThickness="1.6"
                StrokeLineCap="Round" StrokeJoin="Round"
                Stroke="{CompiledBinding Node.Color, Converter={x:Static conv:HexToBrushConverter.Instance}}"
                Data="{CompiledBinding Node.Icon, Converter={x:Static conv:IconKeyToGeometryConverter.Instance}}"
                IsVisible="{Binding #IconPath.Data, Converter={x:Static ObjectConverters.IsNotNull}}"/>
          <TextBlock x:Name="HabitName" Text="{CompiledBinding Name}"
                     FontSize="{DynamicResource FontSize.Heading}" FontWeight="SemiBold"
                     VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text}"/>
        </StackPanel>
        <!-- Export arriva con F6 (come in F1-RAIL1: statico, l'onda e' nel commento). -->
        <Button Grid.Column="1" x:Name="ExportButton" IsVisible="False" Padding="10,4"
                Content="{x:Static res:Strings.Export_Button}"/>
      </Grid>
    </Border>

    <!-- Fascia "Oggi" (Task 2). Un gruppo non ne ha; il diario ha il suo pulsante (F2d-1). -->
    <Border Grid.Row="2" x:Name="TodayHost" IsVisible="{CompiledBinding ShowTodayStrip}">
      <today:TodayStripView DataContext="{CompiledBinding TodayStrip}"/>
    </Border>

    <!-- Chip delle colonne. Panoramica (F3), Dettaglio (F3) e Note (F3) non sono ancora
         portate: statici e nascosti (decisione 2); Configura e' di F2b (decisione 3). Un gruppo in F2a mostra
         intestazione e chip senza colonne: la Panoramica e' di F3. -->
    <StackPanel Grid.Row="3" x:Name="ChipBar" Orientation="Horizontal" Margin="12,8,12,4"
                IsVisible="{CompiledBinding ShowChipBar}">
      <!-- Il chip Diario c'e' per i diari (F2d-2, spec 5.2); per gli altri tipi la colonna non esiste. -->
      <CheckBox Classes="segment" x:Name="ChipDiario" Margin="0,0,4,0"
                Content="{x:Static res:Strings.HabitScreen_Column_Diario}"
                IsChecked="{CompiledBinding IsDiarioOpen, Mode=TwoWay}"
                IsVisible="{CompiledBinding IsJournal}"/>
      <CheckBox Classes="segment" x:Name="ChipCronologia"
                Content="{x:Static res:Strings.HabitScreen_Column_Cronologia}"
                IsChecked="{CompiledBinding IsCronologiaOpen, Mode=TwoWay}"
                IsVisible="{CompiledBinding !IsGroupNode}"/>
      <CheckBox Classes="segment" Margin="4,0,0,0" IsVisible="False"
                Content="{x:Static res:Strings.HabitScreen_Tab_Detail}"/>
      <CheckBox Classes="segment" Margin="4,0,0,0" IsVisible="False"
                Content="{x:Static res:Strings.HabitScreen_Tab_Notes}"/>
      <CheckBox Classes="segment" x:Name="ChipConfigura" Margin="4,0,0,0"
                Content="{x:Static res:Strings.HabitScreen_Configure}"
                IsChecked="{CompiledBinding IsConfiguraOpen, Mode=TwoWay}"/>
    </StackPanel>

    <!-- In modalita' focus la barra dei chip lascia il posto al ritorno (spec 3.6). -->
    <Button Grid.Row="3" x:Name="ExitFocusButton" HorizontalAlignment="Left" Margin="12,8,12,4" Padding="8,3"
            Content="{x:Static res:Strings.HabitScreen_ExitFocus}"
            Command="{CompiledBinding ExitFocusCommand}"
            IsVisible="{CompiledBinding IsFocusActive}"/>

    <!-- Fill-then-scroll (decisione 3): la griglia prende la larghezza della viewport e le colonne aperte se la
         dividono in proporzione alla loro larghezza salvata; sotto OpenColumnsMinWidth (320 px a colonna) e' lo
         ScrollViewer a scorrere in orizzontale. Larghezze, MinWidth e visibilita' delle maniglie le scrive il
         code-behind (UpdateColumns) dal ViewModel. -->
    <ScrollViewer Grid.Row="4" x:Name="ColumnsScroll" Margin="12,4,12,12"
                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
      <Grid x:Name="ColumnsGrid" ColumnDefinitions="0,0,0"
            Width="{Binding #ColumnsScroll.Viewport.Width}">
        <Border x:Name="DiarioColumn" Grid.Column="0"
                Background="{DynamicResource Brush.Background}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6"
                IsVisible="{CompiledBinding ShowDiario}">
          <DockPanel>
            <Grid DockPanel.Dock="Top" Height="30" ColumnDefinitions="*,Auto,Auto" Background="{DynamicResource Brush.Surface}">
              <TextBlock Margin="12,0" VerticalAlignment="Center" FontSize="{DynamicResource FontSize.Small}" FontWeight="SemiBold"
                         Text="{x:Static res:Strings.HabitScreen_Column_Diario}" Foreground="{DynamicResource Brush.TextMuted}"/>
              <Button Grid.Column="1" x:Name="DiarioFocusButton" Classes="column-icon"
                      Command="{CompiledBinding ToggleFocusCommand}" CommandParameter="{x:Static vm:HabitColumn.Diario}"
                      ToolTip.Tip="{x:Static res:Strings.HabitScreen_Focus}"
                      AutomationProperties.Name="{x:Static res:Strings.HabitScreen_Focus}">
                <Path Data="{StaticResource Icon.Maximize2}" Classes="column-icon"/>
              </Button>
              <Button Grid.Column="2" x:Name="DiarioCloseButton" Classes="column-icon"
                      Command="{CompiledBinding ToggleColumnCommand}" CommandParameter="{x:Static vm:HabitColumn.Diario}"
                      ToolTip.Tip="{x:Static res:Strings.HabitScreen_Close}"
                      AutomationProperties.Name="{x:Static res:Strings.HabitScreen_Close}">
                <Path Data="{StaticResource Icon.X}" Classes="column-icon"/>
              </Button>
            </Grid>
            <!-- Una colonna per tipo, mai un ContentTemplate statico (CLAUDE.md 8): per un'abitudine che non e' un
                 diario QuickEntryForDiario e' null e nessun composer viene costruito. Il template sceglie la view dalla
                 modalita' (diario della sera o nota veloce) e costruisce solo quella. -->
            <ContentControl x:Name="DiarioHost" Content="{CompiledBinding QuickEntryShownInDiario}">
              <ContentControl.DataTemplates>
                <journal:JournalComposerTemplate/>
              </ContentControl.DataTemplates>
            </ContentControl>
          </DockPanel>
        </Border>

        <Border x:Name="CronologiaColumn" Grid.Column="1"
                Background="{DynamicResource Brush.Background}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6"
                IsVisible="{CompiledBinding ShowCronologia}">
          <Grid>
            <DockPanel>
              <Grid DockPanel.Dock="Top" Height="30" ColumnDefinitions="*,Auto,Auto" Background="{DynamicResource Brush.Surface}">
                <TextBlock Margin="12,0" VerticalAlignment="Center" FontSize="{DynamicResource FontSize.Small}" FontWeight="SemiBold"
                           Text="{x:Static res:Strings.HabitScreen_Column_Cronologia}" Foreground="{DynamicResource Brush.TextMuted}"/>
                <Button Grid.Column="1" x:Name="CronologiaFocusButton" Classes="column-icon"
                        Command="{CompiledBinding ToggleFocusCommand}" CommandParameter="{x:Static vm:HabitColumn.Cronologia}"
                        ToolTip.Tip="{x:Static res:Strings.HabitScreen_Focus}"
                        AutomationProperties.Name="{x:Static res:Strings.HabitScreen_Focus}">
                  <Path Data="{StaticResource Icon.Maximize2}" Classes="column-icon"/>
                </Button>
                <Button Grid.Column="2" x:Name="CronologiaCloseButton" Classes="column-icon"
                        Command="{CompiledBinding ToggleColumnCommand}" CommandParameter="{x:Static vm:HabitColumn.Cronologia}"
                        ToolTip.Tip="{x:Static res:Strings.HabitScreen_Close}"
                        AutomationProperties.Name="{x:Static res:Strings.HabitScreen_Close}">
                  <Path Data="{StaticResource Icon.X}" Classes="column-icon"/>
                </Button>
              </Grid>
              <Border x:Name="CronologiaHost"/>
            </DockPanel>
          </Grid>
        </Border>

        <Border x:Name="ConfiguraColumn" Grid.Column="2"
                Background="{DynamicResource Brush.Background}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,1,1" CornerRadius="6"
                IsVisible="{CompiledBinding ShowConfigura}">
          <Grid>
            <DockPanel>
              <Grid DockPanel.Dock="Top" Height="30" ColumnDefinitions="*,Auto,Auto" Background="{DynamicResource Brush.Surface}">
                <TextBlock Margin="12,0" VerticalAlignment="Center" FontSize="{DynamicResource FontSize.Small}" FontWeight="SemiBold"
                           Text="{x:Static res:Strings.HabitScreen_Configure}" Foreground="{DynamicResource Brush.TextMuted}"/>
                <Button Grid.Column="1" x:Name="ConfiguraFocusButton" Classes="column-icon"
                        Command="{CompiledBinding ToggleFocusCommand}" CommandParameter="{x:Static vm:HabitColumn.Configura}"
                        ToolTip.Tip="{x:Static res:Strings.HabitScreen_Focus}"
                        AutomationProperties.Name="{x:Static res:Strings.HabitScreen_Focus}">
                  <Path Data="{StaticResource Icon.Maximize2}" Classes="column-icon"/>
                </Button>
                <Button Grid.Column="2" x:Name="ConfiguraCloseButton" Classes="column-icon"
                        Command="{CompiledBinding ToggleColumnCommand}" CommandParameter="{x:Static vm:HabitColumn.Configura}"
                        ToolTip.Tip="{x:Static res:Strings.HabitScreen_Close}"
                        AutomationProperties.Name="{x:Static res:Strings.HabitScreen_Close}">
                  <Path Data="{StaticResource Icon.X}" Classes="column-icon"/>
                </Button>
              </Grid>
              <!-- EditorPane, costruito da UpdateColumns solo a colonna aperta (Child null = niente costruito). -->
              <Border x:Name="ConfiguraHost"/>
            </DockPanel>
          </Grid>
        </Border>

        <!-- Un'unica maniglia sul confine Cronologia|Configura (solo con due colonne aperte). -->
        <Thumb x:Name="ColumnResizeThumb" Grid.Column="1" Classes="column-resize" HorizontalAlignment="Right"
               IsVisible="False" ZIndex="1"/>
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>
