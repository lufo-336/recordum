<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmc="using:Recordum.Presentation.ViewModels.HabitScreen.Calendar"
             xmlns:core="using:Recordum.Core.Abstractions"
             xmlns:res="using:Recordum.Presentation.Resources"
             xmlns:conv="using:Recordum.UI.Converters"
             xmlns:cal="using:Recordum.UI.Views.HabitScreen.Calendar"
             x:Class="Recordum.UI.Views.HabitScreen.Calendar.CalendarNavigatorView"
             x:DataType="vmc:CalendarNavigatorViewModel">

  <UserControl.Styles>
    <!-- La cella e' un Button con un template proprio: lo sfondo, il bordo di oggi e quello di selezione sono
         pennelli di tema (DynamicResource) e il template Fluent non li sovrascrive allo stato hover. -->
    <Style Selector="Button.day">
      <Setter Property="Margin" Value="2"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="{DynamicResource Brush.Border}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" ClipToBounds="True">
            <ContentPresenter Content="{TemplateBinding Content}"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.day:disabled"><Setter Property="Opacity" Value="0.4"/></Style>
    <Style Selector="Button.day.outside"><Setter Property="Opacity" Value="0.45"/></Style>
    <Style Selector="Button.day.today"><Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/></Style>
    <!-- Selezionato: un anello (non un riempimento), cosi' la tinta sotto resta visibile. Dopo "today":
         i 2 px vincono sull'1 px di oggi. -->
    <Style Selector="Button.day.selected">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
  </UserControl.Styles>

  <Border Padding="12" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border}">
    <StackPanel>
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
          <RadioButton Classes="segment" GroupName="calview" x:Name="WeekMode"
                       Content="{x:Static res:Strings.Calendar_View_Week}"
                       Command="{CompiledBinding SetViewModeCommand}"
                       CommandParameter="{x:Static vmc:CalendarViewMode.Week}"
                       IsChecked="{CompiledBinding ViewMode, Mode=OneWay, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter={x:Static vmc:CalendarViewMode.Week}}"/>
          <RadioButton Classes="segment" GroupName="calview" Margin="2,0,0,0" x:Name="MonthMode"
                       Content="{x:Static res:Strings.Calendar_View_Month}"
                       Command="{CompiledBinding SetViewModeCommand}"
                       CommandParameter="{x:Static vmc:CalendarViewMode.Month}"
                       IsChecked="{CompiledBinding ViewMode, Mode=OneWay, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter={x:Static vmc:CalendarViewMode.Month}}"/>
          <!-- Anno (mesi/heatmap) e salto diretto mese/anno: F3 (la Cronologia di F2a serve il percorso "ieri"). -->
        </StackPanel>
        <TextBlock Grid.Column="1" x:Name="Header" Text="{CompiledBinding HeaderLabel}" VerticalAlignment="Center"
                   FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}"/>
        <Button Grid.Column="2" x:Name="PrevButton" Width="28" Command="{CompiledBinding PrevCommand}">
          <Path Data="{StaticResource Icon.ChevronRight}" Width="12" Height="12" Stretch="Uniform"
                Stroke="{DynamicResource Brush.Text}" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                RenderTransform="scaleX(-1)" RenderTransformOrigin="50%,50%"/>
        </Button>
        <Button Grid.Column="3" x:Name="NextButton" Width="28" Margin="4,0,0,0" Command="{CompiledBinding NextCommand}">
          <Path Data="{StaticResource Icon.ChevronRight}" Width="12" Height="12" Stretch="Uniform"
                Stroke="{DynamicResource Brush.Text}" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"/>
        </Button>
      </Grid>

      <!-- Intestazione dei giorni: ogni cella e' CellSize larga con lo stesso margine di 2 px di una cella. -->
      <ItemsControl ItemsSource="{CompiledBinding WeekdayHeaders}" HorizontalAlignment="Left">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock Text="{CompiledBinding}" Margin="2" TextAlignment="Center"
                       Width="{CompiledBinding $parent[ItemsControl].((vmc:CalendarNavigatorViewModel)DataContext).CellSize}"
                       FontSize="{DynamicResource FontSize.Small}" Foreground="{DynamicResource Brush.TextMuted}"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Settimana (7 celle) o mese (42): e' la stessa collezione, il pannello si adatta al numero. -->
      <ItemsControl x:Name="Days" ItemsSource="{CompiledBinding Cells}" Margin="0,4,0,0" HorizontalAlignment="Left">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vmc:CalendarDayCellViewModel">
            <Button Classes="day" Classes.today="{CompiledBinding IsToday}" Classes.selected="{CompiledBinding IsSelected}"
                    Classes.outside="{CompiledBinding !InCurrentMonth}" IsEnabled="{CompiledBinding !IsFuture}"
                    Width="{CompiledBinding $parent[ItemsControl].((vmc:CalendarNavigatorViewModel)DataContext).CellSize}"
                    Height="{CompiledBinding $parent[ItemsControl].((vmc:CalendarNavigatorViewModel)DataContext).CellSize}"
                    Command="{CompiledBinding $parent[ItemsControl].((vmc:CalendarNavigatorViewModel)DataContext).SelectDateCommand}"
                    CommandParameter="{CompiledBinding}"
                    ToolTip.Tip="{CompiledBinding TooltipText}">
              <Grid>
                <!-- Tinta: due strati, cosi' il pericolo e' un pennello di tema (si ritinge col tema) e non un
                     esadecimale fotografato. L'opacita' e' la rampa del passo. -->
                <Border x:Name="HabitTint" Background="{CompiledBinding TintColorHex, Converter={x:Static conv:HexToBrushConverter.Instance}}"
                        Opacity="{CompiledBinding TintStep, Converter={x:Static cal:CalendarNavigatorView.StepOpacity}}"
                        IsVisible="{CompiledBinding Tint, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter={x:Static core:MarkerTint.Danger}}"/>
                <Border x:Name="DangerTint" Background="{DynamicResource Brush.Danger}"
                        Opacity="{CompiledBinding TintStep, Converter={x:Static cal:CalendarNavigatorView.StepOpacity}}"
                        IsVisible="{CompiledBinding Tint, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static core:MarkerTint.Danger}}"/>
                <!-- Il numero (il dato) sta al centro, centrato con l'allineamento; il giorno e' un cenno in alto a
                     sinistra e non si sovrappone al cerchio (W2V-4, U4). -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="18" Height="18" Padding="4,0"
                        CornerRadius="9" BorderThickness="1.2" BorderBrush="{DynamicResource Brush.Text}"
                        IsVisible="{CompiledBinding HasNumber}">
                  <TextBlock Text="{CompiledBinding Number}" FontSize="10.5" FontWeight="SemiBold"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{CompiledBinding DayNumber}" HorizontalAlignment="Left" VerticalAlignment="Top"
                           Margin="5,3,0,0" FontSize="10" Opacity="0.85"/>
                <Path HorizontalAlignment="Right" VerticalAlignment="Top" Data="M 0,0 L 13,0 L 13,13 Z"
                      IsVisible="{CompiledBinding HasNote}"
                      Fill="{CompiledBinding $parent[ItemsControl].((vmc:CalendarNavigatorViewModel)DataContext).NoteColorHex, Converter={x:Static conv:HexToBrushConverter.Instance}}"/>
                <TextBlock Text="{CompiledBinding NoteCount}" HorizontalAlignment="Right" VerticalAlignment="Top"
                           Margin="0,0,1,0" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource Brush.Background}"
                           IsVisible="{CompiledBinding ShowNoteCount}"/>
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</UserControl>
