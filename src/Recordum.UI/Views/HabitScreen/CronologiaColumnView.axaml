<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Recordum.Presentation.ViewModels.HabitScreen"
             xmlns:res="using:Recordum.Presentation.Resources"
             xmlns:local="using:Recordum.UI.Views.HabitScreen"
             xmlns:calendar="using:Recordum.UI.Views.HabitScreen.Calendar"
             x:Class="Recordum.UI.Views.HabitScreen.CronologiaColumnView"
             x:DataType="vm:HabitScreenViewModel">
  <!-- Corpo della colonna Cronologia: lo costruisce HabitScreenView solo a colonna aperta (decisione 3). -->
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <Border x:Name="CalendarHost">
        <calendar:CalendarNavigatorView DataContext="{CompiledBinding Calendar}"/>
      </Border>
      <Border x:Name="QuickAddHost"/>
      <Border x:Name="TimerHost">
        <local:TimerControlView DataContext="{CompiledBinding TimerControl}"/>
      </Border>
      <StackPanel Margin="12,4,12,12">
        <TextBlock Text="{x:Static res:Strings.HabitScreen_Records}" FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,6"/>
        <TextBlock x:Name="RecordsEmpty" Text="{x:Static res:Strings.HabitScreen_DayRecords_Empty}" FontSize="12"
                   Foreground="{DynamicResource Brush.TextMuted}" IsVisible="{CompiledBinding Records.IsEmpty}"/>
        <Border x:Name="RecordsHost"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
