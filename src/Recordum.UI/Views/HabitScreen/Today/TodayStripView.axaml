<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Recordum.Presentation.Resources"
             xmlns:tvm="using:Recordum.Presentation.ViewModels.HabitScreen.Today"
             x:Class="Recordum.UI.Views.HabitScreen.Today.TodayStripView"
             x:DataType="tvm:TodayStripViewModel"
             IsVisible="False">
  <Border x:Name="Frame" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border}"/>
</UserControl>
