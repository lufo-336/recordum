<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Recordum.Presentation.Resources"
             xmlns:tvm="using:Recordum.Presentation.ViewModels.HabitScreen.Today"
             x:Class="Recordum.UI.Views.HabitScreen.Today.JournalTodayView"
             x:DataType="tvm:JournalTodayContent">
  <Border Padding="14,10">
    <!-- Un solo pulsante: etichetta e azione seguono il gesto configurato (scrivi la voce / nota veloce). -->
    <Button x:Name="PrimaryButton" Command="{CompiledBinding PrimaryCommand}" Padding="14,7"
            HorizontalAlignment="Left" VerticalAlignment="Center">
      <Panel>
        <TextBlock Text="{x:Static res:Strings.Today_Journal_WriteEntry}" IsVisible="{CompiledBinding !IsQuickNote}"/>
        <TextBlock Text="{x:Static res:Strings.Today_Journal_QuickNote}" IsVisible="{CompiledBinding IsQuickNote}"/>
      </Panel>
    </Button>
  </Border>
</UserControl>
