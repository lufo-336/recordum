<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Recordum.Presentation.Resources"
             xmlns:tvm="using:Recordum.Presentation.ViewModels.HabitScreen.Today"
             x:Class="Recordum.UI.Views.HabitScreen.Head.JournalCommandView"
             x:DataType="tvm:JournalTodayContent">
  <!-- Diario: il gesto configurato (scrivi la voce / nota veloce) apre la colonna Diario. -->
  <Button x:Name="PrimaryButton" Classes="record" Command="{CompiledBinding PrimaryCommand}" HorizontalAlignment="Right">
    <StackPanel Orientation="Horizontal" Spacing="6">
      <Path Classes="record-glyph" Data="{StaticResource Icon.PenLine}"/>
      <Panel>
        <TextBlock Text="{x:Static res:Strings.Today_Journal_WriteEntry}" IsVisible="{CompiledBinding !IsQuickNote}"/>
        <TextBlock Text="{x:Static res:Strings.Today_Journal_QuickNote}" IsVisible="{CompiledBinding IsQuickNote}"/>
      </Panel>
    </StackPanel>
  </Button>
</UserControl>
