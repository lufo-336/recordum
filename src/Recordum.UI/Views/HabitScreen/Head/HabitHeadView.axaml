<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Recordum.Presentation.ViewModels.HabitScreen"
             xmlns:fig="using:Recordum.Presentation.ViewModels.HabitScreen.Figures"
             xmlns:res="using:Recordum.Presentation.Resources"
             xmlns:conv="using:Recordum.UI.Converters"
             xmlns:head="using:Recordum.UI.Views.HabitScreen.Head"
             x:Class="Recordum.UI.Views.HabitScreen.Head.HabitHeadView"
             x:DataType="vm:HabitScreenViewModel">
  <!-- La testa della schermata (spec direzione visiva §6.1): nome nel colore, un solo comando che registra, i numeri, i
       pulsanti delle colonne. Sostituisce la riga del nome, la fascia "Oggi" e la barra dei chip (UX-7, UX-8). -->
  <UserControl.Resources>
    <conv:HabitTextBrushConverter x:Key="HabitText"/>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="ToggleButton.column">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Label}"/>
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ToggleButton.column:pointerover">
      <Setter Property="Background" Value="{DynamicResource Brush.Selection}"/>
    </Style>
    <Style Selector="ToggleButton.column:checked">
      <Setter Property="Background" Value="{DynamicResource Brush.Pane}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.FieldBorder}"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    </Style>
    <Style Selector="ToggleButton.column:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Ink}"/>
    </Style>
    <Style Selector="Path.column-glyph">
      <Setter Property="Width" Value="14"/>
      <Setter Property="Height" Value="14"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Stretch" Value="Uniform"/>
      <Setter Property="StrokeThickness" Value="1.6"/>
      <Setter Property="StrokeLineCap" Value="Round"/>
      <Setter Property="StrokeJoin" Value="Round"/>
      <Setter Property="Stroke" Value="{Binding $parent[ToggleButton].Foreground}"/>
    </Style>
  </UserControl.Styles>

  <StackPanel Margin="16,12,16,6">
    <Grid x:Name="TopGrid" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
      <StackPanel x:Name="NameBlock" Grid.Column="0" VerticalAlignment="Top" Margin="0,0,16,0">
        <StackPanel Orientation="Horizontal">
          <Path x:Name="IconPath" Width="20" Height="20" Margin="0,0,8,0" Stretch="Uniform" VerticalAlignment="Center"
                StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                Data="{CompiledBinding Node.Icon, Converter={x:Static conv:IconKeyToGeometryConverter.Instance}}"
                IsVisible="{Binding #IconPath.Data, Converter={x:Static ObjectConverters.IsNotNull}}"
                Stroke="{Binding #HabitName.Foreground}"/>
          <TextBlock x:Name="HabitName" Text="{CompiledBinding Name}" FontSize="{DynamicResource FontSize.Title}"
                     FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
            <TextBlock.Foreground>
              <MultiBinding Converter="{StaticResource HabitText}">
                <Binding Path="Node.Color"/>
                <Binding Path="ActualThemeVariant" RelativeSource="{RelativeSource Self}"/>
              </MultiBinding>
            </TextBlock.Foreground>
          </TextBlock>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
          <TextBlock x:Name="ScheduleText" Text="{CompiledBinding ScheduleLabel}" FontSize="{DynamicResource FontSize.Small}"
                     Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,8,0"
                     IsVisible="{CompiledBinding ScheduleLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          <TextBlock x:Name="UsualHour" FontSize="{DynamicResource FontSize.Small}" Foreground="{DynamicResource Brush.TextMuted}"
                     Text="{CompiledBinding Figures.UsualHour, StringFormat={x:Static res:Strings.Head_UsualHour}}"
                     IsVisible="{CompiledBinding Figures.UsualHour, Converter={x:Static ObjectConverters.IsNotNull}}"/>
        </StackPanel>
      </StackPanel>

      <StackPanel x:Name="CommandBlock" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
        <Border x:Name="CommandHost" HorizontalAlignment="Right"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
          <Button x:Name="UndoButton" Classes="ghost" Padding="6,2" FontSize="{DynamicResource FontSize.Small}"
                  Content="{x:Static res:Strings.Head_Undo}" Command="{CompiledBinding UndoLastCommand}"
                  IsVisible="{CompiledBinding CanUndoLast}"/>
          <Button x:Name="OtherDayButton" Classes="ghost" Padding="6,2" FontSize="{DynamicResource FontSize.Small}"
                  Content="{x:Static res:Strings.Head_OtherDay}">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <Calendar x:Name="OtherDayCalendar" SelectionMode="SingleDate"/>
              </Flyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
        <StackPanel x:Name="OtherDayLine" Orientation="Horizontal" HorizontalAlignment="Right"
                    IsVisible="{CompiledBinding !IsSelectedDayToday}">
          <TextBlock x:Name="SelectedDayText" VerticalAlignment="Center" FontSize="{DynamicResource FontSize.Small}"
                     Foreground="{DynamicResource Brush.Text}"
                     Text="{CompiledBinding SelectedDayLabel, StringFormat={x:Static res:Strings.Head_RecordingFor}}"/>
          <Button x:Name="BackToTodayButton" Classes="ghost" Padding="6,2" FontSize="{DynamicResource FontSize.Small}"
                  Content="{x:Static res:Strings.Head_BackToToday}" Command="{CompiledBinding BackToTodayCommand}"/>
        </StackPanel>
      </StackPanel>
      <!-- Export arriva con F6: nascosto come prima. -->
      <Button Grid.Column="1" x:Name="ExportButton" IsVisible="False" Content="{x:Static res:Strings.Export_Button}"/>
    </Grid>

    <ItemsControl x:Name="Figures" ItemsSource="{CompiledBinding Figures.Items}" Margin="0,12,0,0"
                  IsVisible="{CompiledBinding !IsGroupNode}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="4"/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="fig:HabitFigure">
          <StackPanel Margin="0,0,12,4">
            <TextBlock Text="{CompiledBinding Value}" FontSize="{DynamicResource FontSize.Title}" FontWeight="SemiBold"
                       FontFeatures="+tnum" TextTrimming="CharacterEllipsis">
              <TextBlock.Foreground>
                <MultiBinding Converter="{StaticResource HabitText}">
                  <Binding Path="$parent[head:HabitHeadView].((vm:HabitScreenViewModel)DataContext).Node.Color"/>
                  <Binding Path="ActualThemeVariant" RelativeSource="{RelativeSource Self}"/>
                </MultiBinding>
              </TextBlock.Foreground>
            </TextBlock>
            <TextBlock Text="{CompiledBinding Caption}" FontSize="{DynamicResource FontSize.Small}"
                       Foreground="{DynamicResource Brush.TextMuted}" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <WrapPanel x:Name="ColumnButtons" Orientation="Horizontal" Margin="0,10,0,0" IsVisible="{CompiledBinding ShowChipBar}">
      <ToggleButton x:Name="ChipDiario" Classes="column" IsChecked="{CompiledBinding IsDiarioOpen, Mode=TwoWay}"
                    IsVisible="{CompiledBinding IsJournal}">
        <StackPanel Orientation="Horizontal">
          <Path Classes="column-glyph" Data="{StaticResource Icon.PenLine}"/>
          <TextBlock Text="{x:Static res:Strings.HabitScreen_Column_Diary}"/>
        </StackPanel>
      </ToggleButton>
      <ToggleButton x:Name="ChipCronologia" Classes="column" IsChecked="{CompiledBinding IsCronologiaOpen, Mode=TwoWay}"
                    IsVisible="{CompiledBinding !IsGroupNode}">
        <StackPanel Orientation="Horizontal">
          <Path Classes="column-glyph" Data="{StaticResource Icon.Calendar}"/>
          <TextBlock Text="{x:Static res:Strings.HabitScreen_Column_Cronologia}"/>
        </StackPanel>
      </ToggleButton>
      <ToggleButton x:Name="ChipNote" Classes="column" IsChecked="{CompiledBinding IsNoteOpen, Mode=TwoWay}"
                    IsVisible="{CompiledBinding !IsGroupNode}">
        <StackPanel Orientation="Horizontal">
          <Path Classes="column-glyph" Data="{StaticResource Icon.BookOpen}"/>
          <TextBlock Text="{x:Static res:Strings.HabitScreen_Tab_Notes}"/>
        </StackPanel>
      </ToggleButton>
      <ToggleButton x:Name="ChipConfigura" Classes="column" IsChecked="{CompiledBinding IsConfiguraOpen, Mode=TwoWay}">
        <StackPanel Orientation="Horizontal">
          <Path Classes="column-glyph" Data="{StaticResource Icon.SlidersHorizontal}"/>
          <TextBlock Text="{x:Static res:Strings.HabitScreen_Configure}"/>
        </StackPanel>
      </ToggleButton>
    </WrapPanel>
  </StackPanel>
</UserControl>
