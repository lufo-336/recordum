<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Recordum.Presentation.Resources"
             xmlns:vm="using:Recordum.Presentation.ViewModels.HabitScreen"
             xmlns:qa="using:Recordum.Presentation.ViewModels.HabitScreen.QuickAdd"
             xmlns:tvm="using:Recordum.Presentation.ViewModels.HabitScreen.Today"
             xmlns:head="using:Recordum.UI.Views.HabitScreen.Head"
             xmlns:qav="using:Recordum.UI.Views.HabitScreen.QuickAdd"
             x:Class="Recordum.UI.Views.HabitScreen.Head.StateCommandView"
             x:DataType="qa:MeasuredQuickAddViewModel">
  <!-- Stato: con una scala sola di al più 10 gradini, un gradino per etichetta e un clic registra; altrimenti le celle e
       "Registra". Accanto l'ultimo valore. -->
  <UserControl.Styles>
    <Style Selector="Button.step">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.step.current">
      <Setter Property="Background" Value="{DynamicResource Brush.Habit}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Habit}"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.OnInk}"/>
    </Style>
    <!-- Fluent e lo stile globale .record:pointerover ridipingono PART_ContentPresenter su hover/pressed. -->
    <Style Selector="Button.step.current /template/ ContentPresenter#PART_ContentPresenter, Button.step.current:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.step.current:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.Habit}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Habit}"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.OnInk}"/>
    </Style>
  </UserControl.Styles>
  <StackPanel HorizontalAlignment="Right">
    <ItemsControl x:Name="Steps" ItemsSource="{CompiledBinding Steps}" IsVisible="{CompiledBinding HasSteps}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4"/></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="qa:ScalePoint">
          <StackPanel Width="56">
            <Button Classes="record step" Classes.current="{CompiledBinding IsCurrent}" Width="30" Height="30" Padding="0" HorizontalAlignment="Center"
                    ToolTip.Tip="{CompiledBinding Label}" AutomationProperties.Name="{CompiledBinding Label}"
                    Command="{CompiledBinding $parent[ItemsControl].((qa:MeasuredQuickAddViewModel)DataContext).RecordStepCommand}"
                    CommandParameter="{CompiledBinding}">
              <TextBlock Text="{CompiledBinding Value}" FontSize="{DynamicResource FontSize.Label}" FontWeight="Medium"
                         FontFeatures="+tnum" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
            <!-- Va a capo, non si tronca: "Very good" in 56 px diventava "Very go…" (visto nei PNG). -->
            <TextBlock x:Name="StepLabel" Text="{CompiledBinding Label}" FontSize="{DynamicResource FontSize.Small}" Margin="0,3,0,0"
                       Foreground="{DynamicResource Brush.TextMuted}" TextAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <qav:MeasuredQuickAddView x:Name="Cells" IsVisible="{CompiledBinding !HasSteps}"/>
    <TextBlock x:Name="LastValue" HorizontalAlignment="Right" FontSize="{DynamicResource FontSize.Small}" Margin="0,4,0,0"
               Foreground="{DynamicResource Brush.TextMuted}"
               Text="{CompiledBinding $parent[head:HabitHeadView].((vm:HabitScreenViewModel)DataContext).TodayStrip.((tvm:StateTodayContent)Content).LastValueLabel, StringFormat={x:Static res:Strings.Today_State_LastValue}}"
               IsVisible="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
    <TextBlock x:Name="Error" Margin="0,6,0,0" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" MaxWidth="280"
               Text="{CompiledBinding ErrorMessage}"
               IsVisible="{CompiledBinding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"/>
  </StackPanel>
</UserControl>
