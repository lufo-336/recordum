<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Recordum.Presentation.Resources"
             xmlns:qa="using:Recordum.Presentation.ViewModels.HabitScreen.QuickAdd"
             x:Class="Recordum.UI.Views.HabitScreen.Head.AbstinenceCommandView"
             x:DataType="qa:AbstinenceQuickAddViewModel">
  <!-- Astinenza: "Segna una ricaduta…" chiede prima di chiudere il periodo; senza periodo aperto "Inizio". -->
  <StackPanel HorizontalAlignment="Right">
    <Button x:Name="LapseButton" Classes="record" Content="{x:Static res:Strings.Head_Abstinence_Lapse}"
            IsVisible="{CompiledBinding CanLapse}">
      <Button.Flyout>
        <Flyout Placement="BottomEdgeAlignedRight" Opening="OnLapseFlyoutOpening">
          <StackPanel MaxWidth="280" Spacing="10">
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}"
                       Text="{x:Static res:Strings.Head_Abstinence_LapseConfirm}"/>
            <!-- Il giorno scelto, solo se non e' oggi: il testo lo imposta il code-behind all'apertura. -->
            <TextBlock Tag="LapseOn" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}" IsVisible="False"/>
            <Button x:Name="ConfirmLapseButton" Classes="primary" HorizontalAlignment="Right"
                    Content="{x:Static res:Strings.Head_Confirm}" Click="OnConfirmLapse"/>
          </StackPanel>
        </Flyout>
      </Button.Flyout>
    </Button>
    <Button x:Name="StartButton" Classes="record" Content="{x:Static res:Strings.Abstinence_Start}"
            Command="{CompiledBinding StartCommand}" IsVisible="{CompiledBinding CanStart}"/>
    <!-- Dopo una ricaduta "Inizia" e' il comando che registra (Button.record): dimenticare di ripartire costa la serie del
         gruppo, e il giorno della ricaduta sta li' accanto. -->
    <TextBlock x:Name="Relapsed" Margin="0,6,0,0" HorizontalAlignment="Right" FontSize="{StaticResource FontSize.Small}"
               Foreground="{DynamicResource Brush.TextMuted}"
               Text="{CompiledBinding RelapsedOnDisplay}"
               IsVisible="{CompiledBinding RelapsedOnDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
    <TextBlock x:Name="Error" Margin="0,6,0,0" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" MaxWidth="280"
               Text="{CompiledBinding ErrorMessage}"
               IsVisible="{CompiledBinding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"/>
  </StackPanel>
</UserControl>
