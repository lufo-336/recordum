<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Recordum.Presentation.ViewModels.HabitScreen"
             xmlns:m="using:Recordum.Core.Models"
             xmlns:res="using:Recordum.Presentation.Resources"
             x:Class="Recordum.UI.Views.HabitScreen.TimerControlView"
             x:DataType="vm:TimerControlViewModel">

  <!-- Il cronometro del comando in testa (direzione visiva §6.2): da fermo "Inizia"; mentre corre il tempo nella variante
       "testo" del colore, Pausa/Riprendi, Segmento successivo (solo a segmenti), Ferma. -->
  <Border x:Name="Root" IsVisible="{CompiledBinding IsApplicable}">
    <StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <TextBlock x:Name="Elapsed" Text="{CompiledBinding ElapsedDisplay}" IsVisible="{CompiledBinding IsActive}"
                   FontFeatures="+tnum" FontSize="{DynamicResource FontSize.Title}" FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.HabitText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <Button x:Name="StartButton" Classes="record"
                Command="{CompiledBinding StartCommand}" IsVisible="{CompiledBinding !IsActive}"
                AutomationProperties.Name="{x:Static res:Strings.HabitScreen_Timer_Start}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Classes="record-glyph" Data="{StaticResource Icon.Play}"/>
            <TextBlock Text="{x:Static res:Strings.Head_Session_Start}"/>
          </StackPanel>
        </Button>
        <StackPanel Orientation="Horizontal" IsVisible="{CompiledBinding IsActive}">
          <Button x:Name="PauseButton" Width="30" Height="30" Padding="0" Margin="0,0,6,0"
                  Command="{CompiledBinding PauseCommand}" IsVisible="{CompiledBinding !IsPaused}"
                  ToolTip.Tip="{x:Static res:Strings.HabitScreen_Timer_Pause}"
                  AutomationProperties.Name="{x:Static res:Strings.HabitScreen_Timer_Pause}">
            <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource Brush.Text}" StrokeThickness="1.6"
                  StrokeLineCap="Round" StrokeJoin="Round" Data="{StaticResource Icon.Pause}"/>
          </Button>
          <Button x:Name="ResumeButton" Width="30" Height="30" Padding="0" Margin="0,0,6,0"
                  Command="{CompiledBinding ResumeCommand}" IsVisible="{CompiledBinding IsPaused}"
                  ToolTip.Tip="{x:Static res:Strings.HabitScreen_Timer_Resume}"
                  AutomationProperties.Name="{x:Static res:Strings.HabitScreen_Timer_Resume}">
            <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1.6"
                  StrokeLineCap="Round" StrokeJoin="Round" Data="{StaticResource Icon.Play}"/>
          </Button>
          <Button x:Name="StopButton" Width="30" Height="30" Padding="0" Margin="0,0,6,0"
                  Command="{CompiledBinding StopCommand}"
                  ToolTip.Tip="{x:Static res:Strings.HabitScreen_Timer_Stop}"
                  AutomationProperties.Name="{x:Static res:Strings.HabitScreen_Timer_Stop}">
            <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource Brush.Text}" StrokeThickness="1.6"
                  StrokeLineCap="Round" StrokeJoin="Round" Data="{StaticResource Icon.Square}"/>
          </Button>
          <Button x:Name="NextSegmentButton" Padding="10,4" VerticalAlignment="Center"
                  Command="{CompiledBinding NextSegmentCommand}" IsVisible="{CompiledBinding IsSegmented}"
                  Content="{x:Static res:Strings.HabitScreen_Timer_NextSegment}"/>
        </StackPanel>
      </StackPanel>
      <ItemsControl ItemsSource="{CompiledBinding Segments}" Margin="0,6,0,0" HorizontalAlignment="Right"
                    IsVisible="{CompiledBinding IsSegmented}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="m:SegmentDefinition">
            <Border Padding="6,2" Margin="0,0,6,0" BorderThickness="1" CornerRadius="3"
                    BorderBrush="{DynamicResource Brush.Border}">
              <TextBlock Text="{CompiledBinding Name}" Foreground="{DynamicResource Brush.TextMuted}"/>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</UserControl>
