<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:res="using:Recordum.Presentation.Resources" xmlns:qa="using:Recordum.Presentation.ViewModels.HabitScreen.QuickAdd"
             x:Class="Recordum.UI.Views.HabitScreen.QuickAdd.CounterTapQuickAddView"
             x:DataType="qa:CounterTapQuickAddViewModel">
  <StackPanel Margin="12">
    <StackPanel Orientation="Horizontal">
      <Button x:Name="TapButton" Command="{CompiledBinding TapCommand}" Width="44" Height="44" Padding="0"
              Content="{x:Static res:Strings.HabitScreen_QuickAdd_Tap}" FontSize="17" FontWeight="SemiBold"
              Foreground="{DynamicResource Brush.OnAccent}" Background="{DynamicResource Brush.Accent}"
              CornerRadius="22" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
      <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
        <TextBlock x:Name="Count" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Brush.Text}"
                   Text="{CompiledBinding DayCount, StringFormat={x:Static res:Strings.HabitScreen_QuickAdd_TodayCount}}"/>
        <Button x:Name="UndoButton" Command="{CompiledBinding UndoLastCommand}"
                Content="{x:Static res:Strings.HabitScreen_QuickAdd_UndoLast}" HorizontalAlignment="Left"
                Padding="0,4,0,0" Background="Transparent" BorderThickness="0"
                Foreground="{DynamicResource Brush.TextMuted}"/>
      </StackPanel>
    </StackPanel>
    <TextBlock x:Name="Error" Margin="0,6,0,0" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap"
               Text="{CompiledBinding ErrorMessage}"
               IsVisible="{CompiledBinding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"/>
  </StackPanel>
</UserControl>
