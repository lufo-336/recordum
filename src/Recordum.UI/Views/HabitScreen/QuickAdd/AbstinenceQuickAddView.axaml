<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:res="using:Recordum.Presentation.Resources" xmlns:qa="using:Recordum.Presentation.ViewModels.HabitScreen.QuickAdd"
             x:Class="Recordum.UI.Views.HabitScreen.QuickAdd.AbstinenceQuickAddView"
             x:DataType="qa:AbstinenceQuickAddViewModel">
  <StackPanel Margin="12">
    <StackPanel x:Name="CleanRow" Orientation="Horizontal" Margin="0,0,0,10" IsVisible="{CompiledBinding CanLapse}">
      <TextBlock Text="{x:Static res:Strings.Abstinence_CleanFor}" Foreground="{DynamicResource Brush.TextMuted}"
                 VerticalAlignment="Center" Margin="0,0,6,0"/>
      <TextBlock x:Name="Elapsed" Text="{CompiledBinding ElapsedDisplay}" FontSize="20"
                 Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"/>
    </StackPanel>
    <TextBlock x:Name="RelapsedOn" Text="{CompiledBinding RelapsedOnDisplay}" Margin="0,0,0,10"
               Foreground="{DynamicResource Brush.TextMuted}"
               IsVisible="{CompiledBinding RelapsedOn, Converter={x:Static ObjectConverters.IsNotNull}}"/>
    <Button x:Name="LapseButton" Content="{x:Static res:Strings.Abstinence_Lapse}" Command="{CompiledBinding LapseCommand}"
            HorizontalAlignment="Left" Padding="12,6" Margin="0,0,0,6" Foreground="{DynamicResource Brush.Danger}"
            IsVisible="{CompiledBinding CanLapse}"/>
    <Button x:Name="StartButton" Content="{x:Static res:Strings.Abstinence_Start}" Command="{CompiledBinding StartCommand}"
            HorizontalAlignment="Left" Padding="12,6" IsVisible="{CompiledBinding CanStart}"/>
  </StackPanel>
</UserControl>
