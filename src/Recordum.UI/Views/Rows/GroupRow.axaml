<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Recordum.Presentation.ViewModels"
             xmlns:res="using:Recordum.Presentation.Resources"
             xmlns:conv="using:Recordum.UI.Converters"
             xmlns:ctl="using:Recordum.UI.Controls"
             x:Class="Recordum.UI.Views.Rows.GroupRow"
             x:DataType="vm:HomeRowViewModel">
  <!-- Il menu della riga è una risorsa: il dizionario XAML costruisce le voci solo al primo accesso,
       e il code-behind lo aggancia alla prima richiesta di menu (tasto destro, Shift+F10). Costruito
       subito costava dieci voci per ognuna delle 300 righe della Home (F1-PERF1). -->
  <UserControl.Resources>
    <ContextMenu x:Key="RowMenu" x:DataType="vm:HomeRowViewModel">
      <MenuItem Header="{x:Static res:Strings.Home_ContextMenu_Rename}"
                Command="{CompiledBinding BeginRenameCommand}"
                IsVisible="{CompiledBinding ShowRenameMenu}"><MenuItem.Icon><Path Classes="menuicon" Data="{StaticResource Icon.Pencil}"/></MenuItem.Icon></MenuItem>
      <MenuItem Header="{x:Static res:Strings.Home_ContextMenu_Archive}"
                Command="{CompiledBinding ArchiveCommand}"
                IsVisible="{CompiledBinding ShowArchive}"><MenuItem.Icon><Path Classes="menuicon" Data="{StaticResource Icon.Archive}"/></MenuItem.Icon></MenuItem>
      <MenuItem Header="{x:Static res:Strings.Home_ContextMenu_Unarchive}"
                Command="{CompiledBinding UnarchiveCommand}"
                IsVisible="{CompiledBinding ShowUnarchive}"><MenuItem.Icon><Path Classes="menuicon" Data="{StaticResource Icon.Archive}"/></MenuItem.Icon></MenuItem>
      <MenuItem Header="{x:Static res:Strings.Home_ContextMenu_SoftDelete}"
                Command="{CompiledBinding SoftDeleteCommand}"
                IsVisible="{CompiledBinding ShowSoftDelete}" Classes="danger"><MenuItem.Icon><Path Classes="menuicon" Data="{StaticResource Icon.Trash2}"/></MenuItem.Icon></MenuItem>
      <MenuItem Header="{x:Static res:Strings.Home_ContextMenu_Restore}"
                Command="{CompiledBinding RestoreCommand}"
                IsVisible="{CompiledBinding ShowRestore}"><MenuItem.Icon><Path Classes="menuicon" Data="{StaticResource Icon.RotateCcw}"/></MenuItem.Icon></MenuItem>
      <MenuItem Header="{x:Static res:Strings.Home_ContextMenu_Purge}"
                Command="{CompiledBinding PurgeCommand}"
                IsVisible="{CompiledBinding ShowPurge}" Classes="danger"><MenuItem.Icon><Path Classes="menuicon" Data="{StaticResource Icon.Trash2}"/></MenuItem.Icon></MenuItem>
    </ContextMenu>
  </UserControl.Resources>

  <!-- Niente più cornice attorno ai figli: la Home è una lista piatta, e la cornice la disegna
       GroupFrames a fette, riga per riga (F1-PERF1). -->
  <Panel>
    <ctl:GroupFrames Slices="{CompiledBinding FrameSlices}"/>
    <Border Classes="habitblock group"
            Margin="{CompiledBinding Converter={x:Static conv:RowCardMarginConverter.Instance}}"
            Classes.selected="{CompiledBinding IsSelected}"
            Classes.droptarget="{CompiledBinding IsDropTarget}"
            Classes.dragging="{CompiledBinding IsBeingDragged}"
            Classes.dropbefore="{CompiledBinding DropEdge, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter={x:Static vm:RowDropEdge.Before}}"
            Classes.dropafter="{CompiledBinding DropEdge, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter={x:Static vm:RowDropEdge.After}}">
      <Grid x:Name="MenuHost" ColumnDefinitions="Auto,Auto,*,Auto">
        <ToggleButton Grid.Column="0" Classes="chevron" Margin="4,0,0,0" VerticalAlignment="Center"
                      IsChecked="{CompiledBinding IsExpanded, Mode=TwoWay}">
          <!-- Data e Stroke arrivano dallo stile `.chevron` e cambiano con :checked. -->
          <Path Width="13" Height="13" Stretch="Uniform"
                StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"/>
        </ToggleButton>

        <!-- Il gruppo non è tinto (direzione visiva §5): la barra nel suo colore, il nome come titolo piccolo e quante
             figlie sono fatte oggi. -->
        <Rectangle Grid.Column="1" Width="{StaticResource Layout.AccentBarWidth}" Height="18" RadiusX="2" RadiusY="2"
                   Fill="{CompiledBinding ColorHex, Converter={x:Static conv:HexToBrushConverter.Instance}}"/>

        <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                   FontSize="{StaticResource FontSize.Small}" FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource Brush.TextMuted}"
                   Text="{CompiledBinding Name}"/>

        <TextBlock Grid.Column="3" Margin="0,0,12,0" VerticalAlignment="Center"
                   FontSize="{StaticResource FontSize.Small}"
                   Foreground="{DynamicResource Brush.TextMuted}"
                   Text="{CompiledBinding GroupProgressText}"
                   IsVisible="{CompiledBinding ShowGroupProgress}"/>
      </Grid>
    </Border>
  </Panel>
</UserControl>
