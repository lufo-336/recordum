<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="Recordum.UI.Views.ThemeProbeView"
             Background="{DynamicResource Brush.Background}"
             FontFamily="{DynamicResource Font.Default}"
             FontSize="{DynamicResource FontSize.Body}">

  <!--
  Sonda di styling (branch avalonia-linux-slice, NON una feature): esercita solo ciò che
  Recordum mette davvero a schermo (CLAUDE.md §9 + BaseStyles.xaml), colorato SOLO dai token di
  Themes/Tokens.axaml — nessuna vista dell'app reale include questo file (vedi commento in
  App.axaml). Le due sezioni non-Fluent (riga habit, heatmap) sono composizioni di Border/token,
  non "controlli restilizzati": non hanno equivalente da confrontare con BaseStyles.xaml perché
  in WPF sono altrettanto bespoke (Canvas/ItemsControl a mano) — costano uguale sulle due shell.
  -->

  <ScrollViewer Padding="24">
    <StackPanel Spacing="20">

      <TextBlock Text="Avalonia theme probe" FontSize="{DynamicResource FontSize.Heading}" FontWeight="SemiBold"/>

      <!-- ================= Riga habit mock: barra accento 4px + nome + testo muto + heatmap 7 celle ================= -->
      <Border Background="{DynamicResource Brush.SurfaceElevated}"
              BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6">
        <Grid ColumnDefinitions="Auto,*,Auto" Height="{DynamicResource Layout.RowHeight}">
          <!-- Barra accento: identificatore di colore, mai decorazione (CLAUDE.md §9). -->
          <Border Grid.Column="0" Width="{DynamicResource Layout.AccentBarWidth}"
                  Background="{DynamicResource Brush.Accent}"
                  CornerRadius="3,0,0,3" VerticalAlignment="Stretch"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                      VerticalAlignment="Center" Margin="12,0,0,0">
            <TextBlock Text="Morning run" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"/>
            <TextBlock Text="7-day streak" Foreground="{DynamicResource Brush.TextMuted}"
                       FontSize="{DynamicResource FontSize.Small}" VerticalAlignment="Center"/>
          </StackPanel>
          <!-- Striscia heatmap: 7 celle, tutti i 5 livelli della ramp GitHub-style. -->
          <StackPanel Grid.Column="2" Orientation="Horizontal"
                      Spacing="{DynamicResource Layout.HeatmapGap}"
                      VerticalAlignment="Center" Margin="0,0,12,0">
            <Border Width="{DynamicResource Layout.HeatmapCell}" Height="{DynamicResource Layout.HeatmapCell}"
                    CornerRadius="2" Background="{DynamicResource Brush.Heatmap.Level0}"/>
            <Border Width="{DynamicResource Layout.HeatmapCell}" Height="{DynamicResource Layout.HeatmapCell}"
                    CornerRadius="2" Background="{DynamicResource Brush.Heatmap.Level1}"/>
            <Border Width="{DynamicResource Layout.HeatmapCell}" Height="{DynamicResource Layout.HeatmapCell}"
                    CornerRadius="2" Background="{DynamicResource Brush.Heatmap.Level2}"/>
            <Border Width="{DynamicResource Layout.HeatmapCell}" Height="{DynamicResource Layout.HeatmapCell}"
                    CornerRadius="2" Background="{DynamicResource Brush.Heatmap.Level3}"/>
            <Border Width="{DynamicResource Layout.HeatmapCell}" Height="{DynamicResource Layout.HeatmapCell}"
                    CornerRadius="2" Background="{DynamicResource Brush.Heatmap.Level4}"/>
            <Border Width="{DynamicResource Layout.HeatmapCell}" Height="{DynamicResource Layout.HeatmapCell}"
                    CornerRadius="2" Background="{DynamicResource Brush.Heatmap.Level2}"/>
            <Border Width="{DynamicResource Layout.HeatmapCell}" Height="{DynamicResource Layout.HeatmapCell}"
                    CornerRadius="2" Background="{DynamicResource Brush.Heatmap.Level0}"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ================= Card: superficie elevata + bordo + angoli ================= -->
      <Border Background="{DynamicResource Brush.SurfaceElevated}"
              BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
              CornerRadius="8" Padding="16">
        <StackPanel Spacing="6">
          <TextBlock Text="Card di superficie" Foreground="{DynamicResource Brush.Text}" FontWeight="SemiBold"/>
          <TextBlock Text="Solo Border + token: nessun controllo da restilizzare, costa uguale su entrambe le shell."
                     Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <!-- ================= Pulsanti: primario (Recordum.Styles) e ghost/quiet (Recordum.Styles) ================= -->
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Content="Salva" Classes="primary"/>
        <Button Content="Annulla" Classes="ghost"/>
      </StackPanel>

      <!-- ================= Input: TextBox (underline via Recordum.Styles), ComboBox, CheckBox, Slider — tutti a default Fluent + soli token ================= -->
      <StackPanel Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
        <TextBox Width="180" Text="Nome abitudine" PlaceholderText="Nome..."/>

        <ComboBox Width="140" SelectedIndex="0">
          <ComboBoxItem Content="Ogni giorno"/>
          <ComboBoxItem Content="Giorni specifici"/>
        </ComboBox>

        <CheckBox Content="Ripetibile" IsChecked="True"/>

        <StackPanel Width="140" VerticalAlignment="Center">
          <Slider Minimum="0" Maximum="10" Value="6"/>
        </StackPanel>
      </StackPanel>

      <!-- ================= Expander (chiuso) — default Fluent, solo colore da token ================= -->
      <Expander Header="Impostazioni avanzate" IsExpanded="False">
        <TextBlock Text="Contenuto avanzato, visibile solo espandendo." Foreground="{DynamicResource Brush.TextMuted}"/>
      </Expander>

      <!-- ================= TabControl a 2 tab — default Fluent, solo colore da token ================= -->
      <TabControl Height="120">
        <TabItem Header="Registrazioni">
          <TextBlock Text="Contenuto tab 1" Foreground="{DynamicResource Brush.Text}" Margin="8"/>
        </TabItem>
        <TabItem Header="Statistiche">
          <TextBlock Text="Contenuto tab 2" Foreground="{DynamicResource Brush.Text}" Margin="8"/>
        </TabItem>
      </TabControl>

      <!-- ================= ScrollViewer con overflow — scrollbar visibile, default Fluent ================= -->
      <TextBlock Text="Sotto: un riquadro con contenuto che eccede l'altezza, per mostrare la scrollbar." Foreground="{DynamicResource Brush.TextMuted}"/>
      <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Height="90">
        <ScrollViewer>
          <StackPanel Spacing="4" Margin="8">
            <TextBlock Text="Riga 1" Foreground="{DynamicResource Brush.Text}"/>
            <TextBlock Text="Riga 2" Foreground="{DynamicResource Brush.Text}"/>
            <TextBlock Text="Riga 3" Foreground="{DynamicResource Brush.Text}"/>
            <TextBlock Text="Riga 4" Foreground="{DynamicResource Brush.Text}"/>
            <TextBlock Text="Riga 5" Foreground="{DynamicResource Brush.Text}"/>
            <TextBlock Text="Riga 6" Foreground="{DynamicResource Brush.Text}"/>
            <TextBlock Text="Riga 7" Foreground="{DynamicResource Brush.Text}"/>
            <TextBlock Text="Riga 8" Foreground="{DynamicResource Brush.Text}"/>
          </StackPanel>
        </ScrollViewer>
      </Border>

    </StackPanel>
  </ScrollViewer>

</UserControl>
