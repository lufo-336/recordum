<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Recordum.Presentation.Resources"
             xmlns:pvm="using:Recordum.Presentation.ViewModels.HabitBuilder.Preview"
             xmlns:conv="using:Recordum.UI.Converters"
             xmlns:ctl="using:Recordum.UI.Controls"
             xmlns:today="using:Recordum.UI.Views.HabitScreen.Today"
             x:Class="Recordum.UI.Views.HabitBuilder.BuilderPreviewPane"
             x:DataType="pvm:BuilderPreviewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="{StaticResource FontSize.Small}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Padding" Value="10"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
      <Setter Property="Background" Value="{DynamicResource Brush.SurfaceElevated}"/>
      <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>
    <Style Selector="Border.ghost">
      <Setter Property="Height" Value="8"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="Background" Value="{DynamicResource Brush.Border}"/>
    </Style>
    <Style Selector="Border.chip">
      <Setter Property="Padding" Value="8,3"/>
      <Setter Property="Margin" Value="0,0,6,4"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
    </Style>
    <Style Selector="Border.box">
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
      <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
    </Style>
  </UserControl.Styles>

  <!-- Inerte per costruzione: il flag sta sul CONTENUTO e non sullo ScrollViewer (spegnere l'hit-test dello
       scroller ucciderebbe anche rotella e cursore). -->
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel x:Name="Inert" Margin="16,12" IsHitTestVisible="False">

      <!-- Livello 1: la riga in Home — la stessa striscia per tipo della riga vera (W2V-19). -->
      <TextBlock Classes="label" Text="{x:Static res:Strings.HabitBuilder_Preview_Home}"/>
      <Border Classes="card">
        <Grid x:Name="HomeRowGrid" ColumnDefinitions="Auto,*,Auto,Auto">
          <Rectangle Grid.Column="0" Width="{StaticResource Layout.AccentBarWidth}" Margin="0,0,10,0"
                     Fill="{CompiledBinding HomeRow.Color, Converter={x:Static conv:HexToBrushConverter.Instance}}"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Path x:Name="IconPath" Width="16" Height="16" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center"
                  Stroke="{CompiledBinding HomeRow.Color, Converter={x:Static conv:HexToBrushConverter.Instance}}"
                  StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
                  Data="{CompiledBinding HomeRow.Icon, Converter={x:Static conv:IconKeyToGeometryConverter.Instance}}"
                  IsVisible="{Binding #IconPath.Data, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            <TextBlock x:Name="NameText" Text="{CompiledBinding HomeRow.Name}" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource Brush.Text}"/>
          </StackPanel>
          <TextBlock x:Name="KeyFigureText" Grid.Column="2" Margin="8,0" VerticalAlignment="Center"
                     FontSize="{StaticResource FontSize.Small}" FontWeight="SemiBold"
                     Foreground="{CompiledBinding HomeRow.Color, Converter={x:Static conv:HexToBrushConverter.Instance}}"
                     Text="{CompiledBinding HomeRow.KeyFigure}"
                     IsVisible="{CompiledBinding HomeRow.KeyFigure, Converter={x:Static ObjectConverters.IsNotNull}}"/>
          <ctl:HeatmapStrip x:Name="HomeStrip" Grid.Column="3" VerticalAlignment="Center"
                            Kind="{CompiledBinding HomeRow.StripStyle}"
                            Fractions="{CompiledBinding HomeRow.Fractions}"
                            AccentColor="{CompiledBinding HomeRow.Color}"/>
        </Grid>
      </Border>

      <!-- Livello 2: la fascia "Oggi" (le view reali). Null per il diario: niente da mostrare. -->
      <StackPanel IsVisible="{CompiledBinding Today, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Classes="label" Text="{x:Static res:Strings.HabitBuilder_Preview_Today}"/>
        <Border Classes="card">
          <ContentControl Content="{CompiledBinding Today}" HorizontalContentAlignment="Stretch"
                          ContentTemplate="{x:Static today:TodayContentTemplate.Instance}"/>
        </Border>
      </StackPanel>

      <!-- Livello 3: il modulo di registrazione -->
      <TextBlock Classes="label" Text="{x:Static res:Strings.HabitBuilder_Preview_Recording}"/>
      <Border Classes="card">
        <Panel>
          <StackPanel Orientation="Horizontal"
                      IsVisible="{CompiledBinding Recording.Kind, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter={x:Static pvm:RecordingPreviewKind.Done}}">
            <CheckBox IsChecked="True" VerticalAlignment="Center"/>
            <TextBlock Text="{x:Static res:Strings.HabitBuilder_Preview_Done}" Margin="8,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.Text}"/>
          </StackPanel>

          <Border Width="56" Height="56" CornerRadius="28" HorizontalAlignment="Left"
                  Background="{DynamicResource Brush.Accent}"
                  IsVisible="{CompiledBinding Recording.Kind, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter={x:Static pvm:RecordingPreviewKind.Tap}}">
            <TextBlock Text="{x:Static res:Strings.HabitBuilder_Preview_Tap}" FontSize="22" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.OnAccent}"/>
          </Border>

          <StackPanel IsVisible="{CompiledBinding Recording.Kind, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter={x:Static pvm:RecordingPreviewKind.Fields}}">
            <ItemsControl ItemsSource="{CompiledBinding Recording.SeriesLabels}" Margin="0,0,0,8">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Border Classes="chip">
                    <TextBlock Text="{CompiledBinding}" FontSize="{StaticResource FontSize.Small}"
                               Foreground="{DynamicResource Brush.TextMuted}"/>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{CompiledBinding Recording.SegmentNames}" Margin="0,0,0,8">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Border Classes="box" Margin="0,0,6,4" Background="Transparent">
                    <TextBlock Text="{CompiledBinding}" FontSize="{StaticResource FontSize.Small}"
                               Foreground="{DynamicResource Brush.TextMuted}"/>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{CompiledBinding Recording.Fields}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="pvm:RecordingFieldPreview">
                  <StackPanel Orientation="Horizontal" Margin="0,3">
                    <TextBlock Text="{CompiledBinding Name}" MinWidth="72" VerticalAlignment="Center"
                               FontSize="{StaticResource FontSize.Small}" Foreground="{DynamicResource Brush.TextMuted}"/>
                    <Border Classes="box" MinWidth="52">
                      <TextBlock Text="{CompiledBinding Value}" Foreground="{DynamicResource Brush.Text}"/>
                    </Border>
                    <TextBlock Text="{CompiledBinding Unit}" Margin="6,0,0,0" VerticalAlignment="Center"
                               FontSize="{StaticResource FontSize.Small}" Foreground="{DynamicResource Brush.TextMuted}"/>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel IsVisible="{CompiledBinding Recording.Kind, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter={x:Static pvm:RecordingPreviewKind.Abstinence}}">
            <TextBlock Text="{CompiledBinding Recording.Clock}" FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text}"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Spacing="6">
              <Border Classes="box" Padding="10,4">
                <TextBlock Text="{x:Static res:Strings.Abstinence_Start}" Foreground="{DynamicResource Brush.Text}"/>
              </Border>
              <Border Classes="box" Padding="10,4">
                <TextBlock Text="{x:Static res:Strings.Abstinence_Lapse}" Foreground="{DynamicResource Brush.Text}"/>
              </Border>
            </StackPanel>
          </StackPanel>

          <!-- Diario: sagoma statica, mai l'editor Markdown. -->
          <StackPanel IsVisible="{CompiledBinding Recording.Kind, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter={x:Static pvm:RecordingPreviewKind.Diary}}">
            <TextBlock Text="{x:Static res:Strings.HabitBuilder_Preview_DiaryCard}" Margin="0,0,0,8"
                       FontSize="{StaticResource FontSize.Small}" Foreground="{DynamicResource Brush.TextMuted}"/>
            <Border Classes="ghost" Width="150" HorizontalAlignment="Left"/>
            <Border Classes="ghost"/>
            <Border Classes="ghost"/>
            <Border Classes="ghost" Width="90" HorizontalAlignment="Left"/>
          </StackPanel>

          <StackPanel IsVisible="{CompiledBinding Recording.Kind, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter={x:Static pvm:RecordingPreviewKind.QuickNote}}">
            <TextBlock Text="{x:Static res:Strings.HabitBuilder_Preview_QuickNoteCard}" Margin="0,0,0,8"
                       FontSize="{StaticResource FontSize.Small}" Foreground="{DynamicResource Brush.TextMuted}"/>
            <Border Classes="box" Padding="8,20,8,8"/>
          </StackPanel>
        </Panel>
      </Border>

      <TextBlock Text="{x:Static res:Strings.HabitBuilder_Preview_Sample}"
                 FontSize="{StaticResource FontSize.Small}" Foreground="{DynamicResource Brush.TextMuted}"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
