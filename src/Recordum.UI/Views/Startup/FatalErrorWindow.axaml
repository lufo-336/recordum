<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:Recordum.Presentation.Resources"
        x:Class="Recordum.UI.Views.Startup.FatalErrorWindow"
        Title="{x:Static res:Strings.StartupErrorTitle}"
        Width="480" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource Font.Default}"
        Background="{DynamicResource Brush.Background}">
  <StackPanel Margin="24" Spacing="16">
    <!-- Il marchio in serif, come nello sblocco (direzione visiva §5): anche l'errore fatale e' la stessa app. -->
    <TextBlock Name="Brand" Text="{x:Static res:Strings.AppTitle}"
               FontFamily="{DynamicResource Font.Serif}" FontSize="28" FontWeight="SemiBold"
               Foreground="{DynamicResource Brush.Text}"/>
    <TextBlock Text="{x:Static res:Strings.StartupErrorTitle}"
               FontSize="{DynamicResource FontSize.Heading}" FontWeight="SemiBold"
               Foreground="{DynamicResource Brush.Text}"/>
    <TextBlock Name="MessageText" TextWrapping="Wrap"
               Foreground="{DynamicResource Brush.Text}"/>
    <TextBlock Name="LogPathText" TextWrapping="Wrap"
               Foreground="{DynamicResource Brush.TextMuted}"
               FontSize="{DynamicResource FontSize.Small}"/>
    <Button Name="CloseButton" Classes="primary" HorizontalAlignment="Right" Padding="16,8"
            IsDefault="True" Content="{x:Static res:Strings.Window_Close}"/>
  </StackPanel>
</Window>
