<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svm="using:Recordum.Presentation.ViewModels.Startup"
        xmlns:startup="using:Recordum.UI.Views.Startup"
        xmlns:res="using:Recordum.Presentation.Resources"
        x:Class="Recordum.UI.Views.Startup.UnlockWindow"
        x:DataType="svm:UnlockViewModel"
        Title="{x:Static res:Strings.Unlock_Title}"
        Width="420" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource Font.Default}"
        Background="{DynamicResource Brush.Background}">
  <startup:UnlockView Name="View"/>
</Window>
