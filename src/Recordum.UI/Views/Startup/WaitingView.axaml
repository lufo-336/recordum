<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Recordum.Presentation.Resources"
             x:Class="Recordum.UI.Views.Startup.WaitingView"
             FontFamily="{DynamicResource Font.Default}"
             Background="{DynamicResource Brush.Background}">
  <StackPanel Margin="24" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
    <TextBlock Name="Brand"
               Text="{x:Static res:Strings.AppTitle}"
               HorizontalAlignment="Center"
               FontFamily="{DynamicResource Font.Serif}"
               FontSize="28"
               FontWeight="SemiBold"
               Foreground="{DynamicResource Brush.Text}"/>
    <TextBlock Name="StatusText"
               HorizontalAlignment="Center"
               TextAlignment="Center"
               TextWrapping="Wrap"
               Foreground="{DynamicResource Brush.TextMuted}"
               FontSize="{DynamicResource FontSize.Small}"/>
  </StackPanel>
</UserControl>
