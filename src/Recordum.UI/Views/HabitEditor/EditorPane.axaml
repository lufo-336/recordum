<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Recordum.Presentation.ViewModels.HabitEditor"
             xmlns:res="using:Recordum.Presentation.Resources"
             xmlns:conv="using:Recordum.UI.Converters"
             xmlns:ctl="using:Recordum.UI.Controls"
             xmlns:local="using:Recordum.UI.Views.HabitEditor"
             x:Class="Recordum.UI.Views.HabitEditor.EditorPane"
             x:DataType="vm:HabitEditorViewModel">
  <!-- Testata sempre visibile (nome, descrizione, tipo, colore, icona), sezioni scorrevoli, stato in fondo FUORI dallo
       scorrimento (A12: l'autosalvataggio si percepisce anche con le sezioni aperte). Il tipo e' un'etichetta: non
       si cambia dopo la creazione (F0-11). Nome e descrizione si scrivono alla perdita del fuoco; misurato (test 6.4):
       se la colonna sparisce col fuoco ancora nella casella, Avalonia consegna comunque il testo in sospeso. -->
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0" Padding="12" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border}">
      <StackPanel Spacing="8">
        <TextBox x:Name="NameBox" Text="{CompiledBinding Name, UpdateSourceTrigger=LostFocus}"
                 FontSize="{DynamicResource FontSize.Heading}" FontWeight="SemiBold"
                 BorderThickness="0" Background="Transparent"/>
        <TextBox x:Name="DescriptionBox" Text="{CompiledBinding Description, UpdateSourceTrigger=LostFocus}"
                 PlaceholderText="{x:Static res:Strings.Editor_DescriptionPlaceholder}"
                 AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Border Padding="8,3" VerticalAlignment="Center" CornerRadius="4" Background="{DynamicResource Brush.SurfaceElevated}">
            <TextBlock x:Name="TypeLabel" FontSize="{DynamicResource FontSize.Small}" Foreground="{DynamicResource Brush.TextMuted}"/>
          </Border>
          <ctl:ColorSwatchPicker x:Name="ColorPicker" Color="{CompiledBinding Color, Mode=TwoWay}"
                                 RecentColors="{CompiledBinding RecentColors}"
                                 FavoriteColors="{CompiledBinding FavoriteColors}"
                                 AddFavoriteCommand="{CompiledBinding AddFavoriteCommand}"
                                 RemoveFavoriteCommand="{CompiledBinding RemoveFavoriteCommand}"/>
          <ctl:IconPicker x:Name="IconPickerControl" Icon="{CompiledBinding Icon, Mode=TwoWay}"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" x:Name="SectionsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="SectionsStack" Margin="12">
        <ItemsControl x:Name="SectionsHost" ItemsSource="{CompiledBinding Sections}">
          <ItemsControl.ItemTemplate>
            <local:SectionTemplate/>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Padding="12,8" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Border}">
      <TextBlock x:Name="StatusText" Text="{CompiledBinding StatusText}" MinHeight="16"
                 FontSize="{DynamicResource FontSize.Small}" Foreground="{DynamicResource Brush.TextMuted}"/>
    </Border>
  </Grid>
</UserControl>
