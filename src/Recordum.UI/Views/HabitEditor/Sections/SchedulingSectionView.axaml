<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Recordum.Presentation.Resources"
             xmlns:vm="using:Recordum.Presentation.ViewModels.HabitEditor.Sections"
             xmlns:core="using:Recordum.Core.Enums"
             xmlns:conv="using:Recordum.UI.Converters"
             xmlns:s="using:Recordum.UI.Views.HabitEditor.Sections"
             x:Class="Recordum.UI.Views.HabitEditor.Sections.SchedulingSectionView"
             x:DataType="vm:SchedulingSectionViewModel">
  <StackPanel Spacing="4">
    <TextBlock Text="{x:Static res:Strings.Editor_Field_ScheduleType}" Foreground="{DynamicResource Brush.TextMuted}"/>
    <ComboBox x:Name="ScheduleTypeBox" ItemsSource="{x:Static s:SchedulingSectionView.ScheduleTypes}"
              SelectedItem="{CompiledBinding ScheduleType, Mode=TwoWay}" HorizontalAlignment="Stretch">
      <ComboBox.ItemTemplate>
        <DataTemplate x:DataType="core:ScheduleType">
          <TextBlock Text="{CompiledBinding, Converter={x:Static s:SchedulingSectionView.ScheduleLabel}}"/>
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>

    <StackPanel Spacing="4" IsVisible="{CompiledBinding ScheduleType, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter={x:Static core:ScheduleType.SpecificDays}}">
      <TextBlock Text="{x:Static res:Strings.Editor_Field_Days}" Foreground="{DynamicResource Brush.TextMuted}"/>
      <ItemsControl x:Name="DaysList" ItemsSource="{CompiledBinding DayOptions}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:DayToggleViewModel">
            <ToggleButton Classes="pill" Content="{CompiledBinding Label}" IsChecked="{CompiledBinding IsSelected, Mode=TwoWay}"
                          Margin="0,0,4,4" MinWidth="40"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <StackPanel Spacing="4" IsVisible="{CompiledBinding ScheduleType, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter={x:Static core:ScheduleType.WeeklyX}}">
      <TextBlock Text="{x:Static res:Strings.Editor_Field_TimesPerWeek}" Foreground="{DynamicResource Brush.TextMuted}"/>
      <TextBox x:Name="WeeklyTargetBox" HorizontalAlignment="Left" MinWidth="120"
               Text="{CompiledBinding ScheduleWeeklyTarget, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
    </StackPanel>

    <StackPanel Spacing="4" IsVisible="{CompiledBinding ScheduleType, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter={x:Static core:ScheduleType.EveryXDays}}">
      <TextBlock Text="{x:Static res:Strings.Editor_Field_EveryXDays}" Foreground="{DynamicResource Brush.TextMuted}"/>
      <TextBox x:Name="EveryXDaysBox" HorizontalAlignment="Left" MinWidth="120"
               Text="{CompiledBinding ScheduleEveryXDays, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
    </StackPanel>
  </StackPanel>
</UserControl>
