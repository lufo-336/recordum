<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Recordum.Presentation.Resources"
             xmlns:vm="using:Recordum.Presentation.ViewModels.HabitEditor.Sections"
             x:Class="Recordum.UI.Views.HabitEditor.Sections.StreakAdvancedView"
             x:DataType="vm:StreakSectionViewModel">
  <!-- La parte "Avanzate" della serie (spec 6.4, blocco 5): uscita da StreakSectionView. -->
  <StackPanel Spacing="4">
    <TextBlock Text="{x:Static res:Strings.Editor_Field_ToleranceMinutes}" Foreground="{DynamicResource Brush.TextMuted}"/>
    <TextBox x:Name="ToleranceBox" HorizontalAlignment="Left" MinWidth="120"
             Text="{CompiledBinding StreakToleranceMinutes, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
  </StackPanel>
</UserControl>
