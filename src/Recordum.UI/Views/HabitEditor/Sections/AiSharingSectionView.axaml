<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Recordum.Presentation.Resources"
             xmlns:vm="using:Recordum.Presentation.ViewModels.HabitEditor.Sections"
             xmlns:core="using:Recordum.Core.Enums"
             xmlns:m="using:Recordum.Core.Models"
             xmlns:s="using:Recordum.UI.Views.HabitEditor.Sections"
             xmlns:ctl="using:Recordum.UI.Controls"
             x:Class="Recordum.UI.Views.HabitEditor.Sections.AiSharingSectionView"
             x:DataType="vm:AiSharingSectionViewModel">
  <StackPanel Spacing="4">
    <TextBlock Text="{x:Static res:Strings.Editor_Field_AiDataSharing}" Foreground="{DynamicResource Brush.TextMuted}"/>
    <ComboBox x:Name="AiBox" HorizontalAlignment="Stretch" ItemsSource="{x:Static s:AiSharingSectionView.Levels}"
              SelectedItem="{CompiledBinding AiDataSharing, Mode=TwoWay}">
      <ComboBox.ItemTemplate>
        <DataTemplate x:DataType="core:AiDataSharing">
          <TextBlock Text="{CompiledBinding, Converter={x:Static s:AiSharingSectionView.LevelLabel}}" TextWrapping="Wrap"/>
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>
  </StackPanel>
</UserControl>
