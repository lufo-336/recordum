<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Recordum.Presentation.Resources"
             xmlns:vm="using:Recordum.Presentation.ViewModels.HabitEditor.Sections"
             x:Class="Recordum.UI.Views.HabitEditor.Sections.ResetTimeSectionView"
             x:DataType="vm:ResetTimeSectionViewModel">
  <StackPanel Spacing="4">
    <TextBlock Text="{x:Static res:Strings.Editor_Field_ResetTime}" Foreground="{DynamicResource Brush.TextMuted}"/>
    <TextBox x:Name="ResetTimeBox" Text="{CompiledBinding ResetTimeText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
             Width="80" HorizontalAlignment="Left"/>
    <!-- Decisione 8: reset_time non e' versionato (CLAUDE.md §5), cambiarlo reinterpreta lo storico. -->
    <TextBlock x:Name="ResetWarning" Text="{x:Static res:Strings.Editor_ResetTime_Warning}" TextWrapping="Wrap"
               FontSize="{DynamicResource FontSize.Small}" Foreground="{DynamicResource Brush.TextMuted}"/>
  </StackPanel>
</UserControl>
