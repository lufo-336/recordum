<v:RecordumWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:Recordum.UI.Views"
        xmlns:vm="using:Recordum.Presentation.ViewModels.Backup"
        xmlns:res="using:Recordum.Presentation.Resources"
        x:Class="Recordum.UI.Views.Backup.BackupDialog"
        x:DataType="vm:BackupDialogViewModel"
        Title="{x:Static res:Strings.Backup_Create_Title}"
        Width="520" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <!-- Gemella di BackupDialog.xaml (WPF). Le passphrase sono TextBox con PasswordChar: restano nel ViewModel, mai in un log. -->
  <StackPanel Margin="16" Spacing="6">
    <TextBlock Text="{x:Static res:Strings.Backup_Create_Path}"/>
    <DockPanel>
      <Button Name="BrowseButton" DockPanel.Dock="Right" Content="…" Width="32" Margin="6,0,0,0"
              Command="{CompiledBinding BrowseCommand}"
              AutomationProperties.Name="{x:Static res:Strings.Backup_Create_Path}"
              ToolTip.Tip="{x:Static res:Strings.Backup_Create_Path}"/>
      <TextBox Name="DestinationBox" Text="{CompiledBinding Destination, Mode=TwoWay}"
               AutomationProperties.Name="{x:Static res:Strings.Backup_Create_Path}"/>
    </DockPanel>
    <TextBlock Text="{x:Static res:Strings.Backup_Create_Passphrase}" Margin="0,8,0,0"/>
    <TextBox Name="PassphraseBox" PasswordChar="●" Text="{CompiledBinding Passphrase, Mode=TwoWay}"
             AutomationProperties.Name="{x:Static res:Strings.Backup_Create_Passphrase}"/>
    <TextBlock Text="{x:Static res:Strings.Backup_Create_Confirm}"/>
    <TextBox Name="ConfirmBox" PasswordChar="●" Text="{CompiledBinding ConfirmPassphrase, Mode=TwoWay}"
             AutomationProperties.Name="{x:Static res:Strings.Backup_Create_Confirm}"/>
    <TextBlock Text="{CompiledBinding StrengthLabel}" Foreground="{DynamicResource Brush.TextMuted}"/>
    <TextBlock Name="ErrorText" Text="{CompiledBinding ErrorMessage}" TextWrapping="Wrap"
               Foreground="{DynamicResource Brush.Danger}"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button Name="CancelButton" Content="{x:Static res:Strings.Backup_Create_Cancel}" MinWidth="96" Click="OnCancel"/>
      <Button Name="RunButton" Classes="primary" Content="{x:Static res:Strings.Backup_Create_Run}" MinWidth="96"
              Command="{CompiledBinding RunCommand}" IsDefault="True"/>
    </StackPanel>
  </StackPanel>
</v:RecordumWindow>
