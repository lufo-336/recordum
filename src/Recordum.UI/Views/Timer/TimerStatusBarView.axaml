<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Recordum.UI.Converters"
             xmlns:vm="using:Recordum.Presentation.ViewModels.Timer"
             xmlns:res="using:Recordum.Presentation.Resources"
             x:Class="Recordum.UI.Views.Timer.TimerStatusBarView"
             x:DataType="vm:TimerStatusBarViewModel">

  <UserControl.Resources>
    <conv:HabitTextBrushConverter x:Key="HabitText"/>
  </UserControl.Resources>

  <!-- Barra di stato dei timer: compare solo mentre ci sono righe; il battito sta nel ViewModel. -->
  <Border x:Name="Bar" IsVisible="{CompiledBinding IsVisible}"
          BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Border}"
          Background="{DynamicResource Brush.Surface}">
    <ItemsControl ItemsSource="{CompiledBinding Rows}" Margin="10,3">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:ActiveTimerRowViewModel">
          <!-- La riga è tinta nel colore dell'abitudine che corre (§5): il livello di tinta come nelle righe della Home. -->
          <Border Margin="0,0,8,0" CornerRadius="6" BorderThickness="1" ClipToBounds="True"
                  BorderBrush="{DynamicResource Brush.Border}"
                  Background="{DynamicResource Brush.Pane}">
            <Panel>
            <Border x:Name="RowTint" IsHitTestVisible="False" Opacity="{DynamicResource Opacity.TimerTint}"
                    Background="{CompiledBinding ColorHex, Converter={x:Static conv:HexToBrushConverter.Instance}}"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,3">
              <TextBlock x:Name="RowName" Text="{CompiledBinding HabitName}" FontWeight="SemiBold"
                         FontSize="{StaticResource FontSize.Small}" Margin="0,0,6,0" VerticalAlignment="Center"/>
              <!-- Il tempo e' la cifra della barra: 15/600 nella variante "testo" del colore dell'abitudine (non 13). -->
              <TextBlock x:Name="RowElapsed" Text="{CompiledBinding ElapsedDisplay}" FontWeight="SemiBold"
                         FontFamily="{DynamicResource Font.Default}" FontFeatures="+tnum" FontSize="15"
                         Margin="0,0,6,0" VerticalAlignment="Center">
                <TextBlock.Foreground>
                  <MultiBinding Converter="{StaticResource HabitText}">
                    <Binding Path="ColorHex"/>
                    <Binding Path="ActualThemeVariant" RelativeSource="{RelativeSource Self}"/>
                  </MultiBinding>
                </TextBlock.Foreground>
              </TextBlock>
              <Button x:Name="RowPause" Width="22" Height="22" Padding="0" Background="Transparent" BorderThickness="0"
                      Command="{CompiledBinding PauseCommand}" IsVisible="{CompiledBinding !IsPaused}"
                      ToolTip.Tip="{x:Static res:Strings.HabitScreen_Timer_Pause}"
                      AutomationProperties.Name="{x:Static res:Strings.HabitScreen_Timer_Pause}">
                <Path Width="12" Height="12" Stretch="Uniform" Stroke="{DynamicResource Brush.Text}" StrokeThickness="1.6"
                      StrokeLineCap="Round" StrokeJoin="Round" Data="{StaticResource Icon.Pause}"/>
              </Button>
              <Button x:Name="RowResume" Width="22" Height="22" Padding="0" Background="Transparent" BorderThickness="0"
                      Command="{CompiledBinding ResumeCommand}" IsVisible="{CompiledBinding IsPaused}"
                      ToolTip.Tip="{x:Static res:Strings.HabitScreen_Timer_Resume}"
                      AutomationProperties.Name="{x:Static res:Strings.HabitScreen_Timer_Resume}">
                <Path Width="12" Height="12" Stretch="Uniform" Stroke="{DynamicResource Brush.Text}" StrokeThickness="1.6"
                      StrokeLineCap="Round" StrokeJoin="Round" Data="{StaticResource Icon.Play}"/>
              </Button>
              <Button x:Name="RowStop" Width="22" Height="22" Padding="0" Background="Transparent" BorderThickness="0"
                      Command="{CompiledBinding StopCommand}"
                      ToolTip.Tip="{x:Static res:Strings.HabitScreen_Timer_Stop}"
                      AutomationProperties.Name="{x:Static res:Strings.HabitScreen_Timer_Stop}">
                <Path Width="12" Height="12" Stretch="Uniform" Stroke="{DynamicResource Brush.Text}" StrokeThickness="1.6"
                      StrokeLineCap="Round" StrokeJoin="Round" Data="{StaticResource Icon.Square}"/>
              </Button>
            </StackPanel>
            </Panel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Border>
</UserControl>
