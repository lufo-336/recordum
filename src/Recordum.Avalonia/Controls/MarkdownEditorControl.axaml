<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ae="using:AvaloniaEdit"
             xmlns:md="using:Markdown.Avalonia"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="360"
             x:Class="Recordum.Avalonia.Controls.MarkdownEditorControl">

  <!--
  Sonda editor (branch avalonia-linux-slice, NON una feature): sostituto nativo del
  MarkdownEditorControl WPF (WebView2 + Toast UI Editor vendorizzato). Vedi il report
  docs/design/2026-09-09-avalonia-editor-probe.md per il perché delle scelte qui sotto.

  Layout: split fisso sorgente|anteprima (non un toggle Write/Preview a tab come faceva Toast UI
  in modalità Markdown). Motivazione in una riga: un probe deve dimostrare che ENTRAMBE le metà
  funzionano nello stesso frame — un toggle nasconderebbe metà del lavoro dietro uno stato che un
  test headless dovrebbe simulare a mano, per un guadagno di spazio che qui non serve (il probe
  non ha vincoli di larghezza reali). Il layout finale (split fisso vs toggle vs resize
  utente) è una decisione di prodotto per l'implementazione vera, non per questa sonda.

  Niente WYSIWYG: AvaloniaEdit è un editor di TESTO (evidenzia la sintassi markdown, non la
  rende), Markdown.Avalonia RENDERIZZA ma non è editabile. Il documento non è mai un unico
  oggetto "rendered ed editabile insieme" come lo era ProseMirror dentro Toast UI — è la perdita
  di modello più grande del probe, discussa nel report.
  -->

  <Grid ColumnDefinitions="*,Auto,*">

    <!-- Sorgente: editing markdown grezzo con syntax highlighting. -->
    <Border Grid.Column="0"
            Background="{DynamicResource Brush.Surface}">
      <Grid RowDefinitions="Auto,*">
        <TextBlock Grid.Row="0" Text="Markdown" Margin="10,6"
                   FontSize="{DynamicResource FontSize.Small}"
                   Foreground="{DynamicResource Brush.TextMuted}"/>
        <ae:TextEditor x:Name="Editor" Grid.Row="1"
                       ShowLineNumbers="False"
                       WordWrap="True"
                       FontFamily="{DynamicResource Font.Default}"
                       FontSize="{DynamicResource FontSize.Body}"
                       Background="{DynamicResource Brush.Surface}"
                       Foreground="{DynamicResource Brush.Text}"/>
        <!-- Placeholder: AvaloniaEdit non ha un Placeholder nativo (a differenza di TextBox.Watermark
             in Avalonia stock) — TextBlock sovrapposto, nascosto non appena il documento non è vuoto.
             Vedi PlaceholderProperty nel code-behind. -->
        <TextBlock x:Name="PlaceholderText" Grid.Row="1"
                   Margin="6,4" IsHitTestVisible="False"
                   FontFamily="{DynamicResource Font.Default}"
                   FontSize="{DynamicResource FontSize.Body}"
                   Foreground="{DynamicResource Brush.TextMuted}"/>
      </Grid>
    </Border>

    <Border Grid.Column="1" Width="1" Background="{DynamicResource Brush.Border}"/>

    <!-- Anteprima: resa statica del markdown corrente, sola lettura per costruzione (Markdown.Avalonia
         non è un editor). -->
    <Border Grid.Column="2"
            Background="{DynamicResource Brush.Surface}">
      <Grid RowDefinitions="Auto,*">
        <TextBlock Grid.Row="0" Text="Preview" Margin="10,6"
                   FontSize="{DynamicResource FontSize.Small}"
                   Foreground="{DynamicResource Brush.TextMuted}"/>
        <md:MarkdownScrollViewer x:Name="Preview" Grid.Row="1"/>
      </Grid>
    </Border>

  </Grid>

</UserControl>
