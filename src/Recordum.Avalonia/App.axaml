<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Recordum.Avalonia.App"
             RequestedThemeVariant="Default">
  <!-- Themes/Tokens.axaml (branch avalonia-linux-slice, sonda styling): merge a livello Application
       così ThemeProbeView (e qualunque altra view futura) risolve le chiavi Brush.*/Font.*/Layout.*
       con DynamicResource, e la variante Light/Dark segue Window.RequestedThemeVariant senza bisogno
       di un ThemeService che scambia dizionari come in WPF. Non collega nessuna view alla finestra
       reale: MainWindow resta quella dello scaffold. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Themes/Tokens.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="/Themes/RecordumStyles.axaml"/>
  </Application.Styles>
</Application>
