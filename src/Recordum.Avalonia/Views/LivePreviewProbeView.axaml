<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ctrl="using:Recordum.Avalonia.Controls"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="420"
             x:Class="Recordum.Avalonia.Views.LivePreviewProbeView"
             Background="{DynamicResource Brush.Background}"
             FontFamily="{DynamicResource Font.Default}"
             FontSize="{DynamicResource FontSize.Body}">

  <!--
  Sonda Live Preview (branch avalonia-linux-slice, NON una feature): renderizza
  Controls/LivePreviewEditorControl.axaml con un documento che ha titolo + grassetto + corsivo
  + paragrafi piani, e col caret piazzato a mano (MoveCaretTo, code-behind) sulla riga
  formattata — deliverable #2 del probe: un solo frame mostra ENTRAMBI i comportamenti (la riga
  del caret grezza, le altre rese). NON è una vista di produzione: nessun'altra parte dell'app
  la referenzia (stesso principio isolante di MarkdownEditorProbeView).
  -->

  <Grid RowDefinitions="Auto,*" Margin="16">
    <TextBlock Grid.Row="0" Text="LivePreviewEditorControl — riga del caret grezza, resto reso"
               FontSize="{DynamicResource FontSize.Heading}" FontWeight="SemiBold"
               Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,10"/>
    <Border Grid.Row="1"
            Background="{DynamicResource Brush.SurfaceElevated}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1" CornerRadius="6">
      <ctrl:LivePreviewEditorControl x:Name="Editor"/>
    </Border>
  </Grid>

</UserControl>
