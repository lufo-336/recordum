<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="360"
             x:Class="Recordum.Avalonia.Views.HeatmapStripProbeView"
             Background="{DynamicResource Brush.Background}"
             FontFamily="{DynamicResource Font.Default}"
             FontSize="{DynamicResource FontSize.Body}">

  <!--
  Sonda controlli (branch avalonia-linux-slice, NON una feature): renderizza le cinque forme di
  Controls/HeatmapStrip.axaml (Action/Counter/Resistance/Journal/State) una sotto l'altra, con
  valori realistici (non tutti uguali — vedi il code-behind). Ogni riga è Border+Grid colorati
  SOLO dai token di Themes/Tokens.axaml (stessa composizione "riga habit" di ThemeProbeView);
  lo slot destro (ContentControl nominato) riceve la HeatmapStrip vera dal code-behind, perché
  Fractions è un ImmutableArray&lt;double&gt; senza sintassi letterale in XAML — non è una scelta
  di binding, è l'unico modo di passare quei dati al controllo.
  -->

  <StackPanel Margin="24" Spacing="12">

    <TextBlock Text="HeatmapStrip — le cinque forme per-tipo" FontSize="{DynamicResource FontSize.Heading}"
               FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}"/>

    <Border Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1" CornerRadius="6" Padding="12,10">
      <Grid ColumnDefinitions="100,*">
        <TextBlock Grid.Column="0" Text="Action" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text}"/>
        <ContentControl x:Name="ActionSlot" Grid.Column="1" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <Border Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1" CornerRadius="6" Padding="12,10">
      <Grid ColumnDefinitions="100,*">
        <TextBlock Grid.Column="0" Text="Counter" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text}"/>
        <ContentControl x:Name="CounterSlot" Grid.Column="1" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <Border Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1" CornerRadius="6" Padding="12,10">
      <Grid ColumnDefinitions="100,*">
        <TextBlock Grid.Column="0" Text="Resistance" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text}"/>
        <ContentControl x:Name="ResistanceSlot" Grid.Column="1" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <Border Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1" CornerRadius="6" Padding="12,10">
      <Grid ColumnDefinitions="100,*">
        <TextBlock Grid.Column="0" Text="Journal" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text}"/>
        <ContentControl x:Name="JournalSlot" Grid.Column="1" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <Border Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1" CornerRadius="6" Padding="12,10">
      <Grid ColumnDefinitions="100,*">
        <TextBlock Grid.Column="0" Text="State" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text}"/>
        <ContentControl x:Name="StateSlot" Grid.Column="1" VerticalAlignment="Center"/>
      </Grid>
    </Border>

  </StackPanel>

</UserControl>
