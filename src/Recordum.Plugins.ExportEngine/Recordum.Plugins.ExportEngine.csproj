<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- NU1701: SkiaSharp native asset packages may only declare older TFMs; functional on .NET 10. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Recordum.Core\Recordum.Core.csproj" />
    <ProjectReference Include="..\Recordum.Plugins.Contracts\Recordum.Plugins.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QuestPDF" Version="2026.5.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
  </ItemGroup>

  <!-- Il nativo di SkiaSharp arriva con un pacchetto per RID. Su Windows lo porta SkiaSharp stesso;
       su Linux e macOS va chiesto, o l'assembly managed si carica e poi esplode al primo tipo
       (System.DllNotFoundException: libSkiaSharp). Condizionato all'OS che builda, così il grafo di
       pacchetti di Windows — la macchina di sviluppo primaria e il target di spedizione — non cambia. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="3.119.4" />
  </ItemGroup>

</Project>
