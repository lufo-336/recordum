<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:Double x:Key="FontSize.Body">14</sys:Double>
    <sys:Double x:Key="FontSize.Small">12</sys:Double>
    <sys:Double x:Key="FontSize.Heading">15</sys:Double>

    <!-- UI fonts. Font.Default is the active one: set at startup by AppFontService (AppSetting
         ui.font) to one of the two below and re-set live when the user switches. Window/Page
         (BaseStyles) reference it via DynamicResource, so it inherits app-wide; the journal editor
         follows it via the WebView2 push. Monospace spots keep their local FontFamily="Consolas". -->
    <FontFamily x:Key="Font.System">Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Serif">Palatino Linotype, Book Antiqua, Georgia</FontFamily>
    <FontFamily x:Key="Font.Default">Palatino Linotype, Book Antiqua, Georgia</FontFamily>
    <sys:Double x:Key="Layout.RowHeight">36</sys:Double>
    <sys:Double x:Key="Layout.AccentBarWidth">4</sys:Double>
    <sys:Double x:Key="Layout.IndentPerLevel">24</sys:Double>
    <sys:Double x:Key="Layout.HeatmapCell">10</sys:Double>
    <sys:Double x:Key="Layout.HeatmapGap">2</sys:Double>
</ResourceDictionary>