<Application x:Class="Recordum.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Recordum.WPF.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Tokens.xaml"/>
                <ResourceDictionary Source="Resources/Light.xaml"/>
                <ResourceDictionary Source="Resources/Icons.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:HexToBrushConverter x:Key="HexToBrush"/>
            <conv:HabitTypeLabelConverter x:Key="HabitTypeLabel"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisible"/>
            <conv:BoolToHiddenConverter x:Key="BoolToHidden"/>
            <conv:EnumToBoolConverter x:Key="EnumToBool"/>
            <conv:StateToVisibleConverter x:Key="StateToVisible"/>
            <conv:ActiveTabVisibleConverter x:Key="ActiveTabVisible"/>
            <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>
            <conv:EnumToVisibilityConverter x:Key="EnumToVisibility"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
