<Application x:Class="Recordum.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Recordum.WPF.Converters"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:enums="clr-namespace:Recordum.Core.Enums;assembly=Recordum.Core">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Tokens.xaml"/>
                <ResourceDictionary Source="Resources/Light.xaml"/>
                <ResourceDictionary Source="Resources/Icons.xaml"/>
                <ResourceDictionary Source="Resources/BaseStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:HexToBrushConverter x:Key="HexToBrush"/>
            <conv:HabitTypeLabelConverter x:Key="HabitTypeLabel"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisible"/>
            <conv:InvBoolToVisibilityConverter x:Key="InvBoolToVisible"/>
            <conv:BoolToHiddenConverter x:Key="BoolToHidden"/>
            <conv:EnumToBoolConverter x:Key="EnumToBool"/>
            <conv:InverseBooleanConverter x:Key="InverseBool"/>
            <conv:StateToVisibleConverter x:Key="StateToVisible"/>
            <conv:ActiveTabVisibleConverter x:Key="ActiveTabVisible"/>
            <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>
            <conv:ZeroToVisibilityConverter x:Key="ZeroToVisible"/>
            <conv:EnumToVisibilityConverter x:Key="EnumToVisibility"/>
            <conv:IntensityStepToBrushConverter x:Key="IntensityStepToBrush"/>
            <conv:HabitColorTintConverter x:Key="HabitColorTint"/>
            <conv:ContrastForegroundConverter x:Key="ContrastForeground"/>
            <conv:RenameArgsConverter x:Key="RenameArgs"/>
            <conv:IconKeyToGeometryConverter x:Key="IconKeyToGeometry"/>
            <conv:HabitTintBrushConverter x:Key="HabitTint"/>
            <conv:HexToColorConverter x:Key="HexToColor"/>

            <!-- Enum value sources for editor-section ComboBoxes. Global so section
                 views (instantiated via DataTemplate, not yet in the visual tree)
                 can resolve them with StaticResource. -->
            <ObjectDataProvider x:Key="ScheduleTypeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters><x:Type TypeName="enums:ScheduleType"/></ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
            <ObjectDataProvider x:Key="StreakModeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters><x:Type TypeName="enums:StreakMode"/></ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
            <ObjectDataProvider x:Key="StreakRecoveryValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters><x:Type TypeName="enums:StreakRecovery"/></ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
            <ObjectDataProvider x:Key="MetricTypeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters><x:Type TypeName="enums:MetricType"/></ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
            <ObjectDataProvider x:Key="TimerModeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters><x:Type TypeName="enums:TimerMode"/></ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
            <ObjectDataProvider x:Key="GoalPeriodTypeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters><x:Type TypeName="enums:GoalPeriodType"/></ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
            <ObjectDataProvider x:Key="NotifyTypeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters><x:Type TypeName="enums:NotifyType"/></ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
            <ObjectDataProvider x:Key="AiDataSharingValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters><x:Type TypeName="enums:AiDataSharing"/></ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <!-- Tinted habit-row block: resting = ~10% of the habit color, selected = ~20% + inner border. -->
            <Style x:Key="Recordum.HabitBlock" TargetType="Border">
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Margin" Value="0,1"/>
                <Setter Property="ClipToBounds" Value="True"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="{Binding ColorHex, Converter={StaticResource HabitTint}, ConverterParameter=26}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="Background" Value="{Binding ColorHex, Converter={StaticResource HabitTint}, ConverterParameter=51}"/>
                        <Setter Property="BorderBrush" Value="{Binding ColorHex, Converter={StaticResource HexToBrush}}"/>
                        <Setter Property="BorderThickness" Value="1.5"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
