<UserControl x:Class="Recordum.WPF.Views.EditorPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Recordum.WPF.ViewModels.HabitEditor"
             xmlns:v="clr-namespace:Recordum.WPF.Views"
             xmlns:enums="clr-namespace:Recordum.Core.Enums;assembly=Recordum.Core"
             xmlns:res="clr-namespace:Recordum.WPF.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:HabitEditorViewModel, IsDesignTimeCreatable=False}"
             Background="{DynamicResource Brush.Surface}"
             MinWidth="360">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="HabitEditor/Sections/SectionTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- L1 header -->
        <Border Grid.Row="0" Padding="12"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource Brush.Border}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                             FontSize="{StaticResource FontSize.Heading}"
                             FontWeight="SemiBold"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{DynamicResource Brush.Text}"/>
                    <Button Grid.Column="1"
                            x:Name="CloseButton"
                            Content="✕"
                            Width="28" Height="28"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTip="{x:Static res:Strings.Editor_Close}"
                            Click="OnCloseClick"/>
                </Grid>
                <TextBox Margin="0,8,0,0"
                         Text="{Binding Description, UpdateSourceTrigger=LostFocus}"
                         FontSize="{StaticResource FontSize.Body}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="{DynamicResource Brush.Text}"
                         Tag="{x:Static res:Strings.Editor_DescriptionPlaceholder}"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <ComboBox Width="100"
                              ItemsSource="{Binding AvailableNodeTypes}"
                              SelectedItem="{Binding SelectedNodeType}"/>
                    <ComboBox Width="120" Margin="8,0,0,0"
                              ItemsSource="{Binding AvailableHabitTypes}"
                              SelectedItem="{Binding SelectedHabitType}"
                              Visibility="{Binding SelectedNodeType,
                                           Converter={StaticResource EnumToVisibility},
                                           ConverterParameter={x:Static enums:NodeType.Habit}}"/>
                    <v:ColorSwatchPicker Margin="8,0,0,0"
                                         Color="{Binding Color, Mode=TwoWay}"
                                         RecentColors="{Binding RecentColors}"/>
                    <v:IconPicker Margin="8,0,0,0"
                                  Icon="{Binding Icon, Mode=TwoWay}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Sections host (Phase D fills this) -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="12">
            <ItemsControl x:Name="SectionsHost" ItemsSource="{Binding Sections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander Header="{Binding Title}"
                                  IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                  Margin="0,0,0,6"
                                  Foreground="{DynamicResource Brush.Text}"
                                  Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisible}}">
                            <ContentControl Content="{Binding}" Margin="8,8,0,0"/>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Status footer -->
        <Border Grid.Row="2" Padding="12,8"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource Brush.Border}">
            <TextBlock x:Name="StatusText"
                       Text="{Binding StatusText, FallbackValue=''}"
                       FontSize="{StaticResource FontSize.Small}"
                       Foreground="{DynamicResource Brush.TextMuted}"/>
        </Border>
    </Grid>
</UserControl>
