<Window x:Class="Recordum.WPF.Views.Backup.BackupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Recordum.WPF.ViewModels.Backup"
        xmlns:res="clr-namespace:Recordum.WPF.Resources"
        Title="{x:Static res:Strings.Backup_Create_Title}"
        Width="520" Height="320" WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource Font.Default}"
        Background="{DynamicResource Brush.Background}"
        Style="{StaticResource Recordum.ChromedWindow}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="{x:Static res:Strings.Backup_Create_Path}" />
        <DockPanel Grid.Row="1" Margin="0,4,0,12">
            <Button Content="…" Width="32" Command="{Binding BrowseCommand}" DockPanel.Dock="Right"/>
            <TextBox Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged}"/>
        </DockPanel>
        <TextBlock Grid.Row="2" Text="{x:Static res:Strings.Backup_Create_Passphrase}" />
        <PasswordBox Grid.Row="3" x:Name="PassBox" Margin="0,4,0,4" PasswordChanged="OnPassChanged"/>
        <PasswordBox Grid.Row="4" x:Name="ConfirmBox" Margin="0,4,0,4" PasswordChanged="OnConfirmChanged"/>
        <TextBlock Grid.Row="5" Margin="0,8,0,0" Foreground="{DynamicResource Brush.Subtle}"
                   Text="{Binding Strength}"/>
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{x:Static res:Strings.Backup_Create_Cancel}" Width="96" Click="OnCancel" Margin="0,0,8,0"/>
            <Button Content="{x:Static res:Strings.Backup_Create_Run}" Width="96"
                    Command="{Binding RunCommand}" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
