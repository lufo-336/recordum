<Window x:Class="Recordum.WPF.Views.Backup.RestoreDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Recordum.WPF.Resources"
        Title="{x:Static res:Strings.Restore_Title}"
        Width="560" Height="440" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0">
            <Button Content="…" Width="32" Command="{Binding BrowseCommand}" DockPanel.Dock="Right"/>
            <TextBox Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}"/>
        </DockPanel>
        <PasswordBox Grid.Row="1" x:Name="PassBox" Margin="0,8,0,8" PasswordChanged="OnPassChanged"/>
        <Button Grid.Row="2" Content="{x:Static res:Strings.Restore_Preview}"
                Command="{Binding PreviewCommand}" HorizontalAlignment="Left" Width="120"/>
        <TextBlock Grid.Row="3" Margin="0,12,0,0"
                   Text="{Binding Manifest.SchemaVersion, StringFormat={}Schema: {0}}"
                   Visibility="{Binding IsPreviewLoaded, Converter={StaticResource BoolToVisible}}"/>
        <ItemsControl Grid.Row="4" ItemsSource="{Binding Warnings}" Margin="0,8,0,0"/>
        <TextBlock Grid.Row="5" Margin="0,12,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.Warning}"
                   Text="{Binding ErrorMessage}"/>
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{x:Static res:Strings.Restore_Cancel}" Width="96" Click="OnCancel" Margin="0,0,8,0"/>
            <Button Content="{x:Static res:Strings.Restore_Run}" Width="96"
                    Command="{Binding RunCommand}"/>
        </StackPanel>
    </Grid>
</Window>
