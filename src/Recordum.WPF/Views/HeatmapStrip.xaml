<UserControl x:Class="Recordum.WPF.Views.HeatmapStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ItemsControl x:Name="Cells">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border Width="{StaticResource Layout.HeatmapCell}"
                        Height="{StaticResource Layout.HeatmapCell}"
                        Margin="0,0,2,0"
                        CornerRadius="2"
                        Background="{Binding Brush}"
                        BorderBrush="{StaticResource Brush.Text}"
                        BorderThickness="{Binding BorderThickness}" />
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
