<UserControl x:Class="Recordum.WPF.Views.ChartsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Recordum.Presentation.ViewModels.Charts;assembly=Recordum.Presentation"
             xmlns:p="clr-namespace:Recordum.Presentation.Resources;assembly=Recordum.Presentation"
             xmlns:v="clr-namespace:Recordum.WPF.Views"
             d:DataContext="{d:DesignInstance vm:ChartsWorkspaceViewModel, IsDesignTimeCreatable=False}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             Background="{DynamicResource Brush.Background}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Master: chart list -->
    <DockPanel Grid.Column="0">
      <DockPanel DockPanel.Dock="Top" Margin="8">
        <Button Content="{x:Static p:Strings.Charts_New}" Command="{Binding NewCommand}" HorizontalAlignment="Left" />
      </DockPanel>
      <Grid>
        <ListBox ItemsSource="{Binding Charts}" SelectedItem="{Binding Selected, Mode=OneWay}"
                 SelectionChanged="OnChartSelectionChanged">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:ChartListItemViewModel}">
              <StackPanel Margin="4">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ChartType}" Opacity="0.6" FontSize="11" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <!-- Empty-state: same centered-muted-text language as EmptyState.xaml, scoped to this list
             (EmptyState itself is Home-specific — bound to ActiveTab/OpenNewHabitCommand — so it can't
             be reused verbatim against ChartsWorkspaceViewModel). -->
        <TextBlock Text="{x:Static p:Strings.Charts_Empty}"
                   Visibility="{Binding Charts.Count, Converter={StaticResource ZeroToVisible}}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextWrapping="Wrap" TextAlignment="Center" Margin="16"
                   IsHitTestVisible="False"
                   Foreground="{DynamicResource Brush.TextMuted}" />
      </Grid>
    </DockPanel>

    <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" />

    <!-- Detail: rendered chart + builder overlay -->
    <Grid Grid.Column="2">
      <ContentControl Content="{Binding RenderedView}"
                      Visibility="{Binding IsBuilderOpen, Converter={StaticResource InvBoolToVisible}}" />
      <ContentControl Content="{Binding Builder}"
                      Visibility="{Binding IsBuilderOpen, Converter={StaticResource BoolToVisible}}">
        <ContentControl.ContentTemplate>
          <DataTemplate DataType="{x:Type vm:ChartBuilderViewModel}">
            <!-- Two-column builder: left = form (name/type/period/series), right = live preview.
                 Both columns floor at 320 so neither collapses to nothing if the workspace is narrow. -->
            <Grid Margin="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="*" MinWidth="320" />
              </Grid.ColumnDefinitions>

              <ScrollViewer Grid.Column="0" Margin="0,0,12,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <TextBlock Text="{x:Static p:Strings.Charts_Builder_Name}" />
                  <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Text="{x:Static p:Strings.Charts_Builder_Type}" Margin="0,8,0,0" />
                  <ComboBox ItemsSource="{Binding AvailableKinds}" SelectedItem="{Binding SelectedKind}" />
                  <TextBlock Text="{x:Static p:Strings.Charts_Builder_Range}" Margin="0,8,0,0" />
                  <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Range}">
                    <ComboBoxItem Tag="30d" Content="{x:Static p:Strings.Charts_Range_30d}" />
                    <ComboBoxItem Tag="90d" Content="{x:Static p:Strings.Charts_Range_90d}" />
                    <ComboBoxItem Tag="1y" Content="{x:Static p:Strings.Charts_Range_1y}" />
                  </ComboBox>
                  <DockPanel Margin="0,8,0,0">
                    <Button Content="{x:Static p:Strings.Charts_Builder_AddSeries}" Command="{Binding AddSeriesCommand}" />
                  </DockPanel>
                  <ItemsControl ItemsSource="{Binding Series}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type vm:ChartSeriesRowViewModel}">
                        <DockPanel Margin="0,4">
                          <!-- Remove: a Lucide-style X icon (cloned from WorkspaceView's tab-close
                               button) instead of a raw ✕ glyph. -->
                          <Button DockPanel.Dock="Right" Margin="6,0,0,0"
                                  Padding="3" Width="20" Height="20"
                                  Background="Transparent" BorderThickness="0"
                                  ToolTip="{x:Static p:Strings.HabitScreen_QuickAdd_RemoveSeries}"
                                  Command="{Binding DataContext.RemoveSeriesCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                  CommandParameter="{Binding}">
                            <Path Width="9" Height="9" Stretch="Uniform"
                                  Stroke="{DynamicResource Brush.TextMuted}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M0,0 L9,9 M9,0 L0,9" />
                          </Button>
                          <v:ColorSwatchPicker DockPanel.Dock="Right" Margin="6,0,0,0" VerticalAlignment="Center"
                                                Color="{Binding Color, Mode=TwoWay}" />
                          <!-- Habit picker: swatch + name per item, placeholder overlay while unselected
                               (ComboBox has no first-class placeholder concept). -->
                          <Grid DockPanel.Dock="Left" Width="130" VerticalAlignment="Center">
                            <ComboBox ItemsSource="{Binding AvailableHabits}" SelectedItem="{Binding SelectedHabit}">
                              <ComboBox.ItemTemplate>
                                <DataTemplate>
                                  <StackPanel Orientation="Horizontal">
                                    <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center"
                                            Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}" />
                                    <TextBlock Text="{Binding Name}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                  </StackPanel>
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{x:Static p:Strings.Charts_Builder_PickHabit}"
                                       IsHitTestVisible="False"
                                       Margin="8,0,26,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextMuted}">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedHabit}" Value="{x:Null}">
                                      <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                          </Grid>
                          <ComboBox DockPanel.Dock="Left" Width="110" Margin="6,0,0,0" VerticalAlignment="Center"
                                    ItemsSource="{Binding Metrics}" SelectedItem="{Binding SelectedMetric}"
                                    DisplayMemberPath="Name" />
                          <!-- Label: auto-filled from habit/metric until the user edits it by hand.
                               GotKeyboardFocus/TextChanged (code-behind) call MarkLabelTouched so the
                               auto-label stops overwriting a hand-typed value; see ChartsView.xaml.cs. -->
                          <TextBox Margin="6,0,0,0" VerticalAlignment="Center"
                                   Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                   GotKeyboardFocus="OnSeriesLabelGotKeyboardFocus"
                                   TextChanged="OnSeriesLabelTextChanged" />
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{Binding ErrorMessage}"
                             Foreground="{DynamicResource Brush.Danger}"
                             Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}"
                             TextWrapping="Wrap" Margin="0,8,0,0" />
                  <Button Content="{x:Static p:Strings.Charts_Builder_Save}" Command="{Binding SaveCommand}" Margin="0,8,0,0" HorizontalAlignment="Right" />
                </StackPanel>
              </ScrollViewer>

              <Grid Grid.Column="1">
                <ContentControl Content="{Binding PreviewView}" />
                <TextBlock Text="{x:Static p:Strings.Charts_Builder_PreviewEmpty}"
                           Visibility="{Binding PreviewEmpty, Converter={StaticResource BoolToVisible}}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}" />
              </Grid>
            </Grid>
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>
    </Grid>
  </Grid>
</UserControl>
