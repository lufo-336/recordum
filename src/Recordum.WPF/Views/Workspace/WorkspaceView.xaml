<UserControl x:Class="Recordum.WPF.Views.Workspace.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wsvm="clr-namespace:Recordum.WPF.ViewModels.Workspace"
             xmlns:hsvm="clr-namespace:Recordum.WPF.ViewModels.HabitScreen"
             xmlns:vhs="clr-namespace:Recordum.WPF.Views.HabitScreen"
             xmlns:res="clr-namespace:Recordum.WPF.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance wsvm:WorkspaceViewModel, IsDesignTimeCreatable=False}"
             Background="{DynamicResource Brush.Surface}">
    <UserControl.Resources>
        <!-- Each tab hosts a full HabitScreen, reused verbatim from the single-screen design. -->
        <DataTemplate DataType="{x:Type hsvm:HabitScreenViewModel}">
            <vhs:HabitScreen/>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- Tab strip: a flat ListBox whose selection IS the active tab. Single-click activates
             (native selection); double-click pins (code-behind). -->
        <ListBox DockPanel.Dock="Top"
                 x:Name="TabStrip"
                 ItemsSource="{Binding Tabs}"
                 SelectedItem="{Binding ActiveSubjectTab, Mode=TwoWay}"
                 MouseDoubleClick="OnTabStripDoubleClick"
                 Background="{DynamicResource Brush.Background}"
                 BorderBrush="{DynamicResource Brush.Border}"
                 BorderThickness="0,0,0,1"
                 Padding="4,2"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,2,0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <!-- Softer tab: rounded top corners on the hover/selected fill; the
                                     2px accent bottom border stays as the active-tab underline. -->
                                <Border x:Name="Chrome"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="0,0,0,2"
                                        CornerRadius="6,6,0,0"
                                        Padding="12,6">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.SurfaceElevated}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Surface}"/>
                                        <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type wsvm:SubjectTabViewModel}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Title}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Text}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPreview}" Value="True">
                                            <Setter Property="FontStyle" Value="Italic"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Margin="8,0,0,0"
                                Padding="2,0"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTip="{x:Static res:Strings.Workspace_PinTab}"
                                Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}">
                            <Path Width="12" Height="12" Stretch="Uniform"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="{StaticResource Icon.Pin}">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <!-- Pinned = solid accent; preview = faint muted outline. -->
                                        <Setter Property="Stroke" Value="{DynamicResource Brush.Accent}"/>
                                        <Setter Property="Opacity" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPreview}" Value="True">
                                                <Setter Property="Stroke" Value="{DynamicResource Brush.TextMuted}"/>
                                                <Setter Property="Opacity" Value="0.45"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>
                        <!-- Close: a Lucide-style X icon (the implicit Button chrome gives the hover
                             tint) instead of a raw ✕ glyph. -->
                        <Button Margin="6,0,0,0"
                                Padding="3"
                                Width="20" Height="20"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTip="{x:Static res:Strings.Workspace_CloseTab}"
                                Command="{Binding DataContext.CloseTabCmdCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}">
                            <Path Width="9" Height="9" Stretch="Uniform"
                                  Stroke="{DynamicResource Brush.TextMuted}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M0,0 L9,9 M9,0 L0,9"/>
                        </Button>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Active content: the selected tab's HabitScreen, or an empty welcome panel. -->
        <Grid>
            <ContentControl Content="{Binding ActiveSubjectTab.Screen}"
                            Visibility="{Binding IsPanoramicaActive, Converter={StaticResource InvBoolToVisible}}"/>
            <!-- Welcome panel: icon + line, same composition as the Home empty state. -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320" Margin="24"
                        Visibility="{Binding IsPanoramicaActive, Converter={StaticResource BoolToVisible}}">
                <Path Width="46" Height="46" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,16"
                      Opacity="0.45" Data="{StaticResource Icon.BookOpen}"
                      Stroke="{DynamicResource Brush.TextMuted}" StrokeThickness="1.4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                <TextBlock Text="{x:Static res:Strings.Workspace_Empty}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.TextMuted}"
                           FontSize="{StaticResource FontSize.Heading}"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
