<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Recordum.WPF.ViewModels"
                    xmlns:v="clr-namespace:Recordum.WPF.Views"
                    xmlns:res="clr-namespace:Recordum.WPF.Resources"
                    xmlns:b="clr-namespace:Recordum.WPF.Behaviors"
                    xmlns:enums="clr-namespace:Recordum.Core.Enums;assembly=Recordum.Core">
    <DataTemplate x:Key="HabitRowTemplate" DataType="{x:Type vm:HomeRowViewModel}">
        <Grid Height="{StaticResource Layout.RowHeight}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Rectangle Grid.Column="0"
                       Width="{StaticResource Layout.AccentBarWidth}"
                       Fill="{Binding ColorHex, Converter={StaticResource HexToBrush}}" />

            <Grid Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- Habit icon (Lucide), tinted with the habit color; collapses when no resolvable icon. -->
                <Path Grid.Column="0" Width="16" Height="16" Margin="0,0,6,0"
                      Stretch="Uniform" VerticalAlignment="Center"
                      Stroke="{Binding ColorHex, Converter={StaticResource HexToBrush}}" StrokeThickness="1.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Data="{Binding Icon, Converter={StaticResource IconKeyToGeometry}}"
                      Visibility="{Binding Data, RelativeSource={RelativeSource Self}, Converter={StaticResource NullToVisibility}}" />
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}"
                               FontSize="{StaticResource FontSize.Body}"
                               Foreground="{DynamicResource Brush.Text}"
                               Visibility="{Binding IsRenaming, Converter={StaticResource BoolToHidden}}" />
                    <TextBox Text="{Binding PendingName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                             FontSize="{StaticResource FontSize.Body}"
                             b:InlineRenameBehavior.Attach="True"
                             Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisible}}" />
                </Grid>
            </Grid>

            <TextBlock Grid.Column="2"
                       Margin="8,0,8,0"
                       VerticalAlignment="Center"
                       FontSize="{StaticResource FontSize.Small}"
                       Opacity="0.5"
                       Foreground="{DynamicResource Brush.TextMuted}"
                       Text="{Binding HabitType, Converter={StaticResource HabitTypeLabel}}" />

            <v:HeatmapStrip Grid.Column="3"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Counts="{Binding CompletionsLast7Days}"
                            AccentColor="{Binding ColorHex}" />

            <Button Grid.Column="4"
                    Margin="0,0,8,0"
                    Width="26" Height="26"
                    Padding="0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTip="{x:Static res:Strings.Home_QuickAction}"
                    Command="{Binding QuickActionCommand}"
                    Visibility="{Binding CanQuickAction, Converter={StaticResource BoolToVisible}}">
                <TextBlock Text="+"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text}"/>
            </Button>

            <Grid.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="{x:Static res:Strings.Home_ContextMenu_Rename}"
                              Command="{Binding BeginRenameCommand}"
                              Visibility="{Binding ShowRenameMenu, Converter={StaticResource BoolToVisible}}" />
                    <MenuItem Header="{x:Static res:Strings.Home_ContextMenu_Pin}"
                              Visibility="{Binding ShowPinMenu, Converter={StaticResource BoolToVisible}}">
                        <MenuItem Header="{x:Static res:Strings.Home_ContextMenu_Pin_None}"
                                  Command="{Binding SetPinScopeCommand}"
                                  CommandParameter="{x:Static enums:PinScope.None}" />
                        <MenuItem Header="{x:Static res:Strings.Home_ContextMenu_Pin_Local}"
                                  Command="{Binding SetPinScopeCommand}"
                                  CommandParameter="{x:Static enums:PinScope.Local}" />
                        <MenuItem Header="{x:Static res:Strings.Home_ContextMenu_Pin_Global}"
                                  Command="{Binding SetPinScopeCommand}"
                                  CommandParameter="{x:Static enums:PinScope.Global}" />
                    </MenuItem>
                    <MenuItem Header="{x:Static res:Strings.Home_ContextMenu_Archive}"
                              Command="{Binding ArchiveCommand}"
                              Visibility="{Binding ShowArchive, Converter={StaticResource BoolToVisible}}" />
                    <MenuItem Header="{x:Static res:Strings.Home_ContextMenu_Unarchive}"
                              Command="{Binding UnarchiveCommand}"
                              Visibility="{Binding ShowUnarchive, Converter={StaticResource BoolToVisible}}" />
                    <MenuItem Header="{x:Static res:Strings.Home_ContextMenu_SoftDelete}"
                              Command="{Binding SoftDeleteCommand}"
                              Visibility="{Binding ShowSoftDelete, Converter={StaticResource BoolToVisible}}" />
                    <MenuItem Header="{x:Static res:Strings.Home_ContextMenu_Restore}"
                              Command="{Binding RestoreCommand}"
                              Visibility="{Binding ShowRestore, Converter={StaticResource BoolToVisible}}" />
                    <MenuItem Header="{x:Static res:Strings.Home_ContextMenu_Purge}"
                              Command="{Binding PurgeCommand}"
                              Visibility="{Binding ShowPurge, Converter={StaticResource BoolToVisible}}" />
                </ContextMenu>
            </Grid.ContextMenu>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
