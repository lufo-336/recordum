<Window x:Class="Recordum.WPF.Views.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vms="clr-namespace:Recordum.WPF.ViewModels.Settings"
        xmlns:vm="clr-namespace:Recordum.WPF.ViewModels"
        xmlns:vmb="clr-namespace:Recordum.WPF.ViewModels.Backup"
        xmlns:vmd="clr-namespace:Recordum.WPF.ViewModels.DiagnosticInfo"
        xmlns:enums="clr-namespace:Recordum.Core.Enums;assembly=Recordum.Core"
        xmlns:res="clr-namespace:Recordum.WPF.Resources"
        Title="{x:Static res:Strings.Settings_Title}"
        Width="760" Height="540" MinWidth="640" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource Font.Default}"
        Background="{DynamicResource Brush.Background}">
    <Window.Resources>
        <!-- Appearance: theme picker (ported from the late SettingsPopup). -->
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.Settings_Theme}" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,8"/>
                <RadioButton GroupName="Theme" Content="{x:Static res:Strings.Settings_Theme_System}" Margin="0,0,0,4"
                             IsChecked="{Binding ThemeMode, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static enums:ThemeMode.System}}"/>
                <RadioButton GroupName="Theme" Content="{x:Static res:Strings.Settings_Theme_Light}" Margin="0,0,0,4"
                             IsChecked="{Binding ThemeMode, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static enums:ThemeMode.Light}}"/>
                <RadioButton GroupName="Theme" Content="{x:Static res:Strings.Settings_Theme_Dark}"
                             IsChecked="{Binding ThemeMode, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static enums:ThemeMode.Dark}}"/>

                <TextBlock Text="{x:Static res:Strings.Settings_Font}" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text}" Margin="0,18,0,8"/>
                <RadioButton GroupName="Font" Content="{x:Static res:Strings.Settings_Font_System}" Margin="0,0,0,4"
                             IsChecked="{Binding AppFont, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static enums:AppFont.System}}"/>
                <RadioButton GroupName="Font" Content="{x:Static res:Strings.Settings_Font_Serif}"
                             IsChecked="{Binding AppFont, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static enums:AppFont.Serif}}"/>
            </StackPanel>
        </DataTemplate>

        <!-- General -->
        <DataTemplate DataType="{x:Type vms:GeneralSettingsViewModel}">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.Settings_General_DailyResetTime}" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text}"/>
                <TextBox Width="72" HorizontalAlignment="Left" Margin="0,4,0,2"
                         Text="{Binding DailyResetTime, UpdateSourceTrigger=LostFocus}">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="BorderBrush" Value="#d04848"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <TextBlock Text="{x:Static res:Strings.Settings_General_DailyResetTime_Hint}"
                           FontSize="{StaticResource FontSize.Small}" TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.TextMuted}"/>
            </StackPanel>
        </DataTemplate>

        <!-- Backup: ported from BackupSettingsDialog. PasswordBoxes can't bind — the PasswordChanged
             handlers (in this window's code-behind) push into the row's BackupSettingsViewModel. -->
        <DataTemplate DataType="{x:Type vmb:BackupSettingsViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="460" HorizontalAlignment="Left">
                    <CheckBox Content="{x:Static res:Strings.Backup_Settings_Enabled}" IsChecked="{Binding IsEnabled}"/>
                    <TextBlock Margin="0,12,0,4" Text="{x:Static res:Strings.Backup_Settings_Frequency}"/>
                    <TextBox Text="{Binding FrequencyDays, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Margin="0,12,0,4" Text="{x:Static res:Strings.Backup_Settings_Retention}"/>
                    <TextBox Text="{Binding RetentionCount, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Margin="0,12,0,4" Text="{x:Static res:Strings.Backup_Settings_Folder}"/>
                    <TextBox Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Margin="0,12,0,4" Text="{x:Static res:Strings.Backup_Create_Passphrase}"/>
                    <PasswordBox PasswordChanged="OnBackupPassphraseChanged"/>
                    <TextBlock Margin="0,8,0,4" Text="{x:Static res:Strings.Backup_Create_Confirm}"/>
                    <PasswordBox PasswordChanged="OnBackupConfirmChanged"/>
                    <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap"
                               Text="{x:Static res:Strings.Backup_Settings_InertWarning}"
                               Visibility="{Binding InertWarning, Converter={StaticResource BoolToVisible}}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="{x:Static res:Strings.Backup_Settings_Test}" Command="{Binding TestCommand}" Margin="0,0,8,0"/>
                        <Button Content="{x:Static res:Strings.Backup_Settings_Save}" Command="{Binding SaveCommand}" IsDefault="True"/>
                    </StackPanel>
                    <TextBlock Margin="0,8,0,0" Text="{Binding TestResultMessage}" Foreground="{DynamicResource Brush.Subtle}"/>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <!-- Diagnostics: ported from DiagnosticInfoDialog (rows + copy button; no Close — the window has its own chrome). -->
        <DataTemplate DataType="{x:Type vmd:DiagnosticInfoViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vmd:DiagnosticRow}">
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding Label, Mode=OneWay}" IsReadOnly="True"
                                             BorderThickness="0" Background="Transparent"
                                             Foreground="{DynamicResource Brush.TextMuted}"
                                             FontFamily="Consolas" FontSize="12" Padding="0" VerticalAlignment="Top"/>
                                    <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True"
                                             BorderThickness="0" Background="Transparent"
                                             Foreground="{DynamicResource Brush.Text}"
                                             FontFamily="Consolas" FontWeight="SemiBold" FontSize="12" Padding="0"
                                             TextWrapping="Wrap" VerticalAlignment="Top"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding CopyToClipboardCommand}" MinWidth="140"
                            Content="{x:Static res:Strings.Diagnostic_Copy}"/>
                    <TextBlock Text="{x:Static res:Strings.Diagnostic_Copied}" Margin="8,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CopyConfirmed}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Coming soon (disabled categories) -->
        <DataTemplate DataType="{x:Type vms:ComingSoonContent}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380">
                <TextBlock Text="{x:Static res:Strings.Settings_ComingSoon}" FontWeight="SemiBold"
                           FontSize="{StaticResource FontSize.Heading}" HorizontalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextMuted}"/>
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" TextAlignment="Center"
                           Margin="0,8,0,0" Foreground="{DynamicResource Brush.TextMuted}"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Category list -->
        <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}"
                BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Border}">
            <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                     Background="Transparent" BorderThickness="0" Margin="6,10">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="IsEnabled" Value="{Binding IsEnabled}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="bd" CornerRadius="4" Padding="10,7" Margin="0,1">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.SurfaceElevated}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.SurfaceElevated}"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.45"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vms:SettingsCategory}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="16" Height="16" Margin="0,0,9,0" Stretch="Uniform"
                                  Stroke="{DynamicResource Brush.Text}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometry}}"/>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Content pane -->
        <Grid Grid.Column="1" Margin="20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{Binding SelectedCategory.Name}"
                       FontSize="{StaticResource FontSize.Heading}" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,14"/>
            <ContentControl Grid.Row="1" Content="{Binding SelectedCategory.Content}"/>
        </Grid>
    </Grid>
</Window>
