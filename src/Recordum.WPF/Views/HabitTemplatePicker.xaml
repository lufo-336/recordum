<Window x:Class="Recordum.WPF.Views.HabitTemplatePicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Recordum.Presentation.ViewModels.HabitEditor;assembly=Recordum.Presentation"
        xmlns:res="clr-namespace:Recordum.Presentation.Resources;assembly=Recordum.Presentation"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:HabitTemplatePickerViewModel, IsDesignTimeCreatable=False}"
        Title="{x:Static res:Strings.HabitTemplatePicker_Title}"
        Width="520" Height="640"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource Font.Default}"
        Background="{DynamicResource Brush.Surface}"
        Style="{StaticResource Recordum.ChromedWindow}">
    <Window.Resources>
        <!-- Shared full-width option button, used by the pinned Actions and the Predefined templates. -->
        <DataTemplate x:Key="OptionButtonTemplate" DataType="{x:Type vm:PickerOption}">
            <Button Margin="0,4"
                    Padding="12,8"
                    HorizontalContentAlignment="Stretch"
                    Background="{DynamicResource Brush.SurfaceElevated}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
                <StackPanel>
                    <TextBlock Text="{Binding Name}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text}"/>
                    <TextBlock Text="{Binding Description}"
                               FontSize="{StaticResource FontSize.Small}"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Button>
        </DataTemplate>
    </Window.Resources>
    <!-- ScrollViewer spans full width so the overlay scrollbar rides the window edge; the content
         keeps a 16px margin, leaving a clear gutter to its right instead of sitting over the tiles. -->
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16">

                <!-- Primary actions: always visible, outside the collapsible sections. -->
                <ItemsControl ItemsSource="{Binding Actions}" ItemTemplate="{StaticResource OptionButtonTemplate}"/>

                <!-- Predefined (official) templates — collapsible, expanded by default. -->
                <Expander IsExpanded="True" Margin="0,10,0,0">
                    <Expander.Header>
                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}">
                            <Run Text="{x:Static res:Strings.HabitTemplatePicker_PredefinedTemplates}"/><Run
                                Text="{Binding OfficialTemplates.Count, StringFormat=' ({0})', Mode=OneWay}"
                                Foreground="{DynamicResource Brush.TextMuted}" FontWeight="Normal"/>
                        </TextBlock>
                    </Expander.Header>
                    <ItemsControl ItemsSource="{Binding OfficialTemplates}"
                                  ItemTemplate="{StaticResource OptionButtonTemplate}"
                                  Margin="0,4,0,0"/>
                </Expander>

                <!-- Your (custom) templates — collapsible, expanded by default; whole section hidden when empty. -->
                <Expander IsExpanded="True" Margin="0,10,0,0">
                    <Expander.Style>
                        <Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CustomOptions.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Expander.Style>
                    <Expander.Header>
                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}">
                            <Run Text="{x:Static res:Strings.HabitTemplatePicker_YourTemplates}"/><Run
                                Text="{Binding CustomOptions.Count, StringFormat=' ({0})', Mode=OneWay}"
                                Foreground="{DynamicResource Brush.TextMuted}" FontWeight="Normal"/>
                        </TextBlock>
                    </Expander.Header>
                    <ItemsControl ItemsSource="{Binding CustomOptions}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PickerOption}">
                                <Border Margin="0,4"
                                        Padding="10,8"
                                        CornerRadius="4"
                                        Background="{DynamicResource Brush.SurfaceElevated}"
                                        BorderBrush="{DynamicResource Brush.Border}"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0"
                                                HorizontalContentAlignment="Stretch"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush.Text}"/>
                                                <TextBlock Text="{Binding Description}"
                                                           FontSize="{StaticResource FontSize.Small}"
                                                           Foreground="{DynamicResource Brush.TextMuted}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Button>

                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    Margin="8,0,0,0">
                                            <TextBox x:Name="RenameBox"
                                                     Width="120"
                                                     Padding="4,2"
                                                     VerticalAlignment="Center"
                                                     Text="{Binding Name, Mode=OneWay}"/>
                                            <Button Content="{x:Static res:Strings.HabitTemplatePicker_Rename}"
                                                    Margin="6,0,0,0"
                                                    Padding="8,3"
                                                    Command="{Binding DataContext.RenameCustomCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <Button.CommandParameter>
                                                    <MultiBinding Converter="{StaticResource RenameArgs}">
                                                        <Binding/>
                                                        <Binding ElementName="RenameBox" Path="Text"/>
                                                    </MultiBinding>
                                                </Button.CommandParameter>
                                            </Button>
                                            <Button Content="{x:Static res:Strings.HabitTemplatePicker_Delete}"
                                                    Margin="6,0,0,0"
                                                    Padding="8,3"
                                                    Command="{Binding DataContext.DeleteCustomCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
