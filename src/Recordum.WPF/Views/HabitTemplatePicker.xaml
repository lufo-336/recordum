<Window x:Class="Recordum.WPF.Views.HabitTemplatePicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Recordum.WPF.ViewModels.HabitEditor"
        xmlns:res="clr-namespace:Recordum.WPF.Resources"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:HabitTemplatePickerViewModel, IsDesignTimeCreatable=False}"
        Title="{x:Static res:Strings.HabitTemplatePicker_Title}"
        Width="520" Height="640"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Surface}">
    <Grid Margin="16">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Options}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="0,4"
                                    Padding="12,8"
                                    HorizontalContentAlignment="Stretch"
                                    Background="{DynamicResource Brush.SurfaceElevated}"
                                    BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="1"
                                    Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Text}"/>
                                    <TextBlock Text="{Binding Description}"
                                               FontSize="{StaticResource FontSize.Small}"
                                               Foreground="{DynamicResource Brush.TextMuted}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Your templates (user-saved, IsOfficial == false) -->
                <StackPanel Margin="0,12,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CustomOptions.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{x:Static res:Strings.HabitTemplatePicker_YourTemplates}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               Margin="2,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding CustomOptions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,4"
                                        Padding="10,8"
                                        CornerRadius="4"
                                        Background="{DynamicResource Brush.SurfaceElevated}"
                                        BorderBrush="{DynamicResource Brush.Border}"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0"
                                                HorizontalContentAlignment="Stretch"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush.Text}"/>
                                                <TextBlock Text="{Binding Description}"
                                                           FontSize="{StaticResource FontSize.Small}"
                                                           Foreground="{DynamicResource Brush.TextMuted}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Button>

                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    Margin="8,0,0,0">
                                            <TextBox x:Name="RenameBox"
                                                     Width="120"
                                                     Padding="4,2"
                                                     VerticalAlignment="Center"
                                                     Text="{Binding Name, Mode=OneWay}"/>
                                            <Button Content="{x:Static res:Strings.HabitTemplatePicker_Rename}"
                                                    Margin="6,0,0,0"
                                                    Padding="8,3"
                                                    Command="{Binding DataContext.RenameCustomCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <Button.CommandParameter>
                                                    <MultiBinding Converter="{StaticResource RenameArgs}">
                                                        <Binding/>
                                                        <Binding ElementName="RenameBox" Path="Text"/>
                                                    </MultiBinding>
                                                </Button.CommandParameter>
                                            </Button>
                                            <Button Content="{x:Static res:Strings.HabitTemplatePicker_Delete}"
                                                    Margin="6,0,0,0"
                                                    Padding="8,3"
                                                    Command="{Binding DataContext.DeleteCustomCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
