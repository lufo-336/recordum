<UserControl x:Class="Recordum.WPF.Views.HabitScreen.NotesTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Recordum.WPF.ViewModels.HabitScreen.Notes"
             xmlns:res="clr-namespace:Recordum.WPF.Resources"
             xmlns:ctrl="clr-namespace:Recordum.WPF.Controls">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <Button DockPanel.Dock="Top"
                    Content="{x:Static res:Strings.Notes_New}"
                    Command="{Binding NewCommand}"
                    Padding="6,4" Margin="6"/>
            <ListBox ItemsSource="{Binding Notes}"
                     SelectedItem="{Binding SelectedNote, Mode=TwoWay}"
                     BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:NoteRowViewModel}">
                        <StackPanel Margin="0,4"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
                            <StackPanel.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{x:Static res:Strings.Notes_History}"
                                              Command="{Binding PlacementTarget.Tag.ShowHistoryCommand,
                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext,
                                                                 RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                </ContextMenu>
                            </StackPanel.ContextMenu>
                            <Border HorizontalAlignment="Left" Margin="0,0,0,2"
                                    Padding="5,1" CornerRadius="3"
                                    Background="{DynamicResource Brush.SurfaceElevated}">
                                <TextBlock Text="{Binding AnchorDateDisplay}"
                                           FontSize="{StaticResource FontSize.Small}"
                                           Foreground="{DynamicResource Brush.TextMuted}"/>
                            </Border>
                            <TextBlock Text="{Binding ModifiedAtDisplay}"
                                       FontSize="{StaticResource FontSize.Small}"
                                       Foreground="{DynamicResource Brush.TextMuted}"
                                       Visibility="{Binding WasModified, Converter={StaticResource BoolToVisible}}"/>
                            <TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="4"
                      HorizontalAlignment="Stretch"
                      Background="{DynamicResource Brush.Border}"/>

        <Grid Grid.Column="2" Margin="8">
            <!-- Editor (normal state) -->
            <Grid Visibility="{Binding IsShowingHistory, Converter={StaticResource InvBoolToVisible}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ctrl:MarkdownEditorControl Grid.Row="0"
                                            Markdown="{Binding EditorMarkdown, Mode=TwoWay}"
                                            Availability="{Binding Availability}"/>

                <DockPanel Grid.Row="1" Margin="0,8,0,0">
                    <Button Content="{x:Static res:Strings.Notes_Save}"
                            Command="{Binding SaveCommand}"
                            Padding="10,4" Margin="0,0,6,0"/>
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsConfirmingDelete, Converter={StaticResource InvBoolToVisible}}">
                        <Button Content="{x:Static res:Strings.Notes_Delete}"
                                Command="{Binding RequestDeleteCommand}"
                                Padding="10,4"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsConfirmingDelete, Converter={StaticResource BoolToVisible}}">
                        <TextBlock Text="{x:Static res:Strings.Notes_ConfirmDelete}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button Content="{x:Static res:Strings.Notes_Confirm}"
                                Command="{Binding ConfirmDeleteCommand}"
                                Padding="10,4" Margin="0,0,4,0"/>
                        <Button Content="{x:Static res:Strings.Notes_Cancel}"
                                Command="{Binding CancelDeleteCommand}"
                                Padding="10,4"/>
                    </StackPanel>
                </DockPanel>
            </Grid>

            <!-- Version history (history state) -->
            <Grid Visibility="{Binding IsShowingHistory, Converter={StaticResource BoolToVisible}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Button Grid.Row="0"
                        Content="{x:Static res:Strings.Notes_History_Back}"
                        Command="{Binding HideHistoryCommand}"
                        HorizontalAlignment="Left" Padding="8,4" Margin="0,0,0,8"/>
                <Grid Grid.Row="1" DataContext="{Binding History}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ListBox Grid.Column="0" BorderThickness="0"
                             ItemsSource="{Binding Versions}"
                             SelectedItem="{Binding SelectedVersion, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NoteVersionRowViewModel}">
                                <StackPanel Margin="0,4">
                                    <TextBlock Text="{Binding TimestampDisplay}"
                                               FontSize="{StaticResource FontSize.Small}"
                                               Foreground="{DynamicResource Brush.TextMuted}"/>
                                    <TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <DockPanel Grid.Column="1" Margin="8,0,0,0">
                        <Button DockPanel.Dock="Bottom"
                                Content="{x:Static res:Strings.Notes_History_Restore}"
                                Command="{Binding RestoreCommand}"
                                HorizontalAlignment="Left" Padding="10,4" Margin="0,8,0,0"/>
                        <!-- Read-only version preview: a plain TextBox (no second WebView2 editor).
                             Keeps the panel lightweight and genuinely non-editable. -->
                        <TextBox Text="{Binding PreviewMarkdown, Mode=OneWay}"
                                 IsReadOnly="True" TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="{DynamicResource Brush.Surface}"
                                 BorderThickness="1"
                                 BorderBrush="{DynamicResource Brush.Border}"/>
                    </DockPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
