<UserControl x:Class="Recordum.WPF.Views.HabitScreen.NotesTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Recordum.Presentation.ViewModels.HabitScreen.Notes;assembly=Recordum.Presentation"
             xmlns:vmh="clr-namespace:Recordum.Presentation.ViewModels.HabitScreen;assembly=Recordum.Presentation"
             xmlns:enums="clr-namespace:Recordum.Core.Enums;assembly=Recordum.Core"
             xmlns:res="clr-namespace:Recordum.Presentation.Resources;assembly=Recordum.Presentation"
             xmlns:ctrl="clr-namespace:Recordum.WPF.Controls">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <Button DockPanel.Dock="Top"
                    Content="{x:Static res:Strings.Notes_New}"
                    Command="{Binding NewCommand}"
                    Padding="6,4" Margin="6"/>
            <StackPanel DockPanel.Dock="Top" Margin="6,0,6,6">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <RadioButton Content="{x:Static res:Strings.Records_Mode_Day}"
                                 GroupName="NotesMode"
                                 IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static vmh:EntriesRecordsMode.Giorno}}"/>
                    <RadioButton Content="{x:Static res:Strings.Records_Mode_Period}"
                                 GroupName="NotesMode" Margin="8,0,0,0"
                                 IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static vmh:EntriesRecordsMode.Periodo}}"/>
                </StackPanel>
                <StackPanel Visibility="{Binding Mode, Converter={StaticResource EnumToVisibility}, ConverterParameter={x:Static vmh:EntriesRecordsMode.Periodo}}">
                    <ComboBox ItemsSource="{Binding Source={StaticResource EntriesPeriodValues}}"
                              SelectedItem="{Binding SelectedPeriod}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EntriesPeriodLabel}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                Visibility="{Binding SelectedPeriod, Converter={StaticResource EnumToVisibility}, ConverterParameter={x:Static enums:EntriesPeriod.Personalizzato}}">
                        <TextBlock Text="{x:Static res:Strings.Period_From}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <DatePicker SelectedDate="{Binding CustomFrom, Converter={StaticResource DateOnlyToDateTime}}"/>
                        <TextBlock Text="{x:Static res:Strings.Period_To}" VerticalAlignment="Center" Margin="6,0,4,0"/>
                        <DatePicker SelectedDate="{Binding CustomTo, Converter={StaticResource DateOnlyToDateTime}}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            <ListBox ItemsSource="{Binding Notes}"
                     SelectedItem="{Binding SelectedNote, Mode=TwoWay}"
                     BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:NoteRowViewModel}">
                        <StackPanel Margin="0,4"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
                            <StackPanel.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{x:Static res:Strings.Notes_History}"
                                              Command="{Binding PlacementTarget.Tag.ShowHistoryCommand,
                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext,
                                                                 RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                </ContextMenu>
                            </StackPanel.ContextMenu>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <Border Padding="5,1" CornerRadius="3"
                                        Background="{DynamicResource Brush.SurfaceElevated}">
                                    <TextBlock FontSize="{StaticResource FontSize.Small}"
                                               Foreground="{DynamicResource Brush.TextMuted}">
                                        <Run Text="{Binding AnchorDateDisplay, Mode=OneWay}"/>
                                        <Run Text="{Binding CreatedAtTimeDisplay, Mode=OneWay}"/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding ModifiedAtDisplay}"
                                       FontSize="{StaticResource FontSize.Small}"
                                       Foreground="{DynamicResource Brush.TextMuted}"
                                       Visibility="{Binding WasModified, Converter={StaticResource BoolToVisible}}"/>
                            <TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="4"
                      HorizontalAlignment="Stretch"
                      Background="{DynamicResource Brush.Border}"/>

        <Grid Grid.Column="2" Margin="8">
            <!-- Editor (normal state) -->
            <Grid Visibility="{Binding IsShowingHistory, Converter={StaticResource InvBoolToVisible}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ctrl:MarkdownEditorControl Grid.Row="0"
                                            Markdown="{Binding EditorMarkdown, Mode=TwoWay}"
                                            Availability="{Binding Availability}"/>

                <!-- Attachments gallery: title + add button, then a thumbnail strip that only takes
                     space once photos exist (an empty ItemsControl/WrapPanel has zero height, so no
                     separate empty-state copy is needed here). -->
                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right"
                                Content="{x:Static res:Strings.Notes_Attachments_Add}"
                                Command="{Binding AddAttachmentCommand}"
                                Padding="8,4"/>
                        <TextBlock Text="{x:Static res:Strings.Notes_Attachments_Title}"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                    </DockPanel>
                    <ItemsControl x:Name="AttachmentGallery" ItemsSource="{Binding Attachments}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AttachmentViewModel}">
                                <Grid Width="80" Height="80" Margin="0,0,8,8">
                                    <Button Command="{Binding DataContext.OpenLightboxCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Cursor="Hand" Padding="0" BorderThickness="0"
                                            Background="{DynamicResource Brush.SurfaceElevated}">
                                        <Border CornerRadius="4" ClipToBounds="True" Width="78" Height="78">
                                            <Image Source="{Binding Thumbnail, Converter={StaticResource BytesToImageSource}}" Stretch="UniformToFill"/>
                                        </Border>
                                    </Button>
                                    <!-- Remove: the same Lucide-style X icon as ChartsView's series-remove
                                         button (Path cross, not a raw glyph). -->
                                    <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="2" Padding="3" Width="20" Height="20"
                                            Background="Transparent" BorderThickness="0"
                                            ToolTip="{x:Static res:Strings.Notes_Attachments_Delete}"
                                            Command="{Binding DataContext.DeleteAttachmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <Path Width="9" Height="9" Stretch="Uniform"
                                              Stroke="{DynamicResource Brush.TextMuted}" StrokeThickness="1.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Data="M0,0 L9,9 M9,0 L0,9"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <DockPanel Grid.Row="2" Margin="0,8,0,0">
                    <Button Content="{x:Static res:Strings.Notes_Save}"
                            Command="{Binding SaveCommand}"
                            Padding="10,4" Margin="0,0,6,0"/>
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsConfirmingDelete, Converter={StaticResource InvBoolToVisible}}">
                        <Button Content="{x:Static res:Strings.Notes_Delete}"
                                Command="{Binding RequestDeleteCommand}"
                                Padding="10,4"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsConfirmingDelete, Converter={StaticResource BoolToVisible}}">
                        <TextBlock Text="{x:Static res:Strings.Notes_ConfirmDelete}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button Content="{x:Static res:Strings.Notes_Confirm}"
                                Command="{Binding ConfirmDeleteCommand}"
                                Padding="10,4" Margin="0,0,4,0"/>
                        <Button Content="{x:Static res:Strings.Notes_Cancel}"
                                Command="{Binding CancelDeleteCommand}"
                                Padding="10,4"/>
                    </StackPanel>
                </DockPanel>
            </Grid>

            <!-- Version history (history state) -->
            <Grid Visibility="{Binding IsShowingHistory, Converter={StaticResource BoolToVisible}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Button Grid.Row="0"
                        Content="{x:Static res:Strings.Notes_History_Back}"
                        Command="{Binding HideHistoryCommand}"
                        HorizontalAlignment="Left" Padding="8,4" Margin="0,0,0,8"/>
                <Grid Grid.Row="1" DataContext="{Binding History}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ListBox Grid.Column="0" BorderThickness="0"
                             ItemsSource="{Binding Versions}"
                             SelectedItem="{Binding SelectedVersion, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NoteVersionRowViewModel}">
                                <StackPanel Margin="0,4">
                                    <TextBlock Text="{Binding TimestampDisplay}"
                                               FontSize="{StaticResource FontSize.Small}"
                                               Foreground="{DynamicResource Brush.TextMuted}"/>
                                    <TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <DockPanel Grid.Column="1" Margin="8,0,0,0">
                        <Button DockPanel.Dock="Bottom"
                                Content="{x:Static res:Strings.Notes_History_Restore}"
                                Command="{Binding RestoreCommand}"
                                HorizontalAlignment="Left" Padding="10,4" Margin="0,8,0,0"/>
                        <!-- Read-only version preview: a plain TextBox (no second WebView2 editor).
                             Keeps the panel lightweight and genuinely non-editable. -->
                        <TextBox Text="{Binding PreviewMarkdown, Mode=OneWay}"
                                 IsReadOnly="True" TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"/>
                    </DockPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- Lightbox: full-tab overlay (no existing modal-Window precedent fit this — the photo
             stays contextual to the Note tab rather than opening a whole new OS window). Backdrop
             is a borderless Button filling the overlay; the content Grid below has no Background of
             its own, so clicks in its empty margin area fall through (WPF panels are hit-test
             invisible without a Background) to the backdrop and close the lightbox, while clicks on
             the image/controls are consumed by those elements first (siblings, so their click never
             bubbles into the backdrop Button). -->
        <Grid x:Name="Lightbox" Grid.ColumnSpan="3"
              Visibility="{Binding IsLightboxOpen, Converter={StaticResource BoolToVisible}}">
            <Button Command="{Binding CloseLightboxCommand}"
                    Background="#B3000000" BorderThickness="0" Focusable="False"/>
            <Grid Margin="40">
                <Border MaxWidth="900" MaxHeight="700"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource Brush.SurfaceElevated}"
                        CornerRadius="8" Padding="16">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.20" BlurRadius="18" ShadowDepth="0"/>
                    </Border.Effect>
                    <Image Source="{Binding LightboxContent, Converter={StaticResource BytesToImageSource}}" Stretch="Uniform"/>
                </Border>

                <Button HorizontalAlignment="Left" VerticalAlignment="Center"
                        Width="36" Height="36" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTip="{x:Static res:Strings.Notes_Lightbox_Previous}"
                        IsEnabled="{Binding CanNavigateLightbox}"
                        Command="{Binding LightboxPreviousCommand}">
                    <Path Width="14" Height="14" Stretch="Uniform"
                          Data="{StaticResource Icon.ChevronRight}"
                          Stroke="{DynamicResource Brush.Text}" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <ScaleTransform ScaleX="-1"/>
                        </Path.RenderTransform>
                    </Path>
                </Button>

                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="36" Height="36" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTip="{x:Static res:Strings.Notes_Lightbox_Next}"
                        IsEnabled="{Binding CanNavigateLightbox}"
                        Command="{Binding LightboxNextCommand}">
                    <Path Width="14" Height="14" Stretch="Uniform"
                          Data="{StaticResource Icon.ChevronRight}"
                          Stroke="{DynamicResource Brush.Text}" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Button>

                <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                        Width="28" Height="28" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTip="{x:Static res:Strings.Notes_Lightbox_Close}"
                        Command="{Binding CloseLightboxCommand}">
                    <Path Width="12" Height="12" Stretch="Uniform"
                          Stroke="{DynamicResource Brush.Text}" StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M0,0 L9,9 M9,0 L0,9"/>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
