<UserControl x:Class="Recordum.WPF.Views.HabitScreen.Calendar.CalendarNavigator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Recordum.WPF.ViewModels.HabitScreen.Calendar"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:CalendarNavigatorViewModel}">
    <Border Padding="12" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border}">
        <StackPanel>
            <!-- Header: prev / month-label / month-picker / year-picker / next -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="&#x2039;" Width="28" Command="{Binding PrevMonthCommand}"/>
                <TextBlock Grid.Column="1" Text="{Binding MonthLabel}" VerticalAlignment="Center"
                           Margin="8,0" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}"/>
                <ComboBox Grid.Column="2" Width="64" Margin="0,0,4,0"
                          ItemsSource="{Binding SelectableMonths}"
                          SelectedItem="{Binding DisplayMonth}"
                          SelectionChanged="OnJumpChanged"/>
                <ComboBox Grid.Column="3" Width="74"
                          ItemsSource="{Binding SelectableYears}"
                          SelectedItem="{Binding DisplayYear}"
                          SelectionChanged="OnJumpChanged"/>
                <Button Grid.Column="4" Content="&#x203A;" Width="28" Margin="4,0,0,0" Command="{Binding NextMonthCommand}"/>
            </Grid>

            <!-- Weekday header row -->
            <ItemsControl ItemsSource="{Binding WeekdayHeaders}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" HorizontalAlignment="Center"
                                   FontSize="{StaticResource FontSize.Small}"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 6×7 day grid -->
            <ItemsControl ItemsSource="{Binding Cells}" Margin="0,4,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="7" Rows="6"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CalendarDayCellViewModel}">
                        <Button Margin="2" Padding="0" Height="34"
                                BorderThickness="1"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Command="{Binding DataContext.SelectDateCommand,
                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                                    <Style.Triggers>
                                        <!-- Disable future cells (no inverting converter needed) -->
                                        <DataTrigger Binding="{Binding IsFuture}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                        <!-- Dim cells outside the current month -->
                                        <DataTrigger Binding="{Binding InCurrentMonth}" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
                                            <Setter Property="Opacity" Value="0.45"/>
                                        </DataTrigger>
                                        <!-- Today: accent border -->
                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                        </DataTrigger>
                                        <!-- Selected: filled accent background (= habit color via the
                                             HabitScreen Brush.Accent override), with contrast-aware text. -->
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
                                            <Setter Property="Foreground" Value="{Binding TintColorHex, Converter={StaticResource ContrastForeground}}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <!-- Heat tint background: habit colour (VM) × per-cell step -->
                                <Border CornerRadius="6">
                                    <Border.Background>
                                        <MultiBinding Converter="{StaticResource HabitColorTint}">
                                            <Binding Path="TintColorHex"/>
                                            <Binding Path="TintStep"/>
                                        </MultiBinding>
                                    </Border.Background>
                                </Border>
                                <!-- Day number, top-left, discreet -->
                                <TextBlock Text="{Binding DayNumber}"
                                           HorizontalAlignment="Left" VerticalAlignment="Top"
                                           Margin="5,3,0,0"
                                           FontSize="{StaticResource FontSize.Small}"/>
                                <!-- Count / quantity, single slot, centre-bottom -->
                                <TextBlock Text="{Binding Number}"
                                           HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                           Margin="0,0,0,4" FontWeight="SemiBold"
                                           FontSize="{StaticResource FontSize.Small}"
                                           Visibility="{Binding HasNumber, Converter={StaticResource BoolToVisible}}"/>
                                <!-- Note corner: per-habit colour (parent VM) -->
                                <Path HorizontalAlignment="Right" VerticalAlignment="Top"
                                      Data="M 0,0 L 13,0 L 13,13 Z"
                                      Visibility="{Binding HasNote, Converter={StaticResource BoolToVisible}}"
                                      Fill="{Binding DataContext.NoteColorHex,
                                             RelativeSource={RelativeSource AncestorType=ItemsControl},
                                             Converter={StaticResource HexToBrush}}"/>
                                <!-- Note count (>1), overlaid on the corner -->
                                <TextBlock Text="{Binding NoteCount}"
                                           HorizontalAlignment="Right" VerticalAlignment="Top"
                                           Margin="0,0,1,0" FontSize="8" FontWeight="Bold"
                                           Foreground="{Binding DataContext.NoteColorHex,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl},
                                                        Converter={StaticResource ContrastForeground}}"
                                           Visibility="{Binding ShowNoteCount, Converter={StaticResource BoolToVisible}}"/>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
