<UserControl x:Class="Recordum.WPF.Views.HabitScreen.Calendar.CalendarNavigator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Recordum.WPF.ViewModels.HabitScreen.Calendar"
             xmlns:res="clr-namespace:Recordum.WPF.Resources"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:CalendarNavigatorViewModel}">
    <UserControl.Resources>
        <!-- Square day cell shared by Week + Month. Height tracks its own width → responsive square.
             Day number = small muted metadata top-left; the habit count = the data, shown in a small
             white-ish ring (contrast-aware, capsule when the value is wide) so it reads distinctly. -->
        <DataTemplate x:Key="DayCellTemplate" DataType="{x:Type vm:CalendarDayCellViewModel}">
            <Button Margin="2" Padding="0"
                    Width="{Binding DataContext.CellSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    Height="{Binding DataContext.CellSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    BorderThickness="1"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Command="{Binding DataContext.SelectDateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <!-- Faint grey base so every cell reads as a square against the panel (same as the
                             Year cells). The tint overlay covers it on days with data; the selected trigger
                             below overrides it with the accent fill. -->
                        <Setter Property="Background" Value="{DynamicResource Brush.Border}"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFuture}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding InCurrentMonth}" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
                                <Setter Property="Opacity" Value="0.45"/>
                            </DataTrigger>
                            <!-- Today: subtle 1px accent ring (the default BorderThickness). -->
                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                            </DataTrigger>
                            <!-- Selected: an accent RING (not a fill) so the completion tint underneath stays
                                 visible — a selected + completed day is unambiguous (F0-13). Placed after the
                                 today trigger so the 2px ring overrides today's 1px one. -->
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Grid>
                    <Border CornerRadius="6">
                        <Border.Background>
                            <MultiBinding Converter="{StaticResource HabitColorTint}">
                                <Binding Path="TintColorHex"/>
                                <Binding Path="TintStep"/>
                                <Binding Path="Tint"/>
                            </MultiBinding>
                        </Border.Background>
                    </Border>
                    <!-- Day-of-month: small, muted, top-left -->
                    <TextBlock Text="{Binding DayNumber}" HorizontalAlignment="Left" VerticalAlignment="Top"
                               Margin="5,3,0,0" FontSize="10" Opacity="0.85"/>
                    <!-- Habit count: ringed, centered, contrast-aware (follows the button foreground). -->
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                            MinWidth="18" Height="18" Padding="4,0" CornerRadius="9" BorderThickness="1.2"
                            BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Visibility="{Binding HasNumber, Converter={StaticResource BoolToVisible}}">
                        <TextBlock Text="{Binding Number}" FontSize="10.5" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <!-- Note corner: per-habit colour -->
                    <Path HorizontalAlignment="Right" VerticalAlignment="Top" Data="M 0,0 L 13,0 L 13,13 Z"
                          Visibility="{Binding HasNote, Converter={StaticResource BoolToVisible}}"
                          Fill="{Binding DataContext.NoteColorHex, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource HexToBrush}}"/>
                    <TextBlock Text="{Binding NoteCount}" HorizontalAlignment="Right" VerticalAlignment="Top"
                               Margin="0,0,1,0" FontSize="8" FontWeight="Bold"
                               Foreground="{Binding DataContext.NoteColorHex, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ContrastForeground}}"
                               Visibility="{Binding ShowNoteCount, Converter={StaticResource BoolToVisible}}"/>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- Tiny day cell for the Year mini-months: responsive square, tooltip, note triangle, click selects.
             Out-of-month days are collapsed (kept only so weekday columns line up). Select command + note
             colour live on the navigator VM, two ItemsControl levels up (MonthBlocks → Cells). -->
        <DataTemplate x:Key="YearCellTemplate" DataType="{x:Type vm:CalendarDayCellViewModel}">
            <Button Width="14" Height="14" Margin="1" Padding="0" BorderThickness="1"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    ToolTip="{Binding TooltipText}" ToolTipService.InitialShowDelay="300"
                    Visibility="{Binding InCurrentMonth, Converter={StaticResource BoolToVisible}}"
                    Command="{Binding DataContext.SelectDateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}"
                    CommandParameter="{Binding}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFuture}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Setter Property="Opacity" Value="0.4"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Grid>
                    <!-- Always-visible faint base so the grid reads even on empty days. -->
                    <Border CornerRadius="2" Background="{DynamicResource Brush.Border}"/>
                    <Border CornerRadius="2">
                        <Border.Background>
                            <MultiBinding Converter="{StaticResource HabitColorTint}">
                                <Binding Path="TintColorHex"/>
                                <Binding Path="TintStep"/>
                                <Binding Path="Tint"/>
                            </MultiBinding>
                        </Border.Background>
                    </Border>
                    <Path HorizontalAlignment="Right" VerticalAlignment="Top" Data="M 0,0 L 6,0 L 6,6 Z"
                          Visibility="{Binding HasNote, Converter={StaticResource BoolToVisible}}"
                          Fill="{Binding DataContext.NoteColorHex, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}, Converter={StaticResource HexToBrush}}"/>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- One month block in the Year mini-months view: month name + a compact 6×7 mini-grid. -->
        <DataTemplate x:Key="YearMonthTemplate" DataType="{x:Type vm:CalendarMonthBlockViewModel}">
            <StackPanel Width="112" Margin="6,4">
                <TextBlock Text="{Binding MonthName}" Margin="2,0,0,3"
                           FontSize="{StaticResource FontSize.Small}" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.TextMuted}"/>
                <ItemsControl ItemsSource="{Binding Cells}" ItemTemplate="{StaticResource YearCellTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="7" Rows="6"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <!-- One day in the Year heatmap: fixed small square, tooltip, note triangle, click selects.
             Select command + note colour are two ItemsControl levels up (YearWeeks → week). -->
        <DataTemplate x:Key="HeatCellTemplate" DataType="{x:Type vm:CalendarDayCellViewModel}">
            <Button Width="15" Height="15" Margin="1.5" Padding="0" BorderThickness="1"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    ToolTip="{Binding TooltipText}" ToolTipService.InitialShowDelay="300"
                    Command="{Binding DataContext.SelectDateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}"
                    CommandParameter="{Binding}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFuture}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding InCurrentMonth}" Value="False">
                                <Setter Property="Opacity" Value="0.25"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Grid>
                    <!-- Always-visible faint base so the heatmap grid reads even on empty days. -->
                    <Border CornerRadius="2" Background="{DynamicResource Brush.Border}"/>
                    <Border CornerRadius="2">
                        <Border.Background>
                            <MultiBinding Converter="{StaticResource HabitColorTint}">
                                <Binding Path="TintColorHex"/>
                                <Binding Path="TintStep"/>
                                <Binding Path="Tint"/>
                            </MultiBinding>
                        </Border.Background>
                    </Border>
                    <Path HorizontalAlignment="Right" VerticalAlignment="Top" Data="M 0,0 L 6,0 L 6,6 Z"
                          Visibility="{Binding HasNote, Converter={StaticResource BoolToVisible}}"
                          Fill="{Binding DataContext.NoteColorHex, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}, Converter={StaticResource HexToBrush}}"/>
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Border Padding="12" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border}">
        <StackPanel>
            <!-- Header: view toggle (+ year sub-toggle), prev / label / jump / next -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,0">
                    <!-- View toggles on the shared segmented pill style (Fase C); the sub-toggle gets a
                         slightly tighter padding so the row stays compact. -->
                    <RadioButton GroupName="calview" Style="{StaticResource Recordum.Segment}"
                                 Content="{x:Static res:Strings.Calendar_View_Week}"
                                 Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static vm:CalendarViewMode.Week}"
                                 IsChecked="{Binding ViewMode, Mode=OneWay, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static vm:CalendarViewMode.Week}}"/>
                    <RadioButton GroupName="calview" Style="{StaticResource Recordum.Segment}" Margin="2,0,0,0"
                                 Content="{x:Static res:Strings.Calendar_View_Month}"
                                 Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static vm:CalendarViewMode.Month}"
                                 IsChecked="{Binding ViewMode, Mode=OneWay, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static vm:CalendarViewMode.Month}}"/>
                    <RadioButton GroupName="calview" Style="{StaticResource Recordum.Segment}" Margin="2,0,0,0"
                                 Content="{x:Static res:Strings.Calendar_View_Year}"
                                 Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static vm:CalendarViewMode.Year}"
                                 IsChecked="{Binding ViewMode, Mode=OneWay, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static vm:CalendarViewMode.Year}}"/>

                    <!-- Year sub-toggle: Mesi / Heatmap (only in Year) -->
                    <StackPanel Orientation="Horizontal" Margin="14,0,0,0"
                                Visibility="{Binding ViewMode, Converter={StaticResource EnumToVisibility}, ConverterParameter={x:Static vm:CalendarViewMode.Year}}">
                        <RadioButton GroupName="calsub" Style="{StaticResource Recordum.Segment}" Padding="8,3"
                                     Content="{x:Static res:Strings.Calendar_Year_Months}"
                                     Command="{Binding SetYearHeatmapCommand}"
                                     IsChecked="{Binding YearAsHeatmap, Mode=OneWay, Converter={StaticResource InverseBool}}">
                            <RadioButton.CommandParameter><sys:Boolean>False</sys:Boolean></RadioButton.CommandParameter>
                        </RadioButton>
                        <RadioButton GroupName="calsub" Style="{StaticResource Recordum.Segment}" Padding="8,3" Margin="2,0,0,0"
                                     Content="{x:Static res:Strings.Calendar_Year_Heatmap}"
                                     Command="{Binding SetYearHeatmapCommand}"
                                     IsChecked="{Binding YearAsHeatmap, Mode=OneWay}">
                            <RadioButton.CommandParameter><sys:Boolean>True</sys:Boolean></RadioButton.CommandParameter>
                        </RadioButton>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" Content="&#x2039;" Width="28" Command="{Binding PrevCommand}"/>
                <TextBlock Grid.Column="2" Text="{Binding HeaderLabel}" VerticalAlignment="Center"
                           Margin="8,0" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}"/>
                <ComboBox Grid.Column="3" Width="64" Margin="0,0,4,0"
                          ItemsSource="{Binding SelectableMonths}" SelectedItem="{Binding DisplayMonth}"
                          SelectionChanged="OnJumpChanged"
                          Visibility="{Binding ViewMode, Converter={StaticResource EnumToVisibility}, ConverterParameter={x:Static vm:CalendarViewMode.Month}}"/>
                <ComboBox Grid.Column="4" Width="74"
                          ItemsSource="{Binding SelectableYears}" SelectedItem="{Binding DisplayYear}"
                          SelectionChanged="OnJumpChanged"/>
                <Button Grid.Column="5" Content="&#x203A;" Width="28" Margin="4,0,0,0" Command="{Binding NextCommand}"/>
            </Grid>

            <!-- Weekday header (Week + Month only — each cell is CellSize wide with the same 2px margin as a
                 day cell, so the 7 header columns line up pixel-for-pixel with the day grid below; hidden in
                 Year). Left-aligned: the panel sizes to its content (7 × (CellSize+4)). -->
            <ItemsControl ItemsSource="{Binding WeekdayHeaders}" HorizontalAlignment="Left">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ViewMode}" Value="Year">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Margin="2" TextAlignment="Center"
                                   Width="{Binding DataContext.CellSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                   FontSize="{StaticResource FontSize.Small}" Foreground="{DynamicResource Brush.TextMuted}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Month body: fixed-size 6×7 square grid (cells = CellSize), left-aligned so it sizes to its
                 content (7 × (CellSize+4)) and shares that width with the header above. -->
            <ItemsControl ItemsSource="{Binding Cells}" Margin="0,4,0,0" HorizontalAlignment="Left"
                          ItemTemplate="{StaticResource DayCellTemplate}"
                          Visibility="{Binding ViewMode, Converter={StaticResource EnumToVisibility}, ConverterParameter={x:Static vm:CalendarViewMode.Month}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="7" Rows="6"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- Week body: single row of 7 fixed-size square cells (cells = CellSize), left-aligned so it
                 sizes to its content (7 × (CellSize+4)) and shares that width with the header above. -->
            <ItemsControl ItemsSource="{Binding Cells}" Margin="0,4,0,0" HorizontalAlignment="Left"
                          ItemTemplate="{StaticResource DayCellTemplate}"
                          Visibility="{Binding ViewMode, Converter={StaticResource EnumToVisibility}, ConverterParameter={x:Static vm:CalendarViewMode.Week}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="7" Rows="1"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- Year body: mini-months OR heatmap, switched by the sub-toggle. -->
            <Grid Margin="0,4,0,0"
                  Visibility="{Binding ViewMode, Converter={StaticResource EnumToVisibility}, ConverterParameter={x:Static vm:CalendarViewMode.Year}}">
                <!-- Mini-months: twelve blocks wrapping to fit, vertical scroll if needed. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="460"
                              Visibility="{Binding YearAsHeatmap, Converter={StaticResource InvBoolToVisible}}">
                    <ItemsControl ItemsSource="{Binding MonthBlocks}" ItemTemplate="{StaticResource YearMonthTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
                <!-- Heatmap: 53 week-columns (horizontal) of 7 weekday cells (vertical). -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              Visibility="{Binding YearAsHeatmap, Converter={StaticResource BoolToVisible}}">
                    <ItemsControl ItemsSource="{Binding YearWeeks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding}" ItemTemplate="{StaticResource HeatCellTemplate}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
