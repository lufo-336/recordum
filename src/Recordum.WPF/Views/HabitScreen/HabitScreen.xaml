<UserControl x:Class="Recordum.WPF.Views.HabitScreen.HabitScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Recordum.WPF.ViewModels.HabitScreen"
             xmlns:qa="clr-namespace:Recordum.WPF.ViewModels.HabitScreen.QuickAdd"
             xmlns:vmn="clr-namespace:Recordum.WPF.ViewModels.HabitScreen.Notes"
             xmlns:vmd="clr-namespace:Recordum.WPF.ViewModels.HabitScreen.Detail"
             xmlns:vmj="clr-namespace:Recordum.WPF.ViewModels.HabitScreen.Journal"
             xmlns:v="clr-namespace:Recordum.WPF.Views.HabitScreen"
             xmlns:ve="clr-namespace:Recordum.WPF.Views"
             xmlns:cal="clr-namespace:Recordum.WPF.Views.HabitScreen.Calendar"
             xmlns:today="clr-namespace:Recordum.WPF.Views.HabitScreen.Today"
             xmlns:ctrl="clr-namespace:Recordum.WPF.Controls"
             xmlns:sel="clr-namespace:Recordum.WPF.Selectors"
             xmlns:res="clr-namespace:Recordum.WPF.Resources"
             xmlns:enums="clr-namespace:Recordum.Core.Enums;assembly=Recordum.Core"
             xmlns:helpers="clr-namespace:Recordum.WPF.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:HabitScreenViewModel, IsDesignTimeCreatable=False}"
             Background="{DynamicResource Brush.Surface}">
    <UserControl.Resources>

        <!-- Habit color identity: every Brush.Accent consumer inside this screen (button hover/focus
             borders, text selection, calendar today/selected) re-resolves to the habit color. The
             proxy bridges Node.Color into the resource scope (resources have no DataContext). -->
        <helpers:BindingProxy x:Key="HabitColorProxy" Data="{Binding Node.Color}"/>
        <SolidColorBrush x:Key="Brush.Accent"
                         Color="{Binding Data, Source={StaticResource HabitColorProxy},
                                 Converter={StaticResource HexToColor}}"/>

        <DataTemplate DataType="{x:Type vm:TimerControlViewModel}">
            <Border Padding="12,8"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource Brush.Border}"
                    Visibility="{Binding IsApplicable, Converter={StaticResource BoolToVisible}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="{Binding ElapsedDisplay}"
                                   FontFamily="Consolas"
                                   FontSize="{StaticResource FontSize.Heading}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <Button Content="{x:Static res:Strings.HabitScreen_Timer_Start}"
                                Command="{Binding StartCommand}" Padding="10,4" Margin="0,0,6,0"/>
                        <Button Content="{x:Static res:Strings.HabitScreen_Timer_Pause}"
                                Command="{Binding PauseCommand}" Padding="10,4" Margin="0,0,6,0"
                                Visibility="{Binding IsPaused, Converter={StaticResource InvBoolToVisible}}"/>
                        <Button Content="{x:Static res:Strings.HabitScreen_Timer_Resume}"
                                Command="{Binding ResumeCommand}" Padding="10,4" Margin="0,0,6,0"
                                Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisible}}"/>
                        <Button Content="{x:Static res:Strings.HabitScreen_Timer_Stop}"
                                Command="{Binding StopCommand}" Padding="10,4" Margin="0,0,6,0"/>
                        <Button Content="{x:Static res:Strings.HabitScreen_Timer_NextSegment}"
                                Command="{Binding NextSegmentCommand}" Padding="10,4"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Segments}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="6,2" Margin="0,0,6,0"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource Brush.Border}"
                                        CornerRadius="3">
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Brush.TextMuted}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:CompletionListViewModel}">
            <Border Padding="12">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CompletionRowViewModel}">
                            <Border BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource Brush.Border}"
                                    Padding="0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Display}" FontWeight="SemiBold"/>
                                        <ItemsControl ItemsSource="{Binding FieldDisplays}"
                                                      Visibility="{Binding HasFieldDisplays, Converter={StaticResource BoolToVisible}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource Brush.Text}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding Notes}"
                                                   Foreground="{DynamicResource Brush.TextMuted}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding Notes, Converter={StaticResource NullToVisibility}}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="✎"
                                            Command="{Binding BeginEditCommand}"
                                            Width="28" Height="28"
                                            Background="Transparent" BorderThickness="0"
                                            Visibility="{Binding CanInlineEdit, Converter={StaticResource BoolToVisible}}"/>
                                    <Button Grid.Column="2"
                                            Content="✕"
                                            Command="{Binding DeleteCommand}"
                                            Width="28" Height="28"
                                            Background="Transparent" BorderThickness="0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </DataTemplate>

        <!-- Cronologia Registrazioni for Resistance habits: abstinence periods as rows.
             Accent left bar = open period; Danger left bar = closed/relapsed period.
             Resource substitutions vs brief: InvBoolToVisible (not InverseBoolToVisible),
             inline button style (no IconButton key in this codebase), FontSize.Body (exists in Tokens.xaml). -->
        <DataTemplate DataType="{x:Type vm:AbstinencePeriodListViewModel}">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" Padding="12" CornerRadius="8"
                                BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}"
                                Background="{DynamicResource Brush.Surface}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- left bar: accent (open period) / danger (closed/relapsed) -->
                                <Border Grid.Column="0" CornerRadius="2" Margin="0,0,10,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Danger}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <!-- in-progress badge (open period only) -->
                                    <TextBlock Text="{x:Static res:Strings.Abstinence_InProgress}"
                                               FontSize="{StaticResource FontSize.Small}"
                                               Foreground="{DynamicResource Brush.Accent}"
                                               Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisible}}"/>
                                    <!-- live clock (open period) -->
                                    <TextBlock Text="{Binding Clock.Display}" FontFamily="Consolas"
                                               FontSize="{StaticResource FontSize.Heading}"
                                               Foreground="{DynamicResource Brush.Text}"
                                               Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisible}}"/>
                                    <!-- clean-days count (closed period) -->
                                    <TextBlock Text="{Binding DurationDisplay}"
                                               FontSize="{StaticResource FontSize.Body}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Text}"
                                               Visibility="{Binding IsCurrent, Converter={StaticResource InvBoolToVisible}}"/>
                                    <!-- date range (both open and closed) -->
                                    <TextBlock Text="{Binding SinceDisplay}"
                                               FontSize="{StaticResource FontSize.Small}"
                                               Foreground="{DynamicResource Brush.TextMuted}"/>
                                    <!-- relapse date (closed period only) -->
                                    <TextBlock Text="{Binding RelapsedOnDisplay}"
                                               FontSize="{StaticResource FontSize.Small}"
                                               Foreground="{DynamicResource Brush.Danger}"
                                               Visibility="{Binding IsCurrent, Converter={StaticResource InvBoolToVisible}}"/>
                                </StackPanel>
                                <!-- delete button: same inline style as CompletionListViewModel delete -->
                                <Button Grid.Column="2" Command="{Binding DeleteCommand}"
                                        Width="28" Height="28" Padding="0"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        Background="Transparent" BorderThickness="0"
                                        ToolTip="{x:Static res:Strings.Abstinence_DeleteConfirm_Title}"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="14" TextAlignment="Center"/>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <DataTemplate x:Key="ActionQuickAddTemplate" DataType="{x:Type qa:ActionQuickAddViewModel}">
            <StackPanel Margin="12" Orientation="Vertical">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{x:Static res:Strings.Abitudine_QuickAdd_RecordingFor}"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Text}"
                               Text="{Binding CompletionDate, StringFormat=d}"/>
                </Grid>
                <Button Content="{x:Static res:Strings.HabitScreen_QuickAdd_Action_Mark}"
                        Command="{Binding SaveCommand}"
                        HorizontalAlignment="Left"
                        Padding="12,6"/>
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="Red"
                           Margin="0,6,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}"/>
            </StackPanel>
        </DataTemplate>

        <!-- Bare counter: each tap records one occurrence immediately; the count = number of completions today.
             "Undo last" deletes the newest of the selected day (spec multivalue §4.1). -->
        <DataTemplate x:Key="CounterTapQuickAddTemplate" DataType="{x:Type qa:CounterTapQuickAddViewModel}">
            <StackPanel Margin="12" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding TapCommand}" Width="44" Height="44"
                        Content="{x:Static res:Strings.HabitScreen_QuickAdd_Tap}"
                        FontSize="17" FontWeight="SemiBold"
                        Foreground="{DynamicResource Brush.OnAccent}" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" CornerRadius="22" Background="{DynamicResource Brush.Accent}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Brush.Text}">
                        <TextBlock.Text>
                            <Binding Path="DayCount" StringFormat="{x:Static res:Strings.HabitScreen_QuickAdd_TodayCount}"/>
                        </TextBlock.Text>
                    </TextBlock>
                    <Button Command="{Binding UndoLastCommand}"
                            Content="{x:Static res:Strings.HabitScreen_QuickAdd_UndoLast}"
                            HorizontalAlignment="Left" Padding="0,4,0,0"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource Brush.TextMuted}" Cursor="Hand"/>
                </StackPanel>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" Margin="12,0,0,0" VerticalAlignment="Center"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}"/>
            </StackPanel>
        </DataTemplate>

        <!-- Kind-aware input cell for one metric: measured (numeric + unit), scale (labelled selector or slider), or text.
             Horizontal: [Name] [input] [unit]. Stacked vertically in Measured, side-by-side in CounterSeries series rows. -->
        <DataTemplate x:Key="MetricCellTemplate" DataType="{x:Type qa:SeriesCellViewModel}">
            <StackPanel Orientation="Horizontal" Margin="0,3,12,3" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" MinWidth="110" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{DynamicResource Brush.TextMuted}"/>
                <Grid VerticalAlignment="Center">
                    <!-- Measured: Integer (Seconds is handled by the duration value+unit selector below) -->
                    <TextBox Width="90"
                             Text="{Binding IntegerValue, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Kind}" Value="Measured"/>
                                            <Condition Binding="{Binding Type}" Value="Integer"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <!-- Measured: Seconds → decimal value + time-unit selector; normalized to seconds on save (U8). -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDuration}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBox Width="70"
                                 Text="{Binding DurationValue, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>
                        <ComboBox Width="72" Margin="4,0,0,0"
                                  ItemsSource="{x:Static qa:SeriesCellViewModel.TimeUnitOptions}"
                                  SelectedValue="{Binding DurationUnit}"
                                  SelectedValuePath="Unit" DisplayMemberPath="Label"/>
                    </StackPanel>
                    <!-- Measured: Decimal -->
                    <TextBox Width="90"
                             Text="{Binding DecimalValue, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Kind}" Value="Measured"/>
                                            <Condition Binding="{Binding Type}" Value="Decimal"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <!-- Text -->
                    <TextBox Width="140" Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="Text">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <!-- Scale: a stepped slider with reference points. The thumb snaps to each step; the
                         current step's caption shows above, and (small scales only) every step is captioned
                         below with the scale's labels or its bare numbers. Large scales keep just the value. -->
                    <StackPanel MinWidth="200" MaxWidth="300" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="Scale">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <!-- Current value -->
                        <TextBlock Text="{Binding SelectedScaleLabel}" HorizontalAlignment="Center"
                                   Margin="0,0,0,2" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Accent}"/>
                        <!-- No TargetNullValue: it is bidirectional, so a thumb resting at 0 (== the null
                             sentinel) would write null back to SelectedScaleIndex and the first step would
                             fail to save ("value required"). The VM seeds index 0, so the slider is never null. -->
                        <Slider Minimum="0" Maximum="{Binding SliderMax}"
                                Value="{Binding SelectedScaleIndex}"
                                IsSnapToTickEnabled="True" TickFrequency="1"/>
                        <!-- Step ticks: one per stop, slid onto its thumb position via the offset converter
                             (a single-cell Grid lets each tick render at the same origin then translate).
                             Captions are NOT per-tick — worded labels centred on every stop collide. -->
                        <ItemsControl ItemsSource="{Binding ScalePoints}" Margin="0,3,0,0"
                                      Visibility="{Binding ShowReferencePoints, Converter={StaticResource BoolToVisible}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><Grid/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="1" Height="4" HorizontalAlignment="Left"
                                            Background="{DynamicResource Brush.Border}">
                                        <Border.Margin>
                                            <MultiBinding Converter="{StaticResource ScaleLabelOffset}">
                                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                <Binding Path="Fraction"/>
                                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}"/>
                                            </MultiBinding>
                                        </Border.Margin>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- Endpoint captions only: min at the left stop, max at the right (inset 8px = the
                             thumb radius). The accent caption above names the current step as the thumb moves,
                             so the in-between steps never need a (colliding) label here. -->
                        <Grid Margin="8,1,8,0"
                              Visibility="{Binding ShowReferencePoints, Converter={StaticResource BoolToVisible}}">
                            <TextBlock Text="{Binding ScaleMinLabel}" HorizontalAlignment="Left"
                                       FontSize="{StaticResource FontSize.Small}"
                                       Foreground="{DynamicResource Brush.TextMuted}"/>
                            <TextBlock Text="{Binding ScaleMaxLabel}" HorizontalAlignment="Right"
                                       FontSize="{StaticResource FontSize.Small}"
                                       Foreground="{DynamicResource Brush.TextMuted}"/>
                        </Grid>
                    </StackPanel>
                </Grid>
                <!-- Per-cell stopwatch (duration cells only). Reaches ToggleChronoCommand on the hosting
                     quick-add VM (Measured/CounterSeries) via the QuickAdd ContentControl. -->
                <Button Width="28" Height="28" Padding="0" Margin="6,0,0,0" VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Command="{Binding Content.ToggleChronoCommand, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                        CommandParameter="{Binding}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="ToolTip" Value="{x:Static res:Strings.HabitScreen_QuickAdd_ChronoStart}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDuration}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsChronoRunning}" Value="True">
                                    <Setter Property="ToolTip" Value="{x:Static res:Strings.HabitScreen_QuickAdd_ChronoStop}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Path Width="16" Height="16" Stretch="Uniform"
                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Stroke" Value="{DynamicResource Brush.TextMuted}"/>
                                <Setter Property="Data" Value="{StaticResource Icon.Clock}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChronoRunning}" Value="True">
                                        <Setter Property="Stroke" Value="{DynamicResource Brush.Accent}"/>
                                        <Setter Property="Data" Value="{StaticResource Icon.Square}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Button>
                <!-- Live elapsed while this cell's stopwatch runs (U8). Value comes from the shared ChronoClock on
                     the quick-add host; visibility is scoped to the running cell so other duration cells stay quiet. -->
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontFamily="Consolas"
                           Foreground="{DynamicResource Brush.Accent}"
                           Text="{Binding Content.ChronoClock.Display, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                           Visibility="{Binding IsChronoRunning, Converter={StaticResource BoolToVisible}}"/>
                <TextBlock Text="{Binding UnitLabel}" Margin="6,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextMuted}"
                           Visibility="{Binding ShowUnitLabel, Converter={StaticResource BoolToVisible}}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="MeasuredQuickAddTemplate" DataType="{x:Type qa:MeasuredQuickAddViewModel}">
            <StackPanel Margin="12" Orientation="Vertical">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{x:Static res:Strings.Abitudine_QuickAdd_RecordingFor}"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Text}"
                               Text="{Binding CompletionDate, StringFormat=d}"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding Row.Cells}"
                              ItemTemplate="{StaticResource MetricCellTemplate}"
                              Margin="0,0,0,8"/>
                <Button Content="{x:Static res:Strings.HabitScreen_QuickAdd_Save}"
                        Command="{Binding SaveCommand}"
                        HorizontalAlignment="Left" Padding="12,6"/>
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="Red" Margin="0,6,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}"/>
            </StackPanel>
        </DataTemplate>

        <!-- Resistance / abstinence: Inizio · Ricaduta + live elapsed timer. -->
        <DataTemplate x:Key="AbstinenceQuickAddTemplate" DataType="{x:Type qa:AbstinenceQuickAddViewModel}">
            <StackPanel Margin="12" Orientation="Vertical">

                <!-- Clean-for row: visible only while Abstaining -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10"
                            Visibility="{Binding CanLapse, Converter={StaticResource BoolToVisible}}">
                    <TextBlock Text="{x:Static res:Strings.Abstinence_CleanFor}"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding ElapsedDisplay}"
                               FontSize="20"
                               Foreground="{DynamicResource Brush.Text}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Relapse date: visible only when a relapse is recorded (RelapsedOn != null) -->
                <TextBlock Text="{Binding RelapsedOnDisplay}"
                           Foreground="{DynamicResource Brush.TextMuted}"
                           Margin="0,0,0,10"
                           Visibility="{Binding RelapsedOn, Converter={StaticResource NullToVisibility}}"/>

                <!-- Lapse button (danger affordance): visible when Abstaining -->
                <Button Content="{x:Static res:Strings.Abstinence_Lapse}"
                        Command="{Binding LapseCommand}"
                        HorizontalAlignment="Left" Padding="12,6" Margin="0,0,0,6"
                        Foreground="{DynamicResource Brush.Danger}"
                        Visibility="{Binding CanLapse, Converter={StaticResource BoolToVisible}}"/>

                <!-- Start / restart button: visible when not Abstaining -->
                <Button Content="{x:Static res:Strings.Abstinence_Start}"
                        Command="{Binding StartCommand}"
                        HorizontalAlignment="Left" Padding="12,6"
                        Visibility="{Binding CanStart, Converter={StaticResource BoolToVisible}}"/>

            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="CounterSeriesQuickAddTemplate" DataType="{x:Type qa:CounterSeriesQuickAddViewModel}">
            <StackPanel Margin="12" Orientation="Vertical">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{x:Static res:Strings.Abitudine_QuickAdd_RecordingFor}"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Text}"
                               Text="{Binding CompletionDate, StringFormat=d}"/>
                </Grid>
                <!-- Series chips (repeatable only): named, renamable, one selected at a time (U8). -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                            Visibility="{Binding IsRepeatable, Converter={StaticResource BoolToVisible}}">
                    <ItemsControl ItemsSource="{Binding Chips}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal"
                                                Visibility="{Binding IsEditing, Converter={StaticResource InvBoolToVisible}}">
                                        <Button Content="{Binding Name}" Padding="10,3" Cursor="Hand"
                                                Command="{Binding DataContext.SelectSeriesCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <!-- ✎ rename, only on the selected chip (same inline-edit affordance as rows) -->
                                        <Button Width="22" Height="22" Padding="0" Background="Transparent" BorderThickness="0"
                                                Content="✎" FontSize="11"
                                                ToolTip="{x:Static res:Strings.HabitScreen_QuickAdd_RenameSeries}"
                                                Command="{Binding DataContext.BeginRenameChipCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisible}}"/>
                                    </StackPanel>
                                    <TextBox Width="110"
                                             Text="{Binding PendingName, UpdateSourceTrigger=PropertyChanged}"
                                             Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisible}}">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Return"
                                                        Command="{Binding DataContext.CommitRenameChipCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                            <KeyBinding Key="Escape"
                                                        Command="{Binding DataContext.CancelRenameChipCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="{x:Static res:Strings.HabitScreen_QuickAdd_AddSeries}" Padding="8,3"
                            Command="{Binding AddSeriesCommand}"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Series}" Margin="0,0,0,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}" Padding="6" Margin="0,0,0,6" CornerRadius="3"
                                    Visibility="{Binding IsVisibleRow, Converter={StaticResource BoolToVisible}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Validity marker: ✓ when any cell carries a value, ○ otherwise (spec D6). -->
                                    <TextBlock Grid.Column="0" Width="18" TextAlignment="Center" VerticalAlignment="Top"
                                               Margin="0,4,4,0" FontSize="13"
                                               Text="{Binding IsValid, Converter={StaticResource BoolToCheckMark}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
                                                <Setter Property="Opacity" Value="0.5"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsValid}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                                                        <Setter Property="Opacity" Value="1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- WrapPanel (not horizontal StackPanel) so series cells flow to the next
                                         line instead of clipping off the right edge in a narrow column. -->
                                    <ItemsControl Grid.Column="1"
                                                  ItemsSource="{Binding Cells}"
                                                  ItemTemplate="{StaticResource MetricCellTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <!-- Per-series delete; disabled (via CanRemoveSeries) when only one series remains. -->
                                    <Button Grid.Column="2"
                                            Content="✕"
                                            Width="24" Height="24" Padding="0"
                                            VerticalAlignment="Top"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="{DynamicResource Brush.TextMuted}"
                                            ToolTip="{x:Static res:Strings.HabitScreen_QuickAdd_RemoveSeries}"
                                            Command="{Binding DataContext.RemoveSeriesCommand,
                                                      RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <!-- ContentStringFormat (not StringFormat on the Content binding): WPF ignores
                         StringFormat for a ContentControl.Content of object type, so the button showed the
                         bare count ("1") instead of "Registra 1 serie". -->
                    <Button Command="{Binding SaveCommand}" Padding="12,4">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Content" Value="{x:Static res:Strings.HabitScreen_QuickAdd_Save}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRepeatable}" Value="True">
                                        <Setter Property="Content" Value="{Binding ValidSeriesCount}"/>
                                        <Setter Property="ContentStringFormat"
                                                Value="{x:Static res:Strings.HabitScreen_QuickAdd_SaveSeries}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="Red"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="JournalQuickAddTemplate" DataType="{x:Type qa:JournalQuickAddViewModel}">
            <StackPanel Margin="12" Orientation="Vertical">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{x:Static res:Strings.Abitudine_QuickAdd_RecordingFor}"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Text}"
                               Text="{Binding CompletionDate, StringFormat=d}"/>
                </Grid>
                <ctrl:MarkdownEditorControl Markdown="{Binding Notes, Mode=TwoWay}"
                                            Availability="{Binding DataContext.Availability,
                                                           RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            Height="280"
                                            Margin="0,0,0,8"/>
                <Button Content="{x:Static res:Strings.HabitScreen_QuickAdd_Save}"
                        Command="{Binding SaveCommand}"
                        HorizontalAlignment="Left" Padding="12,6"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" Margin="0,6,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}"/>
            </StackPanel>
        </DataTemplate>

        <!-- Dedicated ✎ Diario pane (spec §3.5): same journal VM as the quick-add, but the markdown editor
             fills the pane so focus mode (⤢) becomes a wide writing surface. Keyed (not via the selector)
             and bound only from the Diario host's QuickAddForDiario, so the WebView2 editor instantiates once. -->
        <DataTemplate x:Key="JournalDiarioTemplate" DataType="{x:Type qa:JournalQuickAddViewModel}">
            <DockPanel Margin="12">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{x:Static res:Strings.Abitudine_QuickAdd_RecordingFor}"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Text}"
                               Text="{Binding CompletionDate, StringFormat=d}"/>
                </Grid>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorMessage}" Foreground="Red" Margin="0,6,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}"/>
                <Button DockPanel.Dock="Bottom" Margin="0,8,0,0"
                        Content="{x:Static res:Strings.HabitScreen_QuickAdd_Save}"
                        Command="{Binding SaveCommand}"
                        HorizontalAlignment="Left" Padding="12,6"/>
                <ctrl:MarkdownEditorControl Markdown="{Binding Notes, Mode=TwoWay}"
                                            Availability="{Binding DataContext.Availability,
                                                           RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
            </DockPanel>
        </DataTemplate>

        <!-- Composer "nota veloce" (Onda 2.4, U7): l'altra faccia della colonna Diario, mai insieme
             all'editor Markdown — vedi QuickEntryForDiario/QuickAddForDiario, mutuamente esclusivi. -->
        <DataTemplate DataType="{x:Type vmj:JournalQuickEntryViewModel}">
            <v:JournalQuickEntryView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vmn:NotesViewModel}">
            <v:NotesTabView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vmd:DetailViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Padding="12"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource Brush.Border}">
                        <StackPanel>
                            <TextBlock Text="{Binding Goal.Name}"
                                       FontWeight="SemiBold"
                                       Visibility="{Binding Goal.IsEmpty, Converter={StaticResource InvBoolToVisible}}"/>
                            <TextBlock Text="{Binding Goal.EmptyMessage}"
                                       Foreground="{DynamicResource Brush.TextMuted}"
                                       Visibility="{Binding Goal.IsEmpty, Converter={StaticResource BoolToVisible}}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                        Visibility="{Binding Goal.IsEmpty, Converter={StaticResource InvBoolToVisible}}">
                                <TextBlock Text="{Binding Goal.Actual}" FontSize="{StaticResource FontSize.Heading}"/>
                                <TextBlock Text=" / " VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Goal.Target}" FontSize="{StaticResource FontSize.Heading}"/>
                                <TextBlock Text="{Binding Goal.PeriodLabel}"
                                           Foreground="{DynamicResource Brush.TextMuted}"
                                           Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Padding="12"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource Brush.Border}"
                            Visibility="{Binding IsHabit, Converter={StaticResource BoolToVisible}}">
                        <ctrl:YearHeatmapControl DataContext="{Binding YearHeatmap}"/>
                    </Border>
                    <Border Padding="12"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource Brush.Border}"
                            Visibility="{Binding IsHabit, Converter={StaticResource BoolToVisible}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{x:Static res:Strings.Detail_Streak_Current}"
                                               Foreground="{DynamicResource Brush.TextMuted}"/>
                                    <TextBlock Text="{Binding StreakSummary.CurrentDisplay}"
                                               FontSize="{StaticResource FontSize.Heading}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Static res:Strings.Detail_Streak_Longest}"
                                               Foreground="{DynamicResource Brush.TextMuted}"/>
                                    <TextBlock Text="{Binding StreakSummary.LongestLength}"
                                               FontSize="{StaticResource FontSize.Heading}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding StreakSummary.RunsCaption}"
                                               Foreground="{DynamicResource Brush.TextMuted}"/>
                                    <TextBlock Text="{Binding StreakSummary.RunsLast90Days}"
                                               FontSize="{StaticResource FontSize.Heading}"/>
                                </StackPanel>
                            </Grid>
                            <ctrl:StreakTimelineControl DataContext="{Binding StreakTimeline}"/>
                        </StackPanel>
                    </Border>
                    <Border Padding="12"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource Brush.Border}"
                            Visibility="{Binding ShowCompletionCharts, Converter={StaticResource BoolToVisible}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                                <Button Content="{x:Static res:Strings.Detail_Trend_Range_30d}"
                                        Command="{Binding Trend.SetRangeCommand}"
                                        CommandParameter="{x:Static vmd:TrendRange.Days30}"
                                        Padding="8,4" Margin="0,0,4,0"/>
                                <Button Content="{x:Static res:Strings.Detail_Trend_Range_90d}"
                                        Command="{Binding Trend.SetRangeCommand}"
                                        CommandParameter="{x:Static vmd:TrendRange.Days90}"
                                        Padding="8,4" Margin="0,0,4,0"/>
                                <Button Content="{x:Static res:Strings.Detail_Trend_Range_1y}"
                                        Command="{Binding Trend.SetRangeCommand}"
                                        CommandParameter="{x:Static vmd:TrendRange.Year1}"
                                        Padding="8,4"/>
                            </StackPanel>
                            <ctrl:TrendChartControl DataContext="{Binding Trend}"/>
                        </StackPanel>
                    </Border>
                    <Border Padding="12"
                            Visibility="{Binding ShowCompletionCharts, Converter={StaticResource BoolToVisible}}">
                        <StackPanel>
                            <TextBlock Text="{x:Static res:Strings.Detail_Hourly_Title}"
                                       Foreground="{DynamicResource Brush.TextMuted}"
                                       Margin="0,0,0,4"/>
                            <ctrl:HourlyHistogramControl DataContext="{Binding Hourly}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <sel:QuickAddTemplateSelector x:Key="QuickAddSelector"
                                      Action="{StaticResource ActionQuickAddTemplate}"
                                      Abstinence="{StaticResource AbstinenceQuickAddTemplate}"
                                      Measured="{StaticResource MeasuredQuickAddTemplate}"
                                      CounterSeries="{StaticResource CounterSeriesQuickAddTemplate}"
                                      CounterTap="{StaticResource CounterTapQuickAddTemplate}"
                                      Journal="{StaticResource JournalQuickAddTemplate}"/>

        <!-- C1 fix: a selector (not a static ContentTemplate) for the Diario host. Verified empirically
             (a throwaway diagnostic test walking the real visual tree) that ContentPresenter.ChooseTemplate()
             applies a statically-assigned ContentTemplate even when Content is null AND the ContentControl
             itself is Visibility=Collapsed — Collapsed only skips layout/measure, it does not stop the
             DataTemplate from being chosen and its visual child (here: MarkdownEditorControl -> WebView2)
             from being built. A DataTemplateSelector, by contrast, is invoked with the actual Content
             instance and can return null for null content, so nothing is ever chosen or built. Only
             Journal is set; every other item (including null) selects null, same as QuickAddSelector's
             fallback for CounterTap/etc. above. -->
        <sel:QuickAddTemplateSelector x:Key="DiarioQuickAddSelector" Journal="{StaticResource JournalDiarioTemplate}"/>

        <!-- Column chrome (nav-model: chip-toggled side-by-side view columns). -->
        <Style x:Key="HabitScreen.Column" TargetType="Border">
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        </Style>
        <Style x:Key="HabitScreen.ColumnHeader" TargetType="Grid">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
        </Style>
        <Style x:Key="HabitScreen.ColumnTitle" TargetType="TextBlock">
            <Setter Property="Margin" Value="12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="{StaticResource FontSize.Small}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
        </Style>
        <Style x:Key="HabitScreen.ColumnClose" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Content" Value="✕"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <!-- ⤢ focus toggle in each column header (template instantiates the Path per use). -->
        <Style x:Key="HabitScreen.ColumnFocus" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="0,0,30,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <Path Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"
                                  Stroke="{DynamicResource Brush.TextMuted}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M15 3h6v6 M9 21H3v-6 M21 3l-7 7 M3 21l7-7"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.SurfaceElevated}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HabitScreen.ColumnResizeThumb" TargetType="Thumb">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="bd" Background="Transparent"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Column splitter: an invisible "sash" (the column's own 1px right border is the resting
             divider) with a roomy grab area; a thin accent bar fades in on hover and goes solid while
             dragging. Replaces the heavy solid 4px grey bar. -->
        <Style x:Key="HabitScreen.ColumnSplitter" TargetType="GridSplitter">
            <Setter Property="Width" Value="7"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
            <Setter Property="ShowsPreview" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="{TemplateBinding Background}">
                            <Border x:Name="bar" Width="2" CornerRadius="1" HorizontalAlignment="Center"
                                    Background="{DynamicResource Brush.Accent}" Opacity="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bar" Property="Opacity" Value="0.5"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="bar" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Height="3"
                Background="{Binding Node.Color, Converter={StaticResource HexToBrush}}"/>
        <Border Grid.Row="1"
                Padding="12"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource Brush.Border}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Width="22" Height="22" Margin="0,0,8,0"
                          Stretch="Uniform" VerticalAlignment="Center"
                          Stroke="{Binding Node.Color, Converter={StaticResource HexToBrush}}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Data="{Binding Node.Icon, Converter={StaticResource IconKeyToGeometry}}"
                          Visibility="{Binding Data, RelativeSource={RelativeSource Self}, Converter={StaticResource NullToVisibility}}"/>
                    <TextBlock Text="{Binding Name}"
                               FontSize="{StaticResource FontSize.Heading}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <!-- "Configura" is now a view chip below (nav-model); only Export stays here. -->
                    <Button Content="{x:Static res:Strings.Export_Button}"
                            Command="{Binding ExportCommand}"
                            Padding="10,4"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="2"
                Padding="8"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource Brush.Border}"
                Visibility="{Binding Availability.IsAvailable, Converter={StaticResource InvBoolToVisible}}">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.Editor_WebView2_NotAvailable_Body}"
                           Foreground="{DynamicResource Brush.TextMuted}"
                           TextWrapping="Wrap"/>
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                    <Hyperlink NavigateUri="https://developer.microsoft.com/microsoft-edge/webview2/"
                               RequestNavigate="OnWebView2DownloadNavigate">
                        <Run Text="{x:Static res:Strings.Editor_WebView2_NotAvailable_Download}"/>
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>
        <!-- Always-visible per-type "Oggi" strip (Onda 2.2): sits above the chip bar and outside the
             horizontal column ScrollViewer, so a habit is never a blank landing even with every column
             closed. Its DataContext is the strip VM; visibility follows ShowTodayStrip on the screen VM. -->
        <today:TodayStripView Grid.Row="3"
                              DataContext="{Binding TodayStrip}"
                              Visibility="{Binding DataContext.ShowTodayStrip,
                                           RelativeSource={RelativeSource AncestorType=UserControl},
                                           Converter={StaticResource BoolToVisible}}"/>

        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- In focus mode the chip bar is replaced by a return affordance (spec §3.6). -->
            <Button Grid.Row="0" HorizontalAlignment="Left" Margin="12,8,12,4"
                    Padding="8,3" Cursor="Hand"
                    Background="Transparent" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}"
                    Foreground="{DynamicResource Brush.TextMuted}"
                    Content="{x:Static res:Strings.HabitScreen_ExitFocus}"
                    Command="{Binding ExitFocusCommand}"
                    Visibility="{Binding IsFocusActive, Converter={StaticResource BoolToVisible}}"/>

            <!-- Chip bar: independent view toggles (nav-model). Panoramica only for groups,
                 Cronologia/Dettaglio only for habits (spec §A.1). -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,8,12,4"
                        Visibility="{Binding ShowChipBar, Converter={StaticResource BoolToVisible}}">
                <CheckBox Style="{StaticResource Recordum.SegmentCheck}"
                          Content="{x:Static res:Strings.HabitScreen_Column_Panoramica}"
                          IsChecked="{Binding IsPanoramicaOpen}"
                          Visibility="{Binding IsGroupNode, Converter={StaticResource BoolToVisible}}"/>
                <CheckBox Style="{StaticResource Recordum.SegmentCheck}" Margin="0,0,4,0"
                          Content="{x:Static res:Strings.HabitScreen_Column_Diario}"
                          IsChecked="{Binding IsDiarioOpen}"
                          Visibility="{Binding IsJournal, Converter={StaticResource BoolToVisible}}"/>
                <CheckBox Style="{StaticResource Recordum.SegmentCheck}"
                          Content="{x:Static res:Strings.HabitScreen_Column_Cronologia}"
                          IsChecked="{Binding IsCronologiaOpen}"
                          Visibility="{Binding IsGroupNode, Converter={StaticResource InvBoolToVisible}}"/>
                <CheckBox Style="{StaticResource Recordum.SegmentCheck}" Margin="4,0,0,0"
                          Content="{x:Static res:Strings.HabitScreen_Tab_Detail}"
                          IsChecked="{Binding IsDettaglioOpen}"
                          Visibility="{Binding IsGroupNode, Converter={StaticResource InvBoolToVisible}}"/>
                <CheckBox Style="{StaticResource Recordum.SegmentCheck}" Margin="4,0,0,0"
                          Content="{x:Static res:Strings.HabitScreen_Tab_Notes}"
                          IsChecked="{Binding IsNoteOpen}"/>
                <CheckBox Style="{StaticResource Recordum.SegmentCheck}" Margin="4,0,0,0"
                          Content="{x:Static res:Strings.HabitScreen_Configure}"
                          IsChecked="{Binding IsConfiguraOpen}"/>
            </StackPanel>

            <!-- Hybrid "fill-then-scroll" (restores the horizontal column scroll lost when f08fba9
                 switched to a pure star-split): the inner Grid is bound to the host ScrollViewer's
                 ViewportWidth, so with room the open panes star-split it and leave no gap; its
                 MinWidth = open count × 320 means once the panes no longer fit, the ScrollViewer
                 scrolls horizontally instead of squeezing them below 320. A splitter shows only
                 between two adjacent open panes. -->
            <ScrollViewer Grid.Row="1" x:Name="ColumnsScroll"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <Grid Width="{Binding ViewportWidth, ElementName=ColumnsScroll}"
                  MinWidth="{Binding OpenColumnsMinWidth}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding ShowPanoramica, Converter={StaticResource OpenColumnWidth}}"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="{Binding ShowDiario, Converter={StaticResource OpenColumnWidth}}"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="{Binding ShowCronologia, Converter={StaticResource OpenColumnWidth}}"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="{Binding ShowDettaglio, Converter={StaticResource OpenColumnWidth}}"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="{Binding ShowNote, Converter={StaticResource OpenColumnWidth}}"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="{Binding ShowConfigura, Converter={StaticResource OpenColumnWidth}}"/>
                </Grid.ColumnDefinitions>

                <!-- Panoramica|Diario: mutually exclusive subject types, so never both visible. -->
                <GridSplitter Grid.Column="1" Style="{StaticResource HabitScreen.ColumnSplitter}">
                    <GridSplitter.Visibility>
                        <MultiBinding Converter="{StaticResource AllTrueToVisible}">
                            <Binding Path="ShowPanoramica"/><Binding Path="ShowDiario"/>
                        </MultiBinding>
                    </GridSplitter.Visibility>
                </GridSplitter>
                <GridSplitter Grid.Column="3" Style="{StaticResource HabitScreen.ColumnSplitter}">
                    <GridSplitter.Visibility>
                        <MultiBinding Converter="{StaticResource AllTrueToVisible}">
                            <Binding Path="ShowDiario"/><Binding Path="ShowCronologia"/>
                        </MultiBinding>
                    </GridSplitter.Visibility>
                </GridSplitter>
                <GridSplitter Grid.Column="5" Style="{StaticResource HabitScreen.ColumnSplitter}">
                    <GridSplitter.Visibility>
                        <MultiBinding Converter="{StaticResource AllTrueToVisible}">
                            <Binding Path="ShowCronologia"/><Binding Path="ShowDettaglio"/>
                        </MultiBinding>
                    </GridSplitter.Visibility>
                </GridSplitter>
                <GridSplitter Grid.Column="7" Style="{StaticResource HabitScreen.ColumnSplitter}">
                    <GridSplitter.Visibility>
                        <MultiBinding Converter="{StaticResource AllTrueToVisible}">
                            <Binding Path="ShowDettaglio"/><Binding Path="ShowNote"/>
                        </MultiBinding>
                    </GridSplitter.Visibility>
                </GridSplitter>
                <GridSplitter Grid.Column="9" Style="{StaticResource HabitScreen.ColumnSplitter}">
                    <GridSplitter.Visibility>
                        <MultiBinding Converter="{StaticResource AllTrueToVisible}">
                            <Binding Path="ShowNote"/><Binding Path="ShowConfigura"/>
                        </MultiBinding>
                    </GridSplitter.Visibility>
                </GridSplitter>

                    <!-- Panoramica (group overview, spec §A.2) -->
                    <Border Grid.Column="0" Style="{StaticResource HabitScreen.Column}"
                            Visibility="{Binding ShowPanoramica, Converter={StaticResource BoolToVisible}}">
                        <Grid>
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Style="{StaticResource HabitScreen.ColumnHeader}">
                                    <TextBlock Text="{x:Static res:Strings.HabitScreen_Column_Panoramica}" Style="{StaticResource HabitScreen.ColumnTitle}"/>
                                    <Button Style="{StaticResource HabitScreen.ColumnFocus}"
                                            ToolTip="{x:Static res:Strings.HabitScreen_Focus}"
                                            Command="{Binding ToggleFocusCommand}"
                                            CommandParameter="{x:Static vm:HabitColumn.Panoramica}"/>
                                    <Button Style="{StaticResource HabitScreen.ColumnClose}"
                                            Command="{Binding ToggleColumnCommand}"
                                            CommandParameter="{x:Static vm:HabitColumn.Panoramica}"/>
                                </Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel DataContext="{Binding Panoramica}" Margin="12">
                                        <!-- Group goal card (same markup family as the Detail column) -->
                                        <StackPanel Margin="0,0,0,12"
                                                    Visibility="{Binding Goal.IsEmpty, Converter={StaticResource InvBoolToVisible}}">
                                            <TextBlock Text="{Binding Goal.Name}" FontWeight="SemiBold"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding Goal.Actual}" FontSize="{StaticResource FontSize.Heading}"/>
                                                <TextBlock Text=" / " VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Goal.Target}" FontSize="{StaticResource FontSize.Heading}"/>
                                                <TextBlock Text="{Binding Goal.PeriodLabel}" Foreground="{DynamicResource Brush.TextMuted}"
                                                           Margin="12,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <!-- Today rollup -->
                                        <TextBlock Text="{Binding TodayLabel}" FontWeight="SemiBold" Margin="0,0,0,8"
                                                   Foreground="{DynamicResource Brush.Text}"/>
                                        <TextBlock Text="{x:Static res:Strings.HabitScreen_Panoramica_Empty}"
                                                   Foreground="{DynamicResource Brush.TextMuted}"
                                                   Visibility="{Binding HasChildren, Converter={StaticResource InvBoolToVisible}}"/>
                                        <!-- Child habit rows: click navigates to the habit (spec §A.3) -->
                                        <ItemsControl ItemsSource="{Binding Children}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.SelectChildCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Background="Transparent" BorderThickness="0" Padding="0"
                                                            Margin="{Binding Indent, Converter={StaticResource IndentToMargin}}"
                                                            HorizontalContentAlignment="Stretch" Cursor="Hand">
                                                        <Grid Height="32">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Rectangle Width="4" RadiusX="1" RadiusY="1" Margin="0,4"
                                                                       Fill="{Binding ColorHex, Converter={StaticResource HexToBrush}}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="8,0,0,0"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource Brush.Text}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <!-- Habits: sparkline + today check. Subgroups: child count instead. -->
                                                            <TextBlock Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Center"
                                                                       FontSize="{StaticResource FontSize.Small}" Opacity="0.6"
                                                                       Foreground="{DynamicResource Brush.TextMuted}"
                                                                       Text="{Binding ChildCount, StringFormat={x:Static res:Strings.Home_GroupChildCount_Format}}"
                                                                       Visibility="{Binding IsGroup, Converter={StaticResource BoolToVisible}}"/>
                                                            <ve:HeatmapStrip Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Center"
                                                                             Counts="{Binding CompletionsLast7Days}"
                                                                             AccentColor="{Binding ColorHex}"
                                                                             Visibility="{Binding IsGroup, Converter={StaticResource InvBoolToVisible}}"/>
                                                            <TextBlock Grid.Column="3" Text="✓" Margin="0,0,4,0" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource Brush.Accent}"
                                                                       Visibility="{Binding IsCompletedToday, Converter={StaticResource BoolToVisible}}"/>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <!-- ✎ Diario (journal-only writing surface, spec §3.5). The editor is hosted only here,
                         and — for a quick-note journal — never materialized at all (DiarioQuickAddSelector
                         below, C1). -->
                    <Border x:Name="DiarioColumn" Grid.Column="2" Style="{StaticResource HabitScreen.Column}"
                            Visibility="{Binding ShowDiario, Converter={StaticResource BoolToVisible}}">
                        <Grid>
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Style="{StaticResource HabitScreen.ColumnHeader}">
                                    <TextBlock Text="{x:Static res:Strings.HabitScreen_Column_Diario}" Style="{StaticResource HabitScreen.ColumnTitle}"/>
                                    <Button Style="{StaticResource HabitScreen.ColumnFocus}"
                                            ToolTip="{x:Static res:Strings.HabitScreen_Focus}"
                                            Command="{Binding ToggleFocusCommand}"
                                            CommandParameter="{x:Static vm:HabitColumn.Diario}"/>
                                    <Button Style="{StaticResource HabitScreen.ColumnClose}"
                                            Command="{Binding ToggleColumnCommand}"
                                            CommandParameter="{x:Static vm:HabitColumn.Diario}"/>
                                </Grid>
                                <!-- La colonna ospita O il composer nota-veloce O l'editor Markdown, mai
                                     entrambi (Onda 2.4). Il primo host usa un ContentTemplateSelector
                                     (DiarioQuickAddSelector), non un ContentTemplate statico: con un
                                     ContentTemplate statico, ContentPresenter.ChooseTemplate() applica
                                     comunque il template quando Content e' null — verificato empiricamente
                                     che perfino Visibility=Collapsed sull'host NON basta a impedirlo (misura/
                                     layout sono saltati, ma la scelta+costruzione del template no) — quindi
                                     il MarkdownEditorControl/WebView2 si istanzierebbe comunque su una nota
                                     veloce (finding C1). Il selector, invocato con l'istanza reale di Content,
                                     restituisce null per Content null e non sceglie/costruisce nulla. Il
                                     secondo host non ha questo problema: il suo DataTemplate e' implicito
                                     (per DataType, non x:Key) e la risoluzione implicita gia' salta un
                                     Content nullo. Visibility resta comunque come guardia difensiva. -->
                                <Grid>
                                    <ContentControl Content="{Binding QuickAddForDiario}"
                                                    ContentTemplateSelector="{StaticResource DiarioQuickAddSelector}"
                                                    Visibility="{Binding QuickAddForDiario, Converter={StaticResource NullToVisibility}}"/>
                                    <ContentControl Content="{Binding QuickEntryForDiario}"
                                                    Visibility="{Binding QuickEntryForDiario, Converter={StaticResource NullToVisibility}}"/>
                                </Grid>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <!-- Cronologia -->
                    <Border Grid.Column="4" Style="{StaticResource HabitScreen.Column}"
                            Visibility="{Binding ShowCronologia, Converter={StaticResource BoolToVisible}}">
                        <Grid>
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Style="{StaticResource HabitScreen.ColumnHeader}">
                                    <TextBlock Text="{x:Static res:Strings.HabitScreen_Column_Cronologia}" Style="{StaticResource HabitScreen.ColumnTitle}"/>
                                    <Button Style="{StaticResource HabitScreen.ColumnFocus}"
                                            ToolTip="{x:Static res:Strings.HabitScreen_Focus}"
                                            Command="{Binding ToggleFocusCommand}"
                                            CommandParameter="{x:Static vm:HabitColumn.Cronologia}"/>
                                    <Button Style="{StaticResource HabitScreen.ColumnClose}"
                                            Command="{Binding ToggleColumnCommand}"
                                            CommandParameter="{x:Static vm:HabitColumn.Cronologia}"/>
                                </Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <cal:CalendarNavigator DataContext="{Binding Calendar}"/>
                                        <!-- Journal habits write in the ✎ Diario pane; here Cronologia stays
                                             calendar + list only (QuickAddForCronologia is null for journals). -->
                                        <ContentControl Content="{Binding QuickAddForCronologia}"
                                                        ContentTemplateSelector="{StaticResource QuickAddSelector}"/>
                                        <ContentControl Content="{Binding TimerControl}"/>
                                        <v:DayNoteView DataContext="{Binding DayNote}"/>
                                        <StackPanel Margin="12,4,12,12">
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock Text="{x:Static res:Strings.HabitScreen_Records}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush.Text}"
                                                           VerticalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <RadioButton Content="{x:Static res:Strings.Records_Mode_Day}"
                                                                 GroupName="RecordsMode"
                                                                 IsChecked="{Binding Records.Mode, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static vm:EntriesRecordsMode.Giorno}}"/>
                                                    <RadioButton Content="{x:Static res:Strings.Records_Mode_Period}"
                                                                 GroupName="RecordsMode" Margin="8,0,0,0"
                                                                 IsChecked="{Binding Records.Mode, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static vm:EntriesRecordsMode.Periodo}}"/>
                                                </StackPanel>
                                            </DockPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                                                        Visibility="{Binding Records.Mode, Converter={StaticResource EnumToVisibility}, ConverterParameter={x:Static vm:EntriesRecordsMode.Periodo}}">
                                                <ComboBox ItemsSource="{Binding Source={StaticResource EntriesPeriodValues}}"
                                                          SelectedItem="{Binding Records.SelectedPeriod}"
                                                          MinWidth="120">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Converter={StaticResource EntriesPeriodLabel}}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <StackPanel Orientation="Horizontal" Margin="8,0,0,0"
                                                            Visibility="{Binding Records.SelectedPeriod, Converter={StaticResource EnumToVisibility}, ConverterParameter={x:Static enums:EntriesPeriod.Personalizzato}}">
                                                    <TextBlock Text="{x:Static res:Strings.Period_From}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <DatePicker SelectedDate="{Binding Records.CustomFrom, Converter={StaticResource DateOnlyToDateTime}}"/>
                                                    <TextBlock Text="{x:Static res:Strings.Period_To}" VerticalAlignment="Center" Margin="6,0,4,0"/>
                                                    <DatePicker SelectedDate="{Binding Records.CustomTo, Converter={StaticResource DateOnlyToDateTime}}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Text="{x:Static res:Strings.HabitScreen_DayRecords_Empty}"
                                                       Foreground="{DynamicResource Brush.TextMuted}"
                                                       FontSize="{StaticResource FontSize.Small}"
                                                       Visibility="{Binding Records.IsEmpty, Converter={StaticResource BoolToVisible}}"/>
                                            <ContentControl Content="{Binding Records.CurrentList}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <!-- Dettaglio -->
                    <Border Grid.Column="6" Style="{StaticResource HabitScreen.Column}"
                            Visibility="{Binding ShowDettaglio, Converter={StaticResource BoolToVisible}}">
                        <Grid>
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Style="{StaticResource HabitScreen.ColumnHeader}">
                                    <TextBlock Text="{x:Static res:Strings.HabitScreen_Tab_Detail}" Style="{StaticResource HabitScreen.ColumnTitle}"/>
                                    <Button Style="{StaticResource HabitScreen.ColumnFocus}"
                                            ToolTip="{x:Static res:Strings.HabitScreen_Focus}"
                                            Command="{Binding ToggleFocusCommand}"
                                            CommandParameter="{x:Static vm:HabitColumn.Dettaglio}"/>
                                    <Button Style="{StaticResource HabitScreen.ColumnClose}"
                                            Command="{Binding ToggleColumnCommand}"
                                            CommandParameter="{x:Static vm:HabitColumn.Dettaglio}"/>
                                </Grid>
                                <ContentControl Content="{Binding Detail}"/>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <!-- Note -->
                    <Border Grid.Column="8" Style="{StaticResource HabitScreen.Column}"
                            Visibility="{Binding ShowNote, Converter={StaticResource BoolToVisible}}">
                        <Grid>
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Style="{StaticResource HabitScreen.ColumnHeader}">
                                    <TextBlock Text="{x:Static res:Strings.HabitScreen_Tab_Notes}" Style="{StaticResource HabitScreen.ColumnTitle}"/>
                                    <Button Style="{StaticResource HabitScreen.ColumnFocus}"
                                            ToolTip="{x:Static res:Strings.HabitScreen_Focus}"
                                            Command="{Binding ToggleFocusCommand}"
                                            CommandParameter="{x:Static vm:HabitColumn.Note}"/>
                                    <Button Style="{StaticResource HabitScreen.ColumnClose}"
                                            Command="{Binding ToggleColumnCommand}"
                                            CommandParameter="{x:Static vm:HabitColumn.Note}"/>
                                </Grid>
                                <ContentControl Content="{Binding Notes}"/>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <!-- Configura (the habit editor) -->
                    <Border Grid.Column="10" Style="{StaticResource HabitScreen.Column}"
                            Visibility="{Binding ShowConfigura, Converter={StaticResource BoolToVisible}}">
                        <Grid>
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Style="{StaticResource HabitScreen.ColumnHeader}">
                                    <TextBlock Text="{x:Static res:Strings.HabitScreen_Configure}" Style="{StaticResource HabitScreen.ColumnTitle}"/>
                                    <Button Style="{StaticResource HabitScreen.ColumnFocus}"
                                            ToolTip="{x:Static res:Strings.HabitScreen_Focus}"
                                            Command="{Binding ToggleFocusCommand}"
                                            CommandParameter="{x:Static vm:HabitColumn.Configura}"/>
                                    <Button Style="{StaticResource HabitScreen.ColumnClose}"
                                            Command="{Binding ToggleColumnCommand}"
                                            CommandParameter="{x:Static vm:HabitColumn.Configura}"/>
                                </Grid>
                                <ve:EditorPane DataContext="{Binding Editor}"/>
                            </DockPanel>
                        </Grid>
                    </Border>

            </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
