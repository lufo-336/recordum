<UserControl x:Class="Recordum.WPF.Views.HabitScreen.HabitScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Recordum.WPF.ViewModels.HabitScreen"
             xmlns:qa="clr-namespace:Recordum.WPF.ViewModels.HabitScreen.QuickAdd"
             xmlns:vmn="clr-namespace:Recordum.WPF.ViewModels.HabitScreen.Notes"
             xmlns:vmd="clr-namespace:Recordum.WPF.ViewModels.HabitScreen.Detail"
             xmlns:v="clr-namespace:Recordum.WPF.Views.HabitScreen"
             xmlns:ve="clr-namespace:Recordum.WPF.Views"
             xmlns:cal="clr-namespace:Recordum.WPF.Views.HabitScreen.Calendar"
             xmlns:ctrl="clr-namespace:Recordum.WPF.Controls"
             xmlns:sel="clr-namespace:Recordum.WPF.Selectors"
             xmlns:res="clr-namespace:Recordum.WPF.Resources"
             xmlns:helpers="clr-namespace:Recordum.WPF.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:HabitScreenViewModel, IsDesignTimeCreatable=False}"
             Background="{DynamicResource Brush.Surface}">
    <UserControl.Resources>

        <!-- Habit color identity: every Brush.Accent consumer inside this screen (button hover/focus
             borders, text selection, calendar today/selected) re-resolves to the habit color. The
             proxy bridges Node.Color into the resource scope (resources have no DataContext). -->
        <helpers:BindingProxy x:Key="HabitColorProxy" Data="{Binding Node.Color}"/>
        <SolidColorBrush x:Key="Brush.Accent"
                         Color="{Binding Data, Source={StaticResource HabitColorProxy},
                                 Converter={StaticResource HexToColor}}"/>

        <DataTemplate DataType="{x:Type vm:TimerControlViewModel}">
            <Border Padding="12,8"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource Brush.Border}"
                    Visibility="{Binding IsApplicable, Converter={StaticResource BoolToVisible}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="{Binding ElapsedDisplay}"
                                   FontFamily="Consolas"
                                   FontSize="{StaticResource FontSize.Heading}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <Button Content="{x:Static res:Strings.HabitScreen_Timer_Start}"
                                Command="{Binding StartCommand}" Padding="10,4" Margin="0,0,6,0"/>
                        <Button Content="{x:Static res:Strings.HabitScreen_Timer_Pause}"
                                Command="{Binding PauseCommand}" Padding="10,4" Margin="0,0,6,0"
                                Visibility="{Binding IsPaused, Converter={StaticResource InvBoolToVisible}}"/>
                        <Button Content="{x:Static res:Strings.HabitScreen_Timer_Resume}"
                                Command="{Binding ResumeCommand}" Padding="10,4" Margin="0,0,6,0"
                                Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisible}}"/>
                        <Button Content="{x:Static res:Strings.HabitScreen_Timer_Stop}"
                                Command="{Binding StopCommand}" Padding="10,4" Margin="0,0,6,0"/>
                        <Button Content="{x:Static res:Strings.HabitScreen_Timer_NextSegment}"
                                Command="{Binding NextSegmentCommand}" Padding="10,4"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Segments}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="6,2" Margin="0,0,6,0"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource Brush.Border}"
                                        CornerRadius="3">
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Brush.TextMuted}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:CompletionListViewModel}">
            <Border Padding="12">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CompletionRowViewModel}">
                            <Border BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource Brush.Border}"
                                    Padding="0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Display}" FontWeight="SemiBold"/>
                                        <ItemsControl ItemsSource="{Binding FieldDisplays}"
                                                      Visibility="{Binding HasFieldDisplays, Converter={StaticResource BoolToVisible}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource Brush.Text}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding Notes}"
                                                   Foreground="{DynamicResource Brush.TextMuted}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding Notes, Converter={StaticResource NullToVisibility}}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="✎"
                                            Command="{Binding BeginEditCommand}"
                                            Width="28" Height="28"
                                            Background="Transparent" BorderThickness="0"/>
                                    <Button Grid.Column="2"
                                            Content="✕"
                                            Command="{Binding DeleteCommand}"
                                            Width="28" Height="28"
                                            Background="Transparent" BorderThickness="0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ActionQuickAddTemplate" DataType="{x:Type qa:ActionQuickAddViewModel}">
            <StackPanel Margin="12" Orientation="Vertical">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{x:Static res:Strings.Abitudine_QuickAdd_RecordingFor}"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Text}"
                               Text="{Binding CompletionDate, StringFormat=d}"/>
                </Grid>
                <Button Content="{x:Static res:Strings.HabitScreen_QuickAdd_Action_Mark}"
                        Command="{Binding SaveCommand}"
                        HorizontalAlignment="Left"
                        Padding="12,6"/>
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="Red"
                           Margin="0,6,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}"/>
            </StackPanel>
        </DataTemplate>

        <!-- Kind-aware input cell for one metric: measured (numeric + unit), scale (labelled selector or slider), or text.
             Horizontal: [Name] [input] [unit]. Stacked vertically in Measured, side-by-side in Resistance series rows. -->
        <DataTemplate x:Key="MetricCellTemplate" DataType="{x:Type qa:SeriesCellViewModel}">
            <StackPanel Orientation="Horizontal" Margin="0,3,12,3" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" MinWidth="110" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{DynamicResource Brush.TextMuted}"/>
                <Grid VerticalAlignment="Center">
                    <!-- Measured: Integer/Seconds -->
                    <TextBox Width="90"
                             Text="{Binding IntegerValue, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Kind}" Value="Measured"/>
                                            <Condition Binding="{Binding Type}" Value="Integer"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Kind}" Value="Measured"/>
                                            <Condition Binding="{Binding Type}" Value="Seconds"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <!-- Measured: Decimal -->
                    <TextBox Width="90"
                             Text="{Binding DecimalValue, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Kind}" Value="Measured"/>
                                            <Condition Binding="{Binding Type}" Value="Decimal"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <!-- Text -->
                    <TextBox Width="140" Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="Text">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <!-- Scale: segmented selectable buttons (<=10 steps). A ListBox gives single-selection for
                         free; SelectedIndex two-way binds to the 0-based step (same binding the dropdown used). -->
                    <ListBox ItemsSource="{Binding ScaleLabels}" SelectedIndex="{Binding SelectedScaleIndex}"
                             BorderThickness="0" Background="Transparent" Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.Style>
                            <Style TargetType="ListBox">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Kind}" Value="Scale"/>
                                            <Condition Binding="{Binding UseSlider}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,4,4"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" CornerRadius="4" Padding="11,4" BorderThickness="1"
                                                    Background="{DynamicResource Brush.SurfaceElevated}"
                                                    BorderBrush="{DynamicResource Brush.Border}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <!-- Scale: slider (>10 steps) -->
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Kind}" Value="Scale"/>
                                            <Condition Binding="{Binding UseSlider}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Slider Width="140" Minimum="0" Maximum="{Binding SliderMax}"
                                Value="{Binding SelectedScaleIndex, TargetNullValue=0}"
                                IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"/>
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Text}"
                                   Text="{Binding SelectedScaleLabel}"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding UnitLabel}" Margin="6,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextMuted}"
                           Visibility="{Binding UnitLabel, Converter={StaticResource NullToVisibility}}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="MeasuredQuickAddTemplate" DataType="{x:Type qa:MeasuredQuickAddViewModel}">
            <StackPanel Margin="12" Orientation="Vertical">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{x:Static res:Strings.Abitudine_QuickAdd_RecordingFor}"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Text}"
                               Text="{Binding CompletionDate, StringFormat=d}"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding Row.Cells}"
                              ItemTemplate="{StaticResource MetricCellTemplate}"
                              Margin="0,0,0,8"/>
                <Button Content="{x:Static res:Strings.HabitScreen_QuickAdd_Save}"
                        Command="{Binding SaveCommand}"
                        HorizontalAlignment="Left" Padding="12,6"/>
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="Red" Margin="0,6,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ResistanceQuickAddTemplate" DataType="{x:Type qa:ResistanceQuickAddViewModel}">
            <StackPanel Margin="12" Orientation="Vertical">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{x:Static res:Strings.Abitudine_QuickAdd_RecordingFor}"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Text}"
                               Text="{Binding CompletionDate, StringFormat=d}"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding Series}" Margin="0,0,0,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}" Padding="6" Margin="0,0,0,6" CornerRadius="3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- WrapPanel (not horizontal StackPanel) so series cells flow to the next
                                         line instead of clipping off the right edge in a narrow column. -->
                                    <ItemsControl Grid.Column="0"
                                                  ItemsSource="{Binding Cells}"
                                                  ItemTemplate="{StaticResource MetricCellTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <!-- Per-series delete; disabled (via CanRemoveSeries) when only one series remains. -->
                                    <Button Grid.Column="1"
                                            Content="✕"
                                            Width="24" Height="24" Padding="0"
                                            VerticalAlignment="Top"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="{DynamicResource Brush.TextMuted}"
                                            ToolTip="{x:Static res:Strings.HabitScreen_QuickAdd_RemoveSeries}"
                                            Command="{Binding DataContext.RemoveSeriesCommand,
                                                      RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="{x:Static res:Strings.HabitScreen_QuickAdd_AddSeries}"
                            Command="{Binding AddSeriesCommand}" Padding="8,4" Margin="0,0,8,0"/>
                    <Button Content="{x:Static res:Strings.HabitScreen_QuickAdd_Save}"
                            Command="{Binding SaveCommand}" Padding="12,4"/>
                </StackPanel>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="Red"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="JournalQuickAddTemplate" DataType="{x:Type qa:JournalQuickAddViewModel}">
            <StackPanel Margin="12" Orientation="Vertical">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{x:Static res:Strings.Abitudine_QuickAdd_RecordingFor}"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Text}"
                               Text="{Binding CompletionDate, StringFormat=d}"/>
                </Grid>
                <ctrl:MarkdownEditorControl Markdown="{Binding Notes, Mode=TwoWay}"
                                            Availability="{Binding DataContext.Availability,
                                                           RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            Height="280"
                                            Margin="0,0,0,8"/>
                <Button Content="{x:Static res:Strings.HabitScreen_QuickAdd_Save}"
                        Command="{Binding SaveCommand}"
                        HorizontalAlignment="Left" Padding="12,6"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" Margin="0,6,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vmn:NotesViewModel}">
            <v:NotesTabView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vmd:DetailViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Padding="12"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource Brush.Border}">
                        <StackPanel>
                            <TextBlock Text="{Binding Goal.Name}"
                                       FontWeight="SemiBold"
                                       Visibility="{Binding Goal.IsEmpty, Converter={StaticResource InvBoolToVisible}}"/>
                            <TextBlock Text="{Binding Goal.EmptyMessage}"
                                       Foreground="{DynamicResource Brush.TextMuted}"
                                       Visibility="{Binding Goal.IsEmpty, Converter={StaticResource BoolToVisible}}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                        Visibility="{Binding Goal.IsEmpty, Converter={StaticResource InvBoolToVisible}}">
                                <TextBlock Text="{Binding Goal.Actual}" FontSize="{StaticResource FontSize.Heading}"/>
                                <TextBlock Text=" / " VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Goal.Target}" FontSize="{StaticResource FontSize.Heading}"/>
                                <TextBlock Text="{Binding Goal.PeriodLabel}"
                                           Foreground="{DynamicResource Brush.TextMuted}"
                                           Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Padding="12"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource Brush.Border}"
                            Visibility="{Binding IsHabit, Converter={StaticResource BoolToVisible}}">
                        <ctrl:YearHeatmapControl DataContext="{Binding YearHeatmap}"/>
                    </Border>
                    <Border Padding="12"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource Brush.Border}"
                            Visibility="{Binding IsHabit, Converter={StaticResource BoolToVisible}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{x:Static res:Strings.Detail_Streak_Current}"
                                               Foreground="{DynamicResource Brush.TextMuted}"/>
                                    <TextBlock Text="{Binding StreakSummary.CurrentLength}"
                                               FontSize="{StaticResource FontSize.Heading}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Static res:Strings.Detail_Streak_Longest}"
                                               Foreground="{DynamicResource Brush.TextMuted}"/>
                                    <TextBlock Text="{Binding StreakSummary.LongestLength}"
                                               FontSize="{StaticResource FontSize.Heading}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{x:Static res:Strings.Detail_Streak_Runs90}"
                                               Foreground="{DynamicResource Brush.TextMuted}"/>
                                    <TextBlock Text="{Binding StreakSummary.RunsLast90Days}"
                                               FontSize="{StaticResource FontSize.Heading}"/>
                                </StackPanel>
                            </Grid>
                            <ctrl:StreakTimelineControl DataContext="{Binding StreakTimeline}"/>
                        </StackPanel>
                    </Border>
                    <Border Padding="12"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource Brush.Border}"
                            Visibility="{Binding IsHabit, Converter={StaticResource BoolToVisible}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                                <Button Content="{x:Static res:Strings.Detail_Trend_Range_30d}"
                                        Command="{Binding Trend.SetRangeCommand}"
                                        CommandParameter="{x:Static vmd:TrendRange.Days30}"
                                        Padding="8,4" Margin="0,0,4,0"/>
                                <Button Content="{x:Static res:Strings.Detail_Trend_Range_90d}"
                                        Command="{Binding Trend.SetRangeCommand}"
                                        CommandParameter="{x:Static vmd:TrendRange.Days90}"
                                        Padding="8,4" Margin="0,0,4,0"/>
                                <Button Content="{x:Static res:Strings.Detail_Trend_Range_1y}"
                                        Command="{Binding Trend.SetRangeCommand}"
                                        CommandParameter="{x:Static vmd:TrendRange.Year1}"
                                        Padding="8,4"/>
                            </StackPanel>
                            <ctrl:TrendChartControl DataContext="{Binding Trend}"/>
                        </StackPanel>
                    </Border>
                    <Border Padding="12"
                            Visibility="{Binding IsHabit, Converter={StaticResource BoolToVisible}}">
                        <StackPanel>
                            <TextBlock Text="{x:Static res:Strings.Detail_Hourly_Title}"
                                       Foreground="{DynamicResource Brush.TextMuted}"
                                       Margin="0,0,0,4"/>
                            <ctrl:HourlyHistogramControl DataContext="{Binding Hourly}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <sel:QuickAddTemplateSelector x:Key="QuickAddSelector"
                                      Action="{StaticResource ActionQuickAddTemplate}"
                                      Measured="{StaticResource MeasuredQuickAddTemplate}"
                                      Resistance="{StaticResource ResistanceQuickAddTemplate}"
                                      Journal="{StaticResource JournalQuickAddTemplate}"/>

        <!-- Column chrome (nav-model: chip-toggled side-by-side view columns). -->
        <Style x:Key="HabitScreen.Column" TargetType="Border">
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        </Style>
        <Style x:Key="HabitScreen.ColumnHeader" TargetType="Grid">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
        </Style>
        <Style x:Key="HabitScreen.ColumnTitle" TargetType="TextBlock">
            <Setter Property="Margin" Value="12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="{StaticResource FontSize.Small}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
        </Style>
        <Style x:Key="HabitScreen.ColumnClose" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Content" Value="✕"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Height="3"
                Background="{Binding Node.Color, Converter={StaticResource HexToBrush}}"/>
        <Border Grid.Row="1"
                Padding="12"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource Brush.Border}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Width="22" Height="22" Margin="0,0,8,0"
                          Stretch="Uniform" VerticalAlignment="Center"
                          Stroke="{Binding Node.Color, Converter={StaticResource HexToBrush}}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Data="{Binding Node.Icon, Converter={StaticResource IconKeyToGeometry}}"
                          Visibility="{Binding Data, RelativeSource={RelativeSource Self}, Converter={StaticResource NullToVisibility}}"/>
                    <TextBlock Text="{Binding Name}"
                               FontSize="{StaticResource FontSize.Heading}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <!-- "Configura" is now a view chip below (nav-model); only Export stays here. -->
                    <Button Content="{x:Static res:Strings.Export_Button}"
                            Command="{Binding ExportCommand}"
                            Padding="10,4"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="2"
                Padding="8"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource Brush.Border}"
                Visibility="{Binding Availability.IsAvailable, Converter={StaticResource InvBoolToVisible}}">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.Editor_WebView2_NotAvailable_Body}"
                           Foreground="{DynamicResource Brush.TextMuted}"
                           TextWrapping="Wrap"/>
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                    <Hyperlink NavigateUri="https://developer.microsoft.com/microsoft-edge/webview2/"
                               RequestNavigate="OnWebView2DownloadNavigate">
                        <Run Text="{x:Static res:Strings.Editor_WebView2_NotAvailable_Download}"/>
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Chip bar: independent view toggles (nav-model). -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,8,12,4">
                <CheckBox Style="{StaticResource Recordum.SegmentCheck}"
                          Content="{x:Static res:Strings.HabitScreen_Column_Cronologia}"
                          IsChecked="{Binding IsCronologiaOpen}"/>
                <CheckBox Style="{StaticResource Recordum.SegmentCheck}" Margin="4,0,0,0"
                          Content="{x:Static res:Strings.HabitScreen_Tab_Detail}"
                          IsChecked="{Binding IsDettaglioOpen}"/>
                <CheckBox Style="{StaticResource Recordum.SegmentCheck}" Margin="4,0,0,0"
                          Content="{x:Static res:Strings.HabitScreen_Tab_Notes}"
                          IsChecked="{Binding IsNoteOpen}"/>
                <CheckBox Style="{StaticResource Recordum.SegmentCheck}" Margin="4,0,0,0"
                          Content="{x:Static res:Strings.HabitScreen_Configure}"
                          IsChecked="{Binding IsConfiguraOpen}"/>
            </StackPanel>

            <!-- Open columns, side by side, horizontal scroll when they overflow (nav-model §3.8). -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">

                    <!-- Cronologia -->
                    <Border Width="460" Style="{StaticResource HabitScreen.Column}"
                            Visibility="{Binding IsCronologiaOpen, Converter={StaticResource BoolToVisible}}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Style="{StaticResource HabitScreen.ColumnHeader}">
                                <TextBlock Text="{x:Static res:Strings.HabitScreen_Column_Cronologia}" Style="{StaticResource HabitScreen.ColumnTitle}"/>
                                <Button Style="{StaticResource HabitScreen.ColumnClose}"
                                        Command="{Binding ToggleColumnCommand}"
                                        CommandParameter="{x:Static vm:HabitColumn.Cronologia}"/>
                            </Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <cal:CalendarNavigator DataContext="{Binding Calendar}"/>
                                    <ContentControl Content="{Binding QuickAdd}"
                                                    ContentTemplateSelector="{StaticResource QuickAddSelector}"/>
                                    <ContentControl Content="{Binding TimerControl}"/>
                                    <v:DayNoteView DataContext="{Binding DayNote}"/>
                                    <StackPanel Margin="12,4,12,12">
                                        <TextBlock Text="{x:Static res:Strings.HabitScreen_DayRecords}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Text}"
                                                   Margin="0,0,0,2"/>
                                        <TextBlock Text="{x:Static res:Strings.HabitScreen_DayRecords_Empty}"
                                                   Foreground="{DynamicResource Brush.TextMuted}"
                                                   FontSize="{StaticResource FontSize.Small}"
                                                   Visibility="{Binding DayCompletions.Rows.Count, Converter={StaticResource ZeroToVisible}}"/>
                                        <ContentControl Content="{Binding DayCompletions}"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- Dettaglio -->
                    <Border Width="520" Style="{StaticResource HabitScreen.Column}"
                            Visibility="{Binding IsDettaglioOpen, Converter={StaticResource BoolToVisible}}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Style="{StaticResource HabitScreen.ColumnHeader}">
                                <TextBlock Text="{x:Static res:Strings.HabitScreen_Tab_Detail}" Style="{StaticResource HabitScreen.ColumnTitle}"/>
                                <Button Style="{StaticResource HabitScreen.ColumnClose}"
                                        Command="{Binding ToggleColumnCommand}"
                                        CommandParameter="{x:Static vm:HabitColumn.Dettaglio}"/>
                            </Grid>
                            <ContentControl Content="{Binding Detail}"/>
                        </DockPanel>
                    </Border>

                    <!-- Note -->
                    <Border Width="460" Style="{StaticResource HabitScreen.Column}"
                            Visibility="{Binding IsNoteOpen, Converter={StaticResource BoolToVisible}}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Style="{StaticResource HabitScreen.ColumnHeader}">
                                <TextBlock Text="{x:Static res:Strings.HabitScreen_Tab_Notes}" Style="{StaticResource HabitScreen.ColumnTitle}"/>
                                <Button Style="{StaticResource HabitScreen.ColumnClose}"
                                        Command="{Binding ToggleColumnCommand}"
                                        CommandParameter="{x:Static vm:HabitColumn.Note}"/>
                            </Grid>
                            <ContentControl Content="{Binding Notes}"/>
                        </DockPanel>
                    </Border>

                    <!-- Configura (the habit editor) -->
                    <Border Width="480" Style="{StaticResource HabitScreen.Column}"
                            Visibility="{Binding IsConfiguraOpen, Converter={StaticResource BoolToVisible}}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Style="{StaticResource HabitScreen.ColumnHeader}">
                                <TextBlock Text="{x:Static res:Strings.HabitScreen_Configure}" Style="{StaticResource HabitScreen.ColumnTitle}"/>
                                <Button Style="{StaticResource HabitScreen.ColumnClose}"
                                        Command="{Binding ToggleColumnCommand}"
                                        CommandParameter="{x:Static vm:HabitColumn.Configura}"/>
                            </Grid>
                            <ve:EditorPane DataContext="{Binding Editor}"/>
                        </DockPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
