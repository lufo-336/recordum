<UserControl x:Class="Recordum.WPF.Views.HabitScreen.Today.TodayStripView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:tvm="clr-namespace:Recordum.Presentation.ViewModels.HabitScreen.Today;assembly=Recordum.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance tvm:TodayStripViewModel}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="TodayContentTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- The strip renders whatever per-type content the VM chose. Bottom border keeps it visually
         part of the header stack above the columns. Collapsed when there is no content (e.g. a type
         whose strip is not applicable) so it never leaves an empty band. -->
    <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border}"
            Visibility="{Binding Content, Converter={StaticResource NullToVisibility}}">
        <ContentControl Content="{Binding Content}"
                        HorizontalContentAlignment="Stretch"/>
    </Border>
</UserControl>
