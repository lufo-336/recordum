<UserControl x:Class="Recordum.WPF.Views.HabitScreen.Today.ActionTodayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:Recordum.Presentation.Resources;assembly=Recordum.Presentation"
             xmlns:tvm="clr-namespace:Recordum.Presentation.ViewModels.HabitScreen.Today;assembly=Recordum.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance tvm:ActionTodayContent}">
    <Border Padding="14,10">
        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Done-today toggle: OneWay IsChecked mirrors state, the command records/undoes today's completion. -->
            <CheckBox Content="{x:Static res:Strings.Today_Action_MarkDone}"
                      IsChecked="{Binding IsDoneToday, Mode=OneWay}"
                      Command="{Binding ToggleDoneCommand}"
                      VerticalAlignment="Center" Margin="0,0,22,0"/>

            <!-- current streak -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                <TextBlock Text="{x:Static res:Strings.Detail_Streak_Current}"
                           Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,6,0"/>
                <TextBlock Foreground="{DynamicResource Brush.Text}" FontWeight="SemiBold">
                    <TextBlock.Text>
                        <Binding Path="CurrentStreak" StringFormat="{x:Static res:Strings.Home_KeyFigure_Streak}"/>
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>

            <!-- % done last 30 days -->
            <TextBlock Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" Margin="0,0,18,0">
                <TextBlock.Text>
                    <Binding Path="Pct30" StringFormat="{x:Static res:Strings.Today_Action_Pct30}"/>
                </TextBlock.Text>
            </TextBlock>

            <!-- usual hour (hidden when there is no data) -->
            <TextBlock Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center"
                       Visibility="{Binding HasUsualHour, Converter={StaticResource BoolToVisible}}">
                <TextBlock.Text>
                    <Binding Path="UsualHour" StringFormat="{x:Static res:Strings.Today_Action_UsualHour}"/>
                </TextBlock.Text>
            </TextBlock>
        </WrapPanel>
    </Border>
</UserControl>
