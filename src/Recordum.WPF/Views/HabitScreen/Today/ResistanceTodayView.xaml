<UserControl x:Class="Recordum.WPF.Views.HabitScreen.Today.ResistanceTodayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:Recordum.WPF.Resources"
             xmlns:tvm="clr-namespace:Recordum.WPF.ViewModels.HabitScreen.Today"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance tvm:ResistanceTodayContent}">
    <!-- The flagship "Oggi" content: the big live clean-streak clock + Inizio/Ricaduta + attempts(90d).
         Wraps so the strip never overflows a narrow window. -->
    <Border Padding="14,10">
        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Large live clock (while Abstaining) -->
            <TextBlock Text="{Binding Clock.Display}" FontFamily="Consolas"
                       FontSize="30" Foreground="{DynamicResource Brush.Text}"
                       VerticalAlignment="Center" Margin="0,0,18,0"
                       Visibility="{Binding CanLapse, Converter={StaticResource BoolToVisible}}"/>

            <!-- Inizio (when not Abstaining) -->
            <Button Content="{x:Static res:Strings.Abstinence_Start}"
                    Command="{Binding StartCommand}" Padding="14,7" Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Visibility="{Binding CanStart, Converter={StaticResource BoolToVisible}}"/>

            <!-- Ricaduta (danger affordance, while Abstaining) -->
            <Button Content="{x:Static res:Strings.Abstinence_Lapse}"
                    Command="{Binding LapseCommand}" Padding="14,7" Margin="0,0,18,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource Brush.Danger}"
                    Visibility="{Binding CanLapse, Converter={StaticResource BoolToVisible}}"/>

            <!-- attempts in the last 90 days -->
            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}">
                <TextBlock.Text>
                    <Binding Path="AttemptsLast90Days"
                             StringFormat="{x:Static res:Strings.Today_Resistance_Attempts}"/>
                </TextBlock.Text>
            </TextBlock>
        </WrapPanel>
    </Border>
</UserControl>
