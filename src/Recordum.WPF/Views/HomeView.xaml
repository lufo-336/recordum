<UserControl x:Class="Recordum.WPF.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Recordum.WPF.ViewModels"
             xmlns:v="clr-namespace:Recordum.WPF.Views"
             xmlns:res="clr-namespace:Recordum.WPF.Resources"
             xmlns:b="clr-namespace:Recordum.WPF.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:HomeViewModel, IsDesignTimeCreatable=False}"
             Background="{DynamicResource Brush.Background}"
             PreviewKeyDown="OnPreviewKeyDown"
             PreviewMouseLeftButtonUp="OnPreviewMouseLeftButtonUp">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="HabitRowTemplate.xaml"/>
                <ResourceDictionary Source="GroupRowTemplate.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <v:RowTemplateSelector x:Key="RowSelector"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Grid Grid.Row="0" Height="44" Background="{DynamicResource Brush.Surface}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{x:Static res:Strings.AppTitle}"
                       FontSize="{StaticResource FontSize.Heading}"
                       FontWeight="SemiBold"
                       Margin="16,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.Text}"/>
            <Button Grid.Column="2"
                    Content="{x:Static res:Strings.Home_NewHabit_Button}"
                    Click="OnNewMenuClick"
                    Margin="0,0,16,0"
                    Padding="12,4"
                    VerticalAlignment="Center">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{x:Static res:Strings.Home_NewMenu_Habit}"
                                  Command="{Binding OpenNewHabitCommand}"/>
                        <MenuItem Header="{x:Static res:Strings.Home_NewMenu_Group}"
                                  Command="{Binding CreateGroupCommand}"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <!-- View tabs as a segmented pill group (Fase C). -->
            <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource Brush.Background}" CornerRadius="6" Padding="3">
                <StackPanel Orientation="Horizontal">
                    <RadioButton GroupName="HomeTab" Style="{StaticResource Recordum.Segment}"
                                 Content="{x:Static res:Strings.Home_Tab_Active}"
                                 IsChecked="{Binding ActiveTab, Mode=OneWay, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static vm:HomeTab.Active}}"
                                 Command="{Binding SwitchTabCommand}"
                                 CommandParameter="{x:Static vm:HomeTab.Active}"/>
                    <RadioButton GroupName="HomeTab" Style="{StaticResource Recordum.Segment}" Margin="2,0,0,0"
                                 Content="{x:Static res:Strings.Home_Tab_Archived}"
                                 IsChecked="{Binding ActiveTab, Mode=OneWay, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static vm:HomeTab.Archived}}"
                                 Command="{Binding SwitchTabCommand}"
                                 CommandParameter="{x:Static vm:HomeTab.Archived}"/>
                    <RadioButton GroupName="HomeTab" Style="{StaticResource Recordum.Segment}" Margin="2,0,0,0"
                                 Content="{x:Static res:Strings.Home_Tab_Trash}"
                                 IsChecked="{Binding ActiveTab, Mode=OneWay, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static vm:HomeTab.Trash}}"
                                 Command="{Binding SwitchTabCommand}"
                                 CommandParameter="{x:Static vm:HomeTab.Trash}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Filter row -->
        <Grid Grid.Row="1" Height="36" Margin="16,8,16,0"
              Visibility="{Binding State, Converter={StaticResource StateToVisible}, ConverterParameter=Loaded}">
            <StackPanel Orientation="Horizontal">
                <ComboBox SelectedItem="{Binding SortOption}"
                          ItemsSource="{Binding AvailableSorts}"
                          Margin="0,0,8,0"/>
                <CheckBox Content="{x:Static res:Strings.Home_Filter_HideCompleted}"
                          IsChecked="{Binding HideCompletedToday}"
                          Visibility="{Binding ActiveTab, Converter={StaticResource ActiveTabVisible}}"
                          VerticalAlignment="Center"
                          Margin="0,0,16,0"/>
                <!-- Search with leading icon + watermark (the old bare Tag was inert). -->
                <Grid VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" Width="200" Padding="26,4,6,4"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    <Path Width="13" Height="13" Margin="8,0,0,0" Stretch="Uniform"
                          HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"
                          Stroke="{DynamicResource Brush.TextMuted}" StrokeThickness="1.7"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="{StaticResource Icon.Search}"/>
                    <TextBlock Text="{x:Static res:Strings.Home_Filter_SearchPlaceholder}"
                               Margin="28,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               FontSize="{StaticResource FontSize.Small}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- Tree / state. The Border carries a Transparent (not null) background so empty space
             below the rows is hit-testable — clicking it deselects (see HomeView.xaml.cs).
             A ContentControl's default template ignores Background, hence the wrapping Border. -->
        <Border x:Name="TreeRegion" Grid.Row="2" Background="Transparent" Margin="0,8,0,0"
                PreviewMouseRightButtonDown="OnPreviewMouseRightButtonDown">
        <ContentControl Content="{Binding}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="Loading">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <TextBlock Text="{x:Static res:Strings.Home_Loading}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Opacity="0.6"
                                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="Empty">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <v:EmptyState/>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="Error">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Static res:Strings.Home_Error_Generic}"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource Brush.Text}"/>
                                            <Button Content="{x:Static res:Strings.Home_Error_Retry}"
                                                    Command="{Binding RetryCommand}"
                                                    Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="Loaded">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Roots}"
                                                          b:TreeDragDropBehavior.Enabled="True"
                                                          KeyboardNavigation.TabNavigation="Continue"
                                                          ItemTemplateSelector="{StaticResource RowSelector}"/>
                                        </ScrollViewer>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>
        </Border>
    </Grid>
</UserControl>
