<UserControl x:Class="Recordum.WPF.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Recordum.WPF.ViewModels"
             xmlns:v="clr-namespace:Recordum.WPF.Views"
             xmlns:res="clr-namespace:Recordum.WPF.Resources"
             xmlns:b="clr-namespace:Recordum.WPF.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:HomeViewModel, IsDesignTimeCreatable=False}"
             Background="{DynamicResource Brush.Background}"
             PreviewKeyDown="OnPreviewKeyDown"
             PreviewMouseLeftButtonUp="OnPreviewMouseLeftButtonUp">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="HabitRowTemplate.xaml"/>
                <ResourceDictionary Source="GroupRowTemplate.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Grid Grid.Row="0" Height="44" Background="{DynamicResource Brush.Surface}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{x:Static res:Strings.AppTitle}"
                       FontSize="{StaticResource FontSize.Heading}"
                       FontWeight="SemiBold"
                       Margin="16,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.Text}"/>
            <Button Grid.Column="2"
                    Content="{x:Static res:Strings.Home_NewHabit_Button}"
                    Command="{Binding OpenNewHabitCommand}"
                    Margin="0,0,16,0"
                    Padding="12,4"
                    VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                <RadioButton GroupName="HomeTab"
                             Content="{x:Static res:Strings.Home_Tab_Active}"
                             IsChecked="{Binding ActiveTab, Mode=OneWay, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static vm:HomeTab.Active}}"
                             Command="{Binding SwitchTabCommand}"
                             CommandParameter="{x:Static vm:HomeTab.Active}" />
                <RadioButton GroupName="HomeTab"
                             Content="{x:Static res:Strings.Home_Tab_Archived}"
                             IsChecked="{Binding ActiveTab, Mode=OneWay, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static vm:HomeTab.Archived}}"
                             Command="{Binding SwitchTabCommand}"
                             CommandParameter="{x:Static vm:HomeTab.Archived}"
                             Margin="8,0,0,0"/>
                <RadioButton GroupName="HomeTab"
                             Content="{x:Static res:Strings.Home_Tab_Trash}"
                             IsChecked="{Binding ActiveTab, Mode=OneWay, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static vm:HomeTab.Trash}}"
                             Command="{Binding SwitchTabCommand}"
                             CommandParameter="{x:Static vm:HomeTab.Trash}"
                             Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Filter row -->
        <Grid Grid.Row="1" Height="36" Margin="16,8,16,0"
              Visibility="{Binding State, Converter={StaticResource StateToVisible}, ConverterParameter=Loaded}">
            <StackPanel Orientation="Horizontal">
                <ComboBox SelectedItem="{Binding SortOption}"
                          ItemsSource="{Binding AvailableSorts}"
                          Margin="0,0,8,0"/>
                <CheckBox Content="{x:Static res:Strings.Home_Filter_HideCompleted}"
                          IsChecked="{Binding HideCompletedToday}"
                          Visibility="{Binding ActiveTab, Converter={StaticResource ActiveTabVisible}}"
                          VerticalAlignment="Center"
                          Margin="0,0,16,0"/>
                <TextBox x:Name="SearchBox"
                         Width="200"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Tag="{x:Static res:Strings.Home_Filter_SearchPlaceholder}"/>
            </StackPanel>
        </Grid>

        <!-- Tree / state -->
        <ContentControl x:Name="TreeRegion" Grid.Row="2" Content="{Binding}" Margin="0,8,0,0">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="Loading">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <TextBlock Text="{x:Static res:Strings.Home_Loading}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Opacity="0.6"
                                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="Empty">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <v:EmptyState/>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="Error">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Static res:Strings.Home_Error_Generic}"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource Brush.Text}"/>
                                            <Button Content="{x:Static res:Strings.Home_Error_Retry}"
                                                    Command="{Binding RetryCommand}"
                                                    Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="Loaded">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding Rows}"
                                                      b:TreeDragDropBehavior.Enabled="True"
                                                      KeyboardNavigation.TabNavigation="Continue">
                                            <ItemsControl.ItemTemplateSelector>
                                                <v:RowTemplateSelector
                                                    HabitTemplate="{StaticResource HabitRowTemplate}"
                                                    GroupTemplate="{StaticResource GroupRowTemplate}"/>
                                            </ItemsControl.ItemTemplateSelector>
                                        </ItemsControl>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>
    </Grid>
</UserControl>
