<UserControl x:Class="Recordum.WPF.Views.Timer.TimerStatusBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Recordum.Presentation.ViewModels.Timer;assembly=Recordum.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:TimerStatusBarViewModel, IsDesignTimeCreatable=False}"
             Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisible}}">
    <Border BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource Brush.Border}"
            Background="{DynamicResource Brush.Surface}">
        <!-- Compact status-bar metrics (Fase B shell restyle): small chips, small type. -->
        <ItemsControl ItemsSource="{Binding Rows}" Padding="10,3">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,8,0"
                            Padding="6,2"
                            CornerRadius="3"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource Brush.Border}"
                            Background="{DynamicResource Brush.SurfaceElevated}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding HabitName}"
                                       FontWeight="SemiBold"
                                       FontSize="{StaticResource FontSize.Small}"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ElapsedDisplay}"
                                       FontFamily="Consolas"
                                       FontSize="11.5"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center"/>
                            <Button Content="⏸"
                                    Command="{Binding PauseCommand}"
                                    Width="20" Height="20"
                                    Padding="0" FontSize="11"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Visibility="{Binding IsPaused, Converter={StaticResource InvBoolToVisible}}"/>
                            <Button Content="▶"
                                    Command="{Binding ResumeCommand}"
                                    Width="20" Height="20"
                                    Padding="0" FontSize="11"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisible}}"/>
                            <Button Content="■"
                                    Command="{Binding StopCommand}"
                                    Width="20" Height="20"
                                    Padding="0" FontSize="11"
                                    Background="Transparent"
                                    BorderThickness="0"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</UserControl>
