<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:enums="clr-namespace:Recordum.Core.Enums;assembly=Recordum.Core"
                    xmlns:vms="clr-namespace:Recordum.WPF.ViewModels.HabitEditor.Sections"
                    xmlns:vs="clr-namespace:Recordum.WPF.Views.HabitEditor.Sections">

    <!-- Enum value sources for ComboBoxes -->
    <ObjectDataProvider x:Key="ScheduleTypeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
        <ObjectDataProvider.MethodParameters><x:Type TypeName="enums:ScheduleType"/></ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
    <ObjectDataProvider x:Key="StreakModeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
        <ObjectDataProvider.MethodParameters><x:Type TypeName="enums:StreakMode"/></ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
    <ObjectDataProvider x:Key="StreakRecoveryValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
        <ObjectDataProvider.MethodParameters><x:Type TypeName="enums:StreakRecovery"/></ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
    <ObjectDataProvider x:Key="MetricTypeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
        <ObjectDataProvider.MethodParameters><x:Type TypeName="enums:MetricType"/></ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
    <ObjectDataProvider x:Key="TimerModeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
        <ObjectDataProvider.MethodParameters><x:Type TypeName="enums:TimerMode"/></ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
    <ObjectDataProvider x:Key="GoalPeriodTypeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
        <ObjectDataProvider.MethodParameters><x:Type TypeName="enums:GoalPeriodType"/></ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
    <ObjectDataProvider x:Key="NotifyTypeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
        <ObjectDataProvider.MethodParameters><x:Type TypeName="enums:NotifyType"/></ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
    <ObjectDataProvider x:Key="AiDataSharingValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
        <ObjectDataProvider.MethodParameters><x:Type TypeName="enums:AiDataSharing"/></ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>

    <!-- Implicit DataTemplates — one per section VM (tasks 7-16) -->
    <DataTemplate DataType="{x:Type vms:SchedulingSectionViewModel}"><vs:SchedulingSectionView/></DataTemplate>
    <DataTemplate DataType="{x:Type vms:StreakSectionViewModel}"><vs:StreakSectionView/></DataTemplate>
    <DataTemplate DataType="{x:Type vms:MetricsSectionViewModel}"><vs:MetricsSectionView/></DataTemplate>
    <DataTemplate DataType="{x:Type vms:ScalesSectionViewModel}"><vs:ScalesSectionView/></DataTemplate>
    <DataTemplate DataType="{x:Type vms:TimerSectionViewModel}"><vs:TimerSectionView/></DataTemplate>
    <DataTemplate DataType="{x:Type vms:GoalSectionViewModel}"><vs:GoalSectionView/></DataTemplate>
    <DataTemplate DataType="{x:Type vms:NotificationsSectionViewModel}"><vs:NotificationsSectionView/></DataTemplate>
    <DataTemplate DataType="{x:Type vms:TagsSectionViewModel}"><vs:TagsSectionView/></DataTemplate>
    <DataTemplate DataType="{x:Type vms:AiSharingSectionViewModel}"><vs:AiSharingSectionView/></DataTemplate>
    <DataTemplate DataType="{x:Type vms:ResetTimeSectionViewModel}"><vs:ResetTimeSectionView/></DataTemplate>

</ResourceDictionary>
