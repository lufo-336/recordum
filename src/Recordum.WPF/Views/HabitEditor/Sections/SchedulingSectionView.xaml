<UserControl x:Class="Recordum.WPF.Views.HabitEditor.Sections.SchedulingSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vms="clr-namespace:Recordum.Presentation.ViewModels.HabitEditor.Sections;assembly=Recordum.Presentation"
             xmlns:enums="clr-namespace:Recordum.Core.Enums;assembly=Recordum.Core"
             xmlns:res="clr-namespace:Recordum.Presentation.Resources;assembly=Recordum.Presentation">
    <StackPanel>
        <TextBlock Text="{x:Static res:Strings.Editor_Field_ScheduleType}" Foreground="{DynamicResource Brush.TextMuted}"/>
        <ComboBox ItemsSource="{Binding Source={StaticResource ScheduleTypeValues}}"
                  SelectedItem="{Binding ScheduleType}"
                  Margin="0,2,0,8"/>

        <!-- SpecificDays: day-of-week picker -->
        <TextBlock Text="{x:Static res:Strings.Editor_Field_Days}" Foreground="{DynamicResource Brush.TextMuted}"
                   Visibility="{Binding ScheduleType, Converter={StaticResource EnumToVisibility},
                                ConverterParameter={x:Static enums:ScheduleType.SpecificDays}}"/>
        <ItemsControl ItemsSource="{Binding DayOptions}" Margin="0,2,0,8"
                      Visibility="{Binding ScheduleType, Converter={StaticResource EnumToVisibility},
                                   ConverterParameter={x:Static enums:ScheduleType.SpecificDays}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vms:DayToggleViewModel}">
                    <ToggleButton Content="{Binding Label}"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  Margin="0,0,4,4" MinWidth="40"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="{x:Static res:Strings.Editor_Field_TimesPerWeek}" Foreground="{DynamicResource Brush.TextMuted}"
                   Visibility="{Binding ScheduleType, Converter={StaticResource EnumToVisibility},
                                ConverterParameter={x:Static enums:ScheduleType.WeeklyX}}"/>
        <TextBox Text="{Binding ScheduleWeeklyTarget, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                 Margin="0,2,0,8"
                 Visibility="{Binding ScheduleType, Converter={StaticResource EnumToVisibility},
                              ConverterParameter={x:Static enums:ScheduleType.WeeklyX}}"/>

        <TextBlock Text="{x:Static res:Strings.Editor_Field_EveryXDays}" Foreground="{DynamicResource Brush.TextMuted}"
                   Visibility="{Binding ScheduleType, Converter={StaticResource EnumToVisibility},
                                ConverterParameter={x:Static enums:ScheduleType.EveryXDays}}"/>
        <TextBox Text="{Binding ScheduleEveryXDays, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                 Visibility="{Binding ScheduleType, Converter={StaticResource EnumToVisibility},
                              ConverterParameter={x:Static enums:ScheduleType.EveryXDays}}"/>
    </StackPanel>
</UserControl>
