<UserControl x:Class="Recordum.WPF.Views.HabitEditor.Sections.TimerSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vms="clr-namespace:Recordum.Presentation.ViewModels.HabitEditor.Sections;assembly=Recordum.Presentation"
             xmlns:enums="clr-namespace:Recordum.Core.Enums;assembly=Recordum.Core"
             xmlns:res="clr-namespace:Recordum.Presentation.Resources;assembly=Recordum.Presentation">
    <StackPanel>
        <CheckBox Content="{x:Static res:Strings.Editor_Field_IntegratedTimer}" IsChecked="{Binding HasIntegratedTimer}" Margin="0,0,0,6"/>
        <TextBlock Text="{x:Static res:Strings.Editor_Field_TimerMode}" Foreground="{DynamicResource Brush.TextMuted}"/>
        <ComboBox ItemsSource="{Binding Source={StaticResource TimerModeValues}}" SelectedItem="{Binding TimerMode}" Margin="0,2,0,8"/>
        <TextBlock Text="{x:Static res:Strings.Editor_Field_TargetSeconds}" Foreground="{DynamicResource Brush.TextMuted}"/>
        <TextBox Text="{Binding TimerTargetSeconds, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" Margin="0,2,0,8"/>
        <TextBlock Text="{x:Static res:Strings.Editor_Field_Segments}" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,4,0,2"/>
        <ItemsControl ItemsSource="{Binding Segments}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vms:SegmentRowViewModel}">
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding Name, UpdateSourceTrigger=LostFocus}"/>
                        <CheckBox Grid.Column="1" Content="{x:Static res:Strings.Editor_Field_Rest}" IsChecked="{Binding IsRest}" Margin="6,0" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Content="&#x2715;" Width="28"
                                Command="{Binding DataContext.RemoveSegmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Content="{x:Static res:Strings.Editor_Action_AddSegment}" Command="{Binding AddSegmentCommand}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
        <ToggleButton Content="{x:Static res:Strings.Editor_Field_Advanced}" IsChecked="{Binding ShowAdvanced}" Margin="0,6,0,0"
                      Style="{StaticResource Recordum.PillToggle}"/>
        <StackPanel Visibility="{Binding ShowAdvanced, Converter={StaticResource BoolToVisible}}">
            <CheckBox Content="{x:Static res:Strings.Editor_Field_AutoPrompt}" IsChecked="{Binding TimerAutoPrompt}" Margin="0,4,0,0"/>
            <TextBlock Text="{x:Static res:Strings.Editor_Field_RestTimerSeconds}" Foreground="{DynamicResource Brush.TextMuted}"/>
            <TextBox Text="{Binding RestTimerSeconds, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
