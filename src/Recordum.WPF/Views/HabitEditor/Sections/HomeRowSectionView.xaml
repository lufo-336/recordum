<UserControl x:Class="Recordum.WPF.Views.HabitEditor.Sections.HomeRowSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Recordum.WPF.Resources">
    <StackPanel>
        <TextBlock Text="{x:Static res:Strings.Editor_HomeRow_KeyFigureLabel}" Foreground="{DynamicResource Brush.TextMuted}"/>
        <ComboBox ItemsSource="{Binding KeyFigureOptions}" SelectedItem="{Binding SelectedKeyFigure}"
                  DisplayMemberPath="Label" Margin="0,2,0,8"/>
        <TextBlock Text="{x:Static res:Strings.Editor_HomeRow_StripLabel}" Foreground="{DynamicResource Brush.TextMuted}"/>
        <ComboBox ItemsSource="{Binding StripOptions}" SelectedItem="{Binding SelectedStrip}"
                  DisplayMemberPath="Label" Margin="0,2,0,0"/>
    </StackPanel>
</UserControl>
