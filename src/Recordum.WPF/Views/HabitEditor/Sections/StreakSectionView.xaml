<UserControl x:Class="Recordum.WPF.Views.HabitEditor.Sections.StreakSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vms="clr-namespace:Recordum.WPF.ViewModels.HabitEditor.Sections"
             xmlns:enums="clr-namespace:Recordum.Core.Enums;assembly=Recordum.Core"
             xmlns:res="clr-namespace:Recordum.WPF.Resources">
    <StackPanel>
        <TextBlock Text="{x:Static res:Strings.Editor_Field_StreakMode}" Foreground="{DynamicResource Brush.TextMuted}"/>
        <ComboBox ItemsSource="{Binding Source={StaticResource StreakModeValues}}"
                  SelectedItem="{Binding StreakMode}"
                  Margin="0,2,0,8"/>

        <TextBlock Text="{x:Static res:Strings.Editor_Field_Recovery}" Foreground="{DynamicResource Brush.TextMuted}"/>
        <ComboBox ItemsSource="{Binding Source={StaticResource StreakRecoveryValues}}"
                  SelectedItem="{Binding StreakRecovery}"
                  Margin="0,2,0,8"/>

        <ToggleButton Content="{x:Static res:Strings.Editor_Field_Advanced}" IsChecked="{Binding ShowAdvanced}" Margin="0,4"
                      Style="{StaticResource Recordum.PillToggle}"/>
        <StackPanel Visibility="{Binding ShowAdvanced, Converter={StaticResource BoolToVisible}}">
            <TextBlock Text="{x:Static res:Strings.Editor_Field_ToleranceMinutes}" Foreground="{DynamicResource Brush.TextMuted}"/>
            <TextBox Text="{Binding StreakToleranceMinutes, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
