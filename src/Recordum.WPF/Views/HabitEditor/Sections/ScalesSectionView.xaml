<UserControl x:Class="Recordum.WPF.Views.HabitEditor.Sections.ScalesSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vms="clr-namespace:Recordum.WPF.ViewModels.HabitEditor.Sections"
             xmlns:enums="clr-namespace:Recordum.Core.Enums;assembly=Recordum.Core"
             xmlns:res="clr-namespace:Recordum.WPF.Resources">
    <StackPanel>
        <TextBlock Text="{x:Static res:Strings.Editor_Field_Scale}" Foreground="{DynamicResource Brush.TextMuted}"/>
        <ComboBox ItemsSource="{Binding AvailableScales}" DisplayMemberPath="Name" SelectedValuePath="Id"
                  SelectedValue="{Binding SelectedScaleTemplateId}" Margin="0,2,0,4"/>
        <!-- Readable preview of the effective labels (value + label per step); collapses when none. -->
        <Border Background="{DynamicResource Brush.SurfaceElevated}" CornerRadius="4" Padding="8,5" Margin="0,0,0,8"
                Visibility="{Binding ScalePreview, Converter={StaticResource NullToVisibility}}">
            <TextBlock Text="{Binding ScalePreview}" TextWrapping="Wrap"
                       FontSize="{StaticResource FontSize.Small}" Foreground="{DynamicResource Brush.Text}"/>
        </Border>
        <TextBlock Text="{x:Static res:Strings.Editor_Field_CustomLabels}" Foreground="{DynamicResource Brush.TextMuted}"/>
        <TextBox Text="{Binding LabelsJson, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" AcceptsReturn="True" MinHeight="48"/>
    </StackPanel>
</UserControl>
