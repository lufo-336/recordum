<UserControl x:Class="Recordum.WPF.Views.HsvColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Recordum.WPF.Views"
             mc:Ignorable="d"
             SizeChanged="OnSizeChanged">
    <StackPanel Width="200">
        <!-- Saturation (x) / Value (y) square -->
        <Border x:Name="SvArea" Height="140" CornerRadius="6" ClipToBounds="True"
                Cursor="Cross"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                MouseLeftButtonDown="OnSvMouseDown"
                MouseMove="OnSvMouseMove"
                MouseLeftButtonUp="OnSvMouseUp">
            <Grid>
                <!-- base hue (set in code-behind) -->
                <Border x:Name="SvHueLayer"/>
                <!-- white -> transparent (saturation) -->
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFFFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <!-- transparent -> black (value) -->
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0"/>
                            <GradientStop Color="#FF000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Canvas>
                    <Ellipse x:Name="SvThumb" Width="12" Height="12"
                             Stroke="White" StrokeThickness="2" IsHitTestVisible="False">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="0" Opacity="0.6"/>
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>
            </Grid>
        </Border>

        <!-- Hue strip -->
        <Border x:Name="HueArea" Height="16" Margin="0,8,0,0" CornerRadius="6" ClipToBounds="True"
                Cursor="Cross"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                MouseLeftButtonDown="OnHueMouseDown"
                MouseMove="OnHueMouseMove"
                MouseLeftButtonUp="OnHueMouseUp">
            <Grid>
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFFF0000" Offset="0.0"/>
                            <GradientStop Color="#FFFFFF00" Offset="0.1667"/>
                            <GradientStop Color="#FF00FF00" Offset="0.3333"/>
                            <GradientStop Color="#FF00FFFF" Offset="0.5"/>
                            <GradientStop Color="#FF0000FF" Offset="0.6667"/>
                            <GradientStop Color="#FFFF00FF" Offset="0.8333"/>
                            <GradientStop Color="#FFFF0000" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Canvas>
                    <Border x:Name="HueThumb" Width="6" Height="16"
                            BorderBrush="White" BorderThickness="2" CornerRadius="2"
                            IsHitTestVisible="False">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="0" Opacity="0.6"/>
                        </Border.Effect>
                    </Border>
                </Canvas>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
