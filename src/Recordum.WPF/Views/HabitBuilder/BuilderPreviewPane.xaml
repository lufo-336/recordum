<UserControl x:Class="Recordum.WPF.Views.HabitBuilder.BuilderPreviewPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pvm="clr-namespace:Recordum.WPF.ViewModels.HabitBuilder.Preview"
             xmlns:v="clr-namespace:Recordum.WPF.Views"
             xmlns:res="clr-namespace:Recordum.WPF.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance pvm:BuilderPreviewModel, IsDesignTimeCreatable=False}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The real per-type "Oggi" templates, shared with the workspace strip: tier 2 of the
                     preview renders the actual component, not a lookalike. They are DataType-keyed, so
                     a null Content selects nothing (no C1 exposure). -->
                <ResourceDictionary Source="pack://application:,,,/Recordum.WPF;component/Views/HabitScreen/Today/TodayContentTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="Preview.SectionLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource FontSize.Small}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>
            <Style x:Key="Preview.Card" TargetType="Border">
                <Setter Property="Padding" Value="10"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                <Setter Property="Background" Value="{DynamicResource Brush.SurfaceElevated}"/>
                <Setter Property="Margin" Value="0,0,0,16"/>
            </Style>
            <!-- A ghost line of the Markdown editor: shape only, never the editor itself. -->
            <Style x:Key="Preview.GhostLine" TargetType="Border">
                <Setter Property="Height" Value="8"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="Background" Value="{DynamicResource Brush.Border}"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Inert by construction: the whole pane is a picture of the habit, never a control you can
         touch. Hit-testing off also means no command on the real "Oggi" view-models can ever fire. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" IsHitTestVisible="False">
        <StackPanel Margin="16,12">

            <!-- ===== Tier 1: la riga in Home ===== -->
            <TextBlock Text="{x:Static res:Strings.HabitBuilder_Preview_Home}" Style="{StaticResource Preview.SectionLabel}"/>
            <Border Style="{StaticResource Preview.Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- 4px accent bar: colour is an identifier, as in the real row. -->
                    <Border Grid.Column="0" Width="4" CornerRadius="2" Margin="0,0,10,0"
                            Background="{Binding HomeRow.Color, Converter={StaticResource HexToBrush}}"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding HomeRow.Name}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Brush.Text}"/>
                    <Border Grid.Column="2"
                            Margin="8,0"
                            Padding="6,2"
                            CornerRadius="8"
                            VerticalAlignment="Center"
                            Background="{DynamicResource Brush.Surface}"
                            Visibility="{Binding HomeRow.KeyFigure, Converter={StaticResource NullToVisibility}}">
                        <TextBlock Text="{Binding HomeRow.KeyFigure}"
                                   FontSize="{StaticResource FontSize.Small}"
                                   Foreground="{DynamicResource Brush.Text}"/>
                    </Border>
                    <v:HeatmapStrip Grid.Column="3"
                                    VerticalAlignment="Center"
                                    Counts="{Binding HomeRow.Counts}"
                                    Fractions="{Binding HomeRow.Fractions}"
                                    Kind="{Binding HomeRow.StripStyle}"
                                    AccentColor="{Binding HomeRow.Color}"/>
                </Grid>
            </Border>

            <!-- ===== Tier 2: la fascia "Oggi" (componente reale) ===== -->
            <StackPanel Visibility="{Binding Today, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="{x:Static res:Strings.HabitBuilder_Preview_Today}" Style="{StaticResource Preview.SectionLabel}"/>
                <Border Style="{StaticResource Preview.Card}">
                    <ContentControl Content="{Binding Today}" HorizontalContentAlignment="Stretch"/>
                </Border>
            </StackPanel>

            <!-- ===== Tier 3: il modulo di registrazione ===== -->
            <TextBlock Text="{x:Static res:Strings.HabitBuilder_Preview_Recording}" Style="{StaticResource Preview.SectionLabel}"/>
            <Border Style="{StaticResource Preview.Card}">
                <Grid>
                    <!-- Done (Action) -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding Recording.Kind, Converter={StaticResource EnumToVisibility}, ConverterParameter={x:Static pvm:RecordingPreviewKind.Done}}">
                        <CheckBox IsChecked="True" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Static res:Strings.HabitBuilder_Preview_Done}"
                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Text}"/>
                    </StackPanel>

                    <!-- Tap (+1) -->
                    <Border Visibility="{Binding Recording.Kind, Converter={StaticResource EnumToVisibility}, ConverterParameter={x:Static pvm:RecordingPreviewKind.Tap}}"
                            Width="56" Height="56" CornerRadius="28"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource Brush.Accent}">
                        <TextBlock Text="{x:Static res:Strings.HabitBuilder_Preview_Tap}"
                                   FontSize="22" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.OnAccent}"/>
                    </Border>

                    <!-- Campi misurati (Counter con campi, State) -->
                    <StackPanel Visibility="{Binding Recording.Kind, Converter={StaticResource EnumToVisibility}, ConverterParameter={x:Static pvm:RecordingPreviewKind.Fields}}">
                        <ItemsControl ItemsSource="{Binding Recording.SeriesLabels}" Margin="0,0,0,8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,3" Margin="0,0,6,4" CornerRadius="10"
                                            Background="{DynamicResource Brush.Surface}">
                                        <TextBlock Text="{Binding}"
                                                   FontSize="{StaticResource FontSize.Small}"
                                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Recording.SegmentNames}" Margin="0,0,0,8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,3" Margin="0,0,6,4" CornerRadius="3"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource Brush.Border}">
                                        <TextBlock Text="{Binding}"
                                                   FontSize="{StaticResource FontSize.Small}"
                                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Recording.Fields}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type pvm:RecordingFieldPreview}">
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <TextBlock Text="{Binding Name}"
                                                   MinWidth="72" VerticalAlignment="Center"
                                                   FontSize="{StaticResource FontSize.Small}"
                                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                                        <Border Padding="8,4" MinWidth="52" CornerRadius="3"
                                                BorderThickness="1"
                                                BorderBrush="{DynamicResource Brush.Border}"
                                                Background="{DynamicResource Brush.Surface}">
                                            <TextBlock Text="{Binding Value}" Foreground="{DynamicResource Brush.Text}"/>
                                        </Border>
                                        <TextBlock Text="{Binding Unit}" Margin="6,0,0,0" VerticalAlignment="Center"
                                                   FontSize="{StaticResource FontSize.Small}"
                                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Astinenza -->
                    <StackPanel Visibility="{Binding Recording.Kind, Converter={StaticResource EnumToVisibility}, ConverterParameter={x:Static pvm:RecordingPreviewKind.Abstinence}}">
                        <TextBlock Text="{Binding Recording.Clock}"
                                   FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Border Padding="10,4" CornerRadius="3" Background="{DynamicResource Brush.Surface}"
                                    BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}">
                                <TextBlock Text="{x:Static res:Strings.Abstinence_Start}"
                                           Foreground="{DynamicResource Brush.Text}"/>
                            </Border>
                            <Border Padding="10,4" Margin="6,0,0,0" CornerRadius="3"
                                    Background="{DynamicResource Brush.Surface}"
                                    BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}">
                                <TextBlock Text="{x:Static res:Strings.Abstinence_Lapse}"
                                           Foreground="{DynamicResource Brush.Text}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Journal: gesto Diario. Stand-in statico, MAI il MarkdownEditorControl (WebView2). -->
                    <StackPanel Visibility="{Binding Recording.Kind, Converter={StaticResource EnumToVisibility}, ConverterParameter={x:Static pvm:RecordingPreviewKind.Diary}}">
                        <TextBlock Text="{x:Static res:Strings.HabitBuilder_Preview_DiaryCard}"
                                   FontSize="{StaticResource FontSize.Small}"
                                   Foreground="{DynamicResource Brush.TextMuted}"
                                   Margin="0,0,0,8"/>
                        <Border Style="{StaticResource Preview.GhostLine}" Width="150" HorizontalAlignment="Left"/>
                        <Border Style="{StaticResource Preview.GhostLine}"/>
                        <Border Style="{StaticResource Preview.GhostLine}"/>
                        <Border Style="{StaticResource Preview.GhostLine}" Width="90" HorizontalAlignment="Left"/>
                    </StackPanel>

                    <!-- Journal: gesto Nota veloce. -->
                    <StackPanel Visibility="{Binding Recording.Kind, Converter={StaticResource EnumToVisibility}, ConverterParameter={x:Static pvm:RecordingPreviewKind.QuickNote}}">
                        <TextBlock Text="{x:Static res:Strings.HabitBuilder_Preview_QuickNoteCard}"
                                   FontSize="{StaticResource FontSize.Small}"
                                   Foreground="{DynamicResource Brush.TextMuted}"
                                   Margin="0,0,0,8"/>
                        <Border Padding="8,20,8,8" CornerRadius="3"
                                BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}"
                                Background="{DynamicResource Brush.Surface}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="{x:Static res:Strings.HabitBuilder_Preview_Sample}"
                       FontSize="{StaticResource FontSize.Small}"
                       Foreground="{DynamicResource Brush.TextMuted}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
