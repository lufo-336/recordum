<UserControl x:Class="Recordum.WPF.Views.HabitBuilder.HabitBuilderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Recordum.Presentation.ViewModels.HabitBuilder;assembly=Recordum.Presentation"
             xmlns:v="clr-namespace:Recordum.WPF.Views"
             xmlns:hb="clr-namespace:Recordum.WPF.Views.HabitBuilder"
             xmlns:enums="clr-namespace:Recordum.Core.Enums;assembly=Recordum.Core"
             xmlns:res="clr-namespace:Recordum.Presentation.Resources;assembly=Recordum.Presentation"
             xmlns:beh="clr-namespace:Recordum.WPF.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:HabitBuilderViewModel, IsDesignTimeCreatable=False}"
             Background="{DynamicResource Brush.Surface}">
    <UserControl.Resources>
        <!-- Scope del mattone Programma (Onda 2.5 T3): Daily/SpecificDays/WeeklyX/EveryXDays only —
             Monthly/Custom stay Configura-only (nessun seed li usa). -->
        <x:Array x:Key="ScheduleBrickTypeValues" Type="{x:Type enums:ScheduleType}">
            <enums:ScheduleType>Daily</enums:ScheduleType>
            <enums:ScheduleType>SpecificDays</enums:ScheduleType>
            <enums:ScheduleType>WeeklyX</enums:ScheduleType>
            <enums:ScheduleType>EveryXDays</enums:ScheduleType>
        </x:Array>
    </UserControl.Resources>
    <DockPanel LastChildFill="True">

        <!-- Bottom action bar -->
        <Border DockPanel.Dock="Bottom"
                Padding="16,12"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource Brush.Border}">
            <DockPanel LastChildFill="False">
                <Button x:Name="CancelButton"
                        DockPanel.Dock="Left"
                        Content="{x:Static res:Strings.HabitBuilder_Cancel}"
                        Padding="14,6"/>
                <Button DockPanel.Dock="Right"
                        Content="{x:Static res:Strings.HabitBuilder_Launch}"
                        Padding="18,6"
                        Margin="8,0,0,0"
                        FontWeight="SemiBold"
                        Command="{Binding LaunchCommand}"/>
                <TextBlock DockPanel.Dock="Right"
                           Text="{x:Static res:Strings.HabitBuilder_TemplateSaved}"
                           VerticalAlignment="Center" Margin="8,0,0,0"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Success}"
                           Visibility="{Binding TemplateSaved, Converter={StaticResource BoolToVisible}}"/>
                <Button DockPanel.Dock="Right"
                        Content="{x:Static res:Strings.HabitBuilder_SaveAsTemplate}"
                        Padding="14,6"
                        Command="{Binding SaveAsTemplateCommand}"/>
                <TextBlock DockPanel.Dock="Right"
                           Text="{x:Static res:Strings.HabitBuilder_LaunchHint}"
                           TextWrapping="Wrap" MaxWidth="280"
                           VerticalAlignment="Center" Margin="12,0"
                           FontSize="{StaticResource FontSize.Small}"
                           Foreground="{DynamicResource Brush.TextMuted}"
                           Visibility="{Binding LaunchBlocked, Converter={StaticResource BoolToVisible}}"/>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">

                <!-- ===== Zone 1: Testata ===== -->
                <TextBlock Text="{x:Static res:Strings.HabitBuilder_Title}"
                           FontSize="{StaticResource FontSize.Heading}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text}"
                           Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Name -->
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="{x:Static res:Strings.HabitBuilder_Name}"
                                   FontSize="{StaticResource FontSize.Small}"
                                   Foreground="{DynamicResource Brush.TextMuted}"
                                   Margin="0,0,0,2"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="6,4"/>
                    </StackPanel>

                    <!-- Derived type badge -->
                    <Border Grid.Column="1"
                            VerticalAlignment="Bottom"
                            Padding="10,4"
                            CornerRadius="10"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource Brush.Border}"
                            Background="{DynamicResource Brush.SurfaceElevated}">
                        <TextBlock FontSize="{StaticResource FontSize.Small}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text}"
                                   Text="{Binding DerivedType, StringFormat={x:Static res:Strings.HabitBuilder_DerivedType}}"/>
                    </Border>
                </Grid>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Color -->
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="{x:Static res:Strings.HabitBuilder_Color}"
                                   FontSize="{StaticResource FontSize.Small}"
                                   Foreground="{DynamicResource Brush.TextMuted}"
                                   Margin="0,0,0,2"/>
                        <v:ColorSwatchPicker Color="{Binding Color, Mode=TwoWay}"
                                             RecentColors="{Binding RecentColors}"
                                             FavoriteColors="{Binding FavoriteColors}"
                                             AddFavoriteCommand="{Binding AddFavoriteCommand}"
                                             RemoveFavoriteCommand="{Binding RemoveFavoriteCommand}"
                                             EyedropperCommand="{Binding EyedropCommand}"
                                             HorizontalAlignment="Left"/>
                    </StackPanel>

                    <!-- Icon (optional) -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{x:Static res:Strings.HabitBuilder_Icon}"
                                   FontSize="{StaticResource FontSize.Small}"
                                   Foreground="{DynamicResource Brush.TextMuted}"
                                   Margin="0,0,0,2"/>
                        <v:IconPicker Icon="{Binding Icon, Mode=TwoWay}"
                                      HorizontalAlignment="Left"/>
                    </StackPanel>
                </Grid>

                <!-- Repeatable (U8): Counter-only, can this habit be recorded multiple times a day?
                     Con le serie nominate (Onda 2.5 T6) sotto: i nomi delle registrazioni del giorno. -->
                <StackPanel Margin="0,0,0,16"
                            Visibility="{Binding DerivedType, Converter={StaticResource EnumToVisibility},
                                         ConverterParameter={x:Static enums:HabitType.Counter}}">
                    <CheckBox Content="{x:Static res:Strings.Editor_Registration_Repeatable}"
                              IsChecked="{Binding Repeatable}"/>
                    <StackPanel Margin="20,8,0,0"
                                Visibility="{Binding Repeatable, Converter={StaticResource BoolToVisible}}">
                        <TextBlock Text="{x:Static res:Strings.HabitBuilder_SeriesLabels_Hint}"
                                   FontSize="{StaticResource FontSize.Small}"
                                   Foreground="{DynamicResource Brush.TextMuted}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding SeriesLabels}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SeriesLabelRowViewModel}">
                                    <Border Margin="0,0,6,6"
                                            Padding="8,4"
                                            CornerRadius="4"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource Brush.Border}"
                                            Background="{DynamicResource Brush.SurfaceElevated}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox MinWidth="90"
                                                     VerticalAlignment="Center"
                                                     Padding="4,2"
                                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                            <Button Content="✕"
                                                    Margin="6,0,0,0"
                                                    Padding="6,1"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DataContext.RemoveSeriesLabelCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="{x:Static res:Strings.HabitBuilder_SeriesLabels_Add}"
                                Padding="10,4"
                                HorizontalAlignment="Left"
                                Command="{Binding AddSeriesLabelCommand}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Journal gesture (Onda 2.4): Journal-only, quale gesto e' primario in Cronologia. -->
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                            Visibility="{Binding ShowJournalGesture, Converter={StaticResource BoolToVisible}}">
                    <TextBlock Text="{x:Static res:Strings.Editor_Registration_JournalGesture}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding JournalGestureOptions}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Gesture"
                              SelectedValue="{Binding JournalGesture}"
                              MinWidth="200"/>
                </StackPanel>

                <!-- ===== Zone 2: Composizione ===== -->
                <TextBlock Text="{x:Static res:Strings.HabitBuilder_Blocks}"
                           FontSize="{StaticResource FontSize.Body}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text}"
                           Margin="0,0,0,2"/>

                <!-- Helper: adding fields makes this a counter with series (no "Series" checkbox needed). -->
                <TextBlock Text="{x:Static res:Strings.HabitBuilder_FieldsHint}"
                           TextWrapping="Wrap"
                           FontSize="{StaticResource FontSize.Small}"
                           Foreground="{DynamicResource Brush.TextMuted}"
                           Margin="0,0,0,6"/>

                <!-- Palette — disabled while the bare tap-counter block is on (a tap counter has no fields). -->
                <WrapPanel Margin="0,0,0,10" IsEnabled="{Binding FieldsAllowed}">
                    <Button Content="{x:Static res:Strings.HabitBuilder_AddQuantity}"
                            Padding="10,5" Margin="0,0,6,6"
                            Command="{Binding AddFieldCommand}"
                            CommandParameter="{x:Static enums:FieldNature.Quantity}"/>
                    <Button Content="{x:Static res:Strings.HabitBuilder_AddTime}"
                            Padding="10,5" Margin="0,0,6,6"
                            Command="{Binding AddFieldCommand}"
                            CommandParameter="{x:Static enums:FieldNature.Time}"/>
                    <Button Content="{x:Static res:Strings.HabitBuilder_AddScale}"
                            Padding="10,5" Margin="0,0,6,6"
                            Command="{Binding AddFieldCommand}"
                            CommandParameter="{x:Static enums:FieldNature.Scale}"/>
                    <Button Content="{x:Static res:Strings.HabitBuilder_AddText}"
                            Padding="10,5" Margin="0,0,6,6"
                            Command="{Binding AddFieldCommand}"
                            CommandParameter="{x:Static enums:FieldNature.Text}"/>
                </WrapPanel>

                <!-- Mattoni blocco: Contatore e Astinenza -->
                <WrapPanel Margin="0,0,0,10">
                    <CheckBox Content="{x:Static res:Strings.HabitBuilder_CounterBlock}"
                              ToolTip="{x:Static res:Strings.HabitBuilder_CounterBlock_Tip}"
                              IsChecked="{Binding CountsOccurrences}"
                              IsEnabled="{Binding CanEnableCounter}"
                              Margin="0,0,14,0"
                              VerticalAlignment="Center"/>
                    <CheckBox Content="{x:Static res:Strings.HabitBuilder_AbstinenceBlock}"
                              ToolTip="{x:Static res:Strings.HabitBuilder_AbstinenceBlock_Tip}"
                              IsChecked="{Binding Abstinence}"
                              IsEnabled="{Binding CanEnableAbstinence}"
                              VerticalAlignment="Center"/>
                </WrapPanel>

                <!-- Why the palette is disabled when the tap counter is on. -->
                <TextBlock Text="{x:Static res:Strings.HabitBuilder_TapCounterNote}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"
                           FontSize="{StaticResource FontSize.Small}"
                           Foreground="{DynamicResource Brush.TextMuted}"
                           Visibility="{Binding CountsOccurrences, Converter={StaticResource BoolToVisible}}"/>

                <!-- Field list -->
                <ItemsControl ItemsSource="{Binding Fields}" Margin="0,0,0,16">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,3"
                                    Padding="10,6"
                                    CornerRadius="4"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource Brush.Border}"
                                    Background="{DynamicResource Brush.SurfaceElevated}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Padding="6,2"
                                            Margin="0,0,10,0"
                                            CornerRadius="8"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource Brush.Surface}">
                                        <TextBlock Text="{Binding Nature}"
                                                   FontSize="{StaticResource FontSize.Small}"
                                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                                    </Border>
                                    <TextBox Grid.Column="1"
                                             VerticalAlignment="Center"
                                             Padding="6,3"
                                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                                    <!-- Unit picker (Quantity) — sets UnitOfMeasureId so Launch can enable -->
                                    <ComboBox Grid.Column="2"
                                              MinWidth="120"
                                              Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              ItemsSource="{Binding DataContext.AvailableUnits, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding UnitOfMeasureId, Mode=TwoWay}"
                                              ToolTip="{x:Static res:Strings.HabitBuilder_UnitPickerPrompt}">
                                        <ComboBox.Style>
                                            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Nature}" Value="{x:Static enums:FieldNature.Quantity}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ComboBox.Style>
                                    </ComboBox>

                                    <!-- Scale picker (Scale) — sets ScaleTemplateId so Launch can enable -->
                                    <ComboBox Grid.Column="2"
                                              MinWidth="120"
                                              Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              ItemsSource="{Binding DataContext.AvailableScales, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding ScaleTemplateId, Mode=TwoWay}"
                                              ToolTip="{x:Static res:Strings.HabitBuilder_ScalePickerPrompt}">
                                        <ComboBox.Style>
                                            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Nature}" Value="{x:Static enums:FieldNature.Scale}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ComboBox.Style>
                                    </ComboBox>

                                    <!-- Time-unit picker (Time) — a duration metric always carries a unit (hours/minutes/seconds); required, not optional -->
                                    <ComboBox Grid.Column="2"
                                              MinWidth="120"
                                              Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              ItemsSource="{Binding DataContext.AvailableTimeUnits, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding UnitOfMeasureId, Mode=TwoWay}"
                                              ToolTip="{x:Static res:Strings.HabitBuilder_UnitPickerPrompt}">
                                        <ComboBox.Style>
                                            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Nature}" Value="{x:Static enums:FieldNature.Time}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ComboBox.Style>
                                    </ComboBox>

                                    <!-- Onda 2.5 T10: a unit-less quantity that still wants fractions
                                         (body weight — the "Workout log" seed's own Weight metric,
                                         which the parity guard found the builder could not compose). -->
                                    <CheckBox Grid.Column="3"
                                              Content="{x:Static res:Strings.HabitBuilder_Field_Decimals}"
                                              IsChecked="{Binding AllowsDecimals}"
                                              VerticalAlignment="Center"
                                              Margin="8,0,0,0">
                                        <CheckBox.Style>
                                            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Nature}" Value="{x:Static enums:FieldNature.Quantity}"/>
                                                            <Condition Binding="{Binding UnitOfMeasureId}" Value="{x:Null}"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBox.Style>
                                    </CheckBox>

                                    <!-- Onda 2.5 T7: stage a custom unit / scale without leaving the
                                         builder. Not offered next to the Time picker: the time units
                                         are closed in Core (SecondsDisplay.TimeUnitCodes). -->
                                    <Button Grid.Column="4"
                                            Content="+"
                                            Margin="4,0,0,0"
                                            Padding="8,2"
                                            VerticalAlignment="Center"
                                            ToolTip="{x:Static res:Strings.HabitBuilder_NewUnit}"
                                            Command="{Binding DataContext.BeginAddCustomUnitCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Nature}" Value="{x:Static enums:FieldNature.Quantity}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Button Grid.Column="4"
                                            Content="+"
                                            Margin="4,0,0,0"
                                            Padding="8,2"
                                            VerticalAlignment="Center"
                                            ToolTip="{x:Static res:Strings.HabitBuilder_NewScale}"
                                            Command="{Binding DataContext.BeginAddCustomScaleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Nature}" Value="{x:Static enums:FieldNature.Scale}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Button Grid.Column="5"
                                            Content="✕"
                                            Margin="8,0,0,0"
                                            Padding="8,2"
                                            VerticalAlignment="Center"
                                            Command="{Binding DataContext.RemoveFieldCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Micro-form unità custom (Onda 2.5 T7) — inline sotto la lista campi: la
                     definizione resta nel draft finché Lancia (o il salvataggio come template) non la
                     materializza. -->
                <Border Margin="0,0,0,12"
                        Padding="12"
                        CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource Brush.Border}"
                        Background="{DynamicResource Brush.SurfaceElevated}"
                        Visibility="{Binding UnitForm, Converter={StaticResource NullToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.HabitBuilder_NewUnit}"
                                   FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="{x:Static res:Strings.HabitBuilder_NewUnit_Name}"
                                   FontSize="{StaticResource FontSize.Small}"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                        <TextBox Text="{Binding UnitForm.Name, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,2,0,8"/>
                        <TextBlock Text="{x:Static res:Strings.HabitBuilder_NewUnit_Symbol}"
                                   FontSize="{StaticResource FontSize.Small}"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                        <TextBox Text="{Binding UnitForm.Symbol, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,2,0,10"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{x:Static res:Strings.HabitBuilder_New_Cancel}"
                                    Padding="12,5"
                                    Command="{Binding CancelCustomFormCommand}"/>
                            <Button Content="{x:Static res:Strings.HabitBuilder_New_Confirm}"
                                    Padding="12,5" Margin="8,0,0,0" FontWeight="SemiBold"
                                    IsEnabled="{Binding UnitForm.CanConfirm}"
                                    Command="{Binding ConfirmCustomUnitCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Micro-form scala custom (Onda 2.5 T7) -->
                <Border Margin="0,0,0,12"
                        Padding="12"
                        CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource Brush.Border}"
                        Background="{DynamicResource Brush.SurfaceElevated}"
                        Visibility="{Binding ScaleForm, Converter={StaticResource NullToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.HabitBuilder_NewScale}"
                                   FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="{x:Static res:Strings.HabitBuilder_NewUnit_Name}"
                                   FontSize="{StaticResource FontSize.Small}"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                        <TextBox Text="{Binding ScaleForm.Name, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,2,0,8"/>
                        <TextBlock Text="{x:Static res:Strings.HabitBuilder_NewScale_Labels}"
                                   FontSize="{StaticResource FontSize.Small}"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                        <TextBox Text="{Binding ScaleForm.LabelsText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,2,0,10"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{x:Static res:Strings.HabitBuilder_New_Cancel}"
                                    Padding="12,5"
                                    Command="{Binding CancelCustomFormCommand}"/>
                            <Button Content="{x:Static res:Strings.HabitBuilder_New_Confirm}"
                                    Padding="12,5" Margin="8,0,0,0" FontWeight="SemiBold"
                                    IsEnabled="{Binding ScaleForm.CanConfirm}"
                                    Command="{Binding ConfirmCustomScaleCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== Zone 2b: Composizione avanzata (Onda 2.5) ===== -->
                <TextBlock Text="{x:Static res:Strings.HabitBuilder_Advanced}" FontSize="{StaticResource FontSize.Body}"
                           FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" Margin="0,4,0,6"/>
                <Expander IsExpanded="{Binding Schedule.IsExpanded}" Margin="0,0,0,8">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Static res:Strings.HabitBuilder_Schedule_Header}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Schedule.Summary}" Margin="8,0,0,0"
                                       Foreground="{DynamicResource Brush.TextMuted}"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="12,6,0,4">

                        <!-- Tipo programma: 4 valori nello scope del mattone, ItemTemplate localizzato (F0-11) -->
                        <ComboBox ItemsSource="{StaticResource ScheduleBrickTypeValues}"
                                  SelectedItem="{Binding Schedule.ScheduleType}"
                                  Margin="0,0,0,8">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource ScheduleTypeLabel}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- SpecificDays: day-of-week toggles -->
                        <ItemsControl ItemsSource="{Binding Schedule.Days}" Margin="0,0,0,8"
                                      Visibility="{Binding Schedule.ScheduleType, Converter={StaticResource EnumToVisibility},
                                                   ConverterParameter={x:Static enums:ScheduleType.SpecificDays}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ScheduleDayToggle}">
                                    <ToggleButton Content="{Binding Label}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Margin="0,0,4,4" MinWidth="40"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- WeeklyX: target numerico -->
                        <TextBox Text="{Binding Schedule.WeeklyTarget, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                                 Margin="0,0,0,8"
                                 Visibility="{Binding Schedule.ScheduleType, Converter={StaticResource EnumToVisibility},
                                              ConverterParameter={x:Static enums:ScheduleType.WeeklyX}}"/>

                        <!-- EveryXDays: intervallo numerico -->
                        <TextBox Text="{Binding Schedule.EveryXDays, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                                 Margin="0,0,0,8"
                                 Visibility="{Binding Schedule.ScheduleType, Converter={StaticResource EnumToVisibility},
                                              ConverterParameter={x:Static enums:ScheduleType.EveryXDays}}"/>

                        <!-- Streak mode -->
                        <TextBlock Text="{x:Static res:Strings.HabitBuilder_Schedule_StreakMode}"
                                   FontSize="{StaticResource FontSize.Small}"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                        <ComboBox ItemsSource="{Binding Source={StaticResource StreakModeValues}}"
                                  SelectedItem="{Binding Schedule.StreakMode}"
                                  Margin="0,2,0,8">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource StreakModeLabel}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Recovery -->
                        <TextBlock Text="{x:Static res:Strings.HabitBuilder_Schedule_Recovery}"
                                   FontSize="{StaticResource FontSize.Small}"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                        <ComboBox ItemsSource="{Binding Source={StaticResource StreakRecoveryValues}}"
                                  SelectedItem="{Binding Schedule.StreakRecovery}"
                                  Margin="0,2,0,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource StreakRecoveryLabel}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Expander>

                <!-- ===== Zone 2c: Mattone Obiettivo (Onda 2.5 T4) — solo se la composizione deriva
                     Counter (metrica numerica o tap counter, il precedente e' Water intake). ===== -->
                <StackPanel Margin="0,0,0,16"
                            Visibility="{Binding GoalBrick.IsAvailable, Converter={StaticResource BoolToVisible}}">
                    <ToggleButton Content="{x:Static res:Strings.HabitBuilder_Goal_Add}"
                                  IsChecked="{Binding GoalBrick.HasGoal}"
                                  HorizontalAlignment="Left"
                                  Padding="10,5"/>
                    <StackPanel Margin="0,8,0,0"
                                Visibility="{Binding GoalBrick.HasGoal, Converter={StaticResource BoolToVisible}}">
                        <TextBlock Text="{x:Static res:Strings.HabitBuilder_Goal_Target}"
                                   FontSize="{StaticResource FontSize.Small}"
                                   Foreground="{DynamicResource Brush.TextMuted}"
                                   Margin="0,0,0,2"/>
                        <TextBox Padding="6,4"
                                 HorizontalAlignment="Left"
                                 MinWidth="120"
                                 Margin="0,0,0,8">
                            <TextBox.Text>
                                <Binding Path="GoalBrick.Target" UpdateSourceTrigger="LostFocus" TargetNullValue="">
                                    <Binding.ValidationRules>
                                        <beh:NumericInputRule/>
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>
                        <!-- Niente selettore di periodo qui (review 2.5, F1): un goal "a periodo" o
                             "mobile" richiede date di inizio/fine o un numero di giorni, che il
                             vincolo ck_goal_period_consistency pretende e il builder non ha campi per
                             raccogliere — offrirlo faceva fallire Lancia con una violazione di
                             constraint, in silenzio. Il builder compone goal aperti (l'unica forma che
                             i template ufficiali usano); il periodo si imposta in Configura, che ha
                             i campi e la validazione. -->
                    </StackPanel>
                </StackPanel>

                <!-- ===== Zone 2d: Mattone Sessione (Onda 2.5 T5) — solo se la composizione deriva
                     Counter con campi da registrare (Workout log e' il precedente; un tap counter
                     nudo non ha nulla da segmentare). ===== -->
                <StackPanel Margin="0,0,0,16"
                            Visibility="{Binding SessionBrick.IsAvailable, Converter={StaticResource BoolToVisible}}">
                    <ToggleButton Content="{x:Static res:Strings.HabitBuilder_Session_Add}"
                                  IsChecked="{Binding SessionBrick.HasSession}"
                                  HorizontalAlignment="Left"
                                  Padding="10,5"/>
                    <StackPanel Margin="0,8,0,0"
                                Visibility="{Binding SessionBrick.HasSession, Converter={StaticResource BoolToVisible}}">
                        <ItemsControl ItemsSource="{Binding SessionBrick.Segments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SegmentRowViewModel}">
                                    <Border Margin="0,3"
                                            Padding="10,6"
                                            CornerRadius="4"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource Brush.Border}"
                                            Background="{DynamicResource Brush.SurfaceElevated}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     VerticalAlignment="Center"
                                                     Padding="6,3"
                                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                            <CheckBox Grid.Column="1"
                                                      Content="{x:Static res:Strings.HabitBuilder_Session_IsRest}"
                                                      IsChecked="{Binding IsRest}"
                                                      VerticalAlignment="Center"
                                                      Margin="10,0,0,0"/>
                                            <Button Grid.Column="2"
                                                    Content="✕"
                                                    Margin="8,0,0,0"
                                                    Padding="8,2"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DataContext.SessionBrick.RemoveSegmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="{x:Static res:Strings.HabitBuilder_Session_AddSegment}"
                                Padding="10,5"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Left"
                                Command="{Binding SessionBrick.AddSegmentCommand}"/>
                    </StackPanel>
                </StackPanel>

            </StackPanel>
            </ScrollViewer>

            <!-- Anteprima viva (E7): colonna fissa a destra, larga quanto una riga Home reale. -->
            <Border Grid.Column="1"
                    BorderThickness="1,0,0,0"
                    BorderBrush="{DynamicResource Brush.Border}"
                    Background="{DynamicResource Brush.Surface}">
                <hb:BuilderPreviewPane DataContext="{Binding Preview}"/>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
