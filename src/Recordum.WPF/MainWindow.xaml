<Window x:Class="Recordum.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Recordum.Presentation.ViewModels;assembly=Recordum.Presentation"
        xmlns:v="clr-namespace:Recordum.WPF.Views"
        xmlns:vt="clr-namespace:Recordum.WPF.Views.Timer"
        xmlns:vhs="clr-namespace:Recordum.WPF.Views.HabitScreen"
        xmlns:vw="clr-namespace:Recordum.WPF.Views.Workspace"
        xmlns:vb="clr-namespace:Recordum.WPF.Views.Backup"
        xmlns:res="clr-namespace:Recordum.Presentation.Resources;assembly=Recordum.Presentation"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainWindowViewModel, IsDesignTimeCreatable=False}"
        Title="{x:Static res:Strings.AppTitle}"
        MinWidth="880" MinHeight="620"
        Width="1280" Height="760"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        FontFamily="{DynamicResource Font.Default}"
        Background="{DynamicResource Brush.Background}">
    <!-- Custom chrome: dark title bar that blends with the theme. CaptionHeight gives drag /
         double-click-maximize on the 36px bar; ResizeBorderThickness keeps native resize + snap;
         UseAeroCaptionButtons=False because we draw our own min/max/close. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="Caption.Icon" TargetType="Path">
            <Setter Property="Width" Value="11"/>
            <Setter Property="Height" Value="11"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Stroke" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="StrokeThickness" Value="1.4"/>
        </Style>
        <Style x:Key="Caption.Button" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.SurfaceElevated}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Close gets the conventional red hover. -->
        <Style x:Key="Caption.CloseButton" TargetType="Button" BasedOn="{StaticResource Caption.Button}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#c42b1c"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="D1" Modifiers="Control"
                    Command="{Binding Home.SwitchTabCommand}"
                    CommandParameter="{x:Static vm:HomeTab.Active}"/>
        <KeyBinding Key="D2" Modifiers="Control"
                    Command="{Binding Home.SwitchTabCommand}"
                    CommandParameter="{x:Static vm:HomeTab.Archived}"/>
        <KeyBinding Key="D3" Modifiers="Control"
                    Command="{Binding Home.SwitchTabCommand}"
                    CommandParameter="{x:Static vm:HomeTab.Trash}"/>
        <KeyBinding Key="D4" Modifiers="Control"
                    Command="{Binding ShowChartsCommand}"/>
        <KeyBinding Key="D5" Modifiers="Control"
                    Command="{Binding ShowBackupHistoryCommand}"/>
        <KeyBinding Key="W" Modifiers="Control"
                    Command="{Binding Workspace.CloseActiveTabCommand}"/>
    </Window.InputBindings>
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,12,0">
                    <Button Width="32" Height="28" Margin="0,0,6,0"
                            Style="{StaticResource Caption.Button}"
                            Command="{Binding ToggleRibbonCommand}"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="{x:Static res:Strings.Workspace_ToggleRibbon}"
                            AutomationProperties.Name="{x:Static res:Strings.Workspace_ToggleRibbon}">
                        <Path Style="{StaticResource Caption.Icon}" Data="M4 6h16 M4 12h16 M4 18h16"/>
                    </Button>
                    <!-- Brand mark: a serif "R" (Palatino, the app's serif face) instead of the
                         old activity line-icon. Pinned to Font.Serif so the mark stays serif even
                         when the user sets the UI font to System. -->
                    <TextBlock Text="R" Margin="1,0,8,0" VerticalAlignment="Center"
                               FontFamily="{DynamicResource Font.Serif}"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Text}"/>
                    <TextBlock Text="{x:Static res:Strings.AppTitle}" VerticalAlignment="Center"
                               FontWeight="SemiBold" FontSize="12.5"
                               Foreground="{DynamicResource Brush.TextMuted}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="MinButton" Style="{StaticResource Caption.Button}" Click="OnMinimizeClick"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.Name="Minimize">
                        <Path Style="{StaticResource Caption.Icon}" Data="M5 12h14"/>
                    </Button>
                    <Button x:Name="MaxButton" Style="{StaticResource Caption.Button}" Click="OnMaximizeRestoreClick"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.Name="Maximize">
                        <Path x:Name="MaxIcon" Style="{StaticResource Caption.Icon}" Data="M5 5h14v14H5z"/>
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource Caption.CloseButton}" Click="OnCloseClick"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.Name="Close">
                        <Path Style="{StaticResource Caption.Icon}" Data="M6 6l12 12 M18 6L6 18"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content: icon ribbon | workspaces -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Auto so the column shrinks to 0 when the ribbon is hidden by the ☰ toggle. -->
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <v:WorkspaceRibbon Grid.Column="0"
                               Visibility="{Binding RibbonCollapsed, Converter={StaticResource InvBoolToVisible}}"/>

            <!-- Workspaces: Home panes OR Charts OR Backup history -->
            <Grid Grid.Column="1">
                <Grid Visibility="{Binding IsHomeWorkspace, Converter={StaticResource BoolToVisible}}">
                    <Grid.ColumnDefinitions>
                        <!-- No subject tab → Home fills the window; with a tab open it becomes a
                             collapsible sidebar (width 0 when collapsed, persisted width otherwise). -->
                        <ColumnDefinition x:Name="SidebarColumn">
                            <ColumnDefinition.Width>
                                <MultiBinding Converter="{StaticResource HomeColumnWidth}" Mode="OneWay">
                                    <Binding Path="Workspace.IsPanoramicaActive"/>
                                    <Binding Path="Workspace.SidebarCollapsed"/>
                                    <Binding Path="Workspace.SidebarWidth"/>
                                    <Binding Path="Workspace.IsFocusZen"/>
                                </MultiBinding>
                            </ColumnDefinition.Width>
                        </ColumnDefinition>
                        <ColumnDefinition Width="Auto"/>
                        <!-- Workspace (tab bar + content): hidden (0) when no subject tab so Home gets all the room. -->
                        <ColumnDefinition x:Name="WorkspaceColumn"
                                          Width="{Binding Workspace.IsPanoramicaActive, Converter={StaticResource OpenColumnWidth}, ConverterParameter=Invert}"/>
                    </Grid.ColumnDefinitions>
                    <v:HomeView Grid.Column="0" DataContext="{Binding Home}" ClipToBounds="True"/>
                    <GridSplitter x:Name="SidebarSplitter"
                                  Grid.Column="1"
                                  Width="4"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  ResizeBehavior="PreviousAndNext"
                                  Background="{DynamicResource Brush.Border}"
                                  ShowsPreview="False"
                                  DragCompleted="OnSidebarSplitterDragCompleted">
                        <GridSplitter.Visibility>
                            <MultiBinding Converter="{StaticResource SidebarSplitterVisibility}">
                                <Binding Path="Workspace.IsPanoramicaActive"/>
                                <Binding Path="Workspace.SidebarCollapsed"/>
                                <Binding Path="Workspace.IsFocusZen"/>
                            </MultiBinding>
                        </GridSplitter.Visibility>
                    </GridSplitter>
                    <vw:WorkspaceView Grid.Column="2" DataContext="{Binding Workspace}"/>
                </Grid>

                <v:ChartsView DataContext="{Binding Charts}"
                              Visibility="{Binding DataContext.IsChartsWorkspace,
                                           RelativeSource={RelativeSource AncestorType=Window},
                                           Converter={StaticResource BoolToVisible}}"/>
                <vb:BackupHistoryView DataContext="{Binding BackupHistory}"
                                      Visibility="{Binding DataContext.IsBackupHistoryWorkspace,
                                                   RelativeSource={RelativeSource AncestorType=Window},
                                                   Converter={StaticResource BoolToVisible}}"/>
            </Grid>
        </Grid>

        <vt:TimerStatusBar Grid.Row="2" DataContext="{Binding TimerStatusBar}"/>
    </Grid>
</Window>
