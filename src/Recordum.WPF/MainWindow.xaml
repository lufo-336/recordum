<Window x:Class="Recordum.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Recordum.WPF.ViewModels"
        xmlns:v="clr-namespace:Recordum.WPF.Views"
        xmlns:vt="clr-namespace:Recordum.WPF.Views.Timer"
        xmlns:vhs="clr-namespace:Recordum.WPF.Views.HabitScreen"
        xmlns:res="clr-namespace:Recordum.WPF.Resources"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainWindowViewModel, IsDesignTimeCreatable=False}"
        Title="{x:Static res:Strings.AppTitle}"
        MinWidth="880" MinHeight="620"
        Width="1280" Height="760"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        Background="{DynamicResource Brush.Background}">
    <Window.InputBindings>
        <KeyBinding Key="D1" Modifiers="Control"
                    Command="{Binding Home.SwitchTabCommand}"
                    CommandParameter="{x:Static vm:HomeTab.Active}"/>
        <KeyBinding Key="D2" Modifiers="Control"
                    Command="{Binding Home.SwitchTabCommand}"
                    CommandParameter="{x:Static vm:HomeTab.Archived}"/>
        <KeyBinding Key="D3" Modifiers="Control"
                    Command="{Binding Home.SwitchTabCommand}"
                    CommandParameter="{x:Static vm:HomeTab.Trash}"/>
        <KeyBinding Key="D4" Modifiers="Control"
                    Command="{Binding ShowChartsCommand}"/>
    </Window.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top-level workspace nav -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,4">
            <RadioButton Content="{x:Static res:Strings.Workspace_Home}" GroupName="ws"
                         IsChecked="{Binding IsHomeWorkspace, Mode=OneWay}"
                         Command="{Binding ShowHomeCommand}"/>
            <RadioButton Content="{x:Static res:Strings.Workspace_Charts}" GroupName="ws" Margin="8,0,0,0"
                         IsChecked="{Binding IsChartsWorkspace, Mode=OneWay}"
                         Command="{Binding ShowChartsCommand}"/>
        </StackPanel>

        <!-- Content area: Home panes OR Charts workspace -->
        <Grid Grid.Row="1">
            <Grid Visibility="{Binding IsHomeWorkspace, Converter={StaticResource BoolToVisible}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition x:Name="HabitScreenColumn" Width="0" MinWidth="0"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition x:Name="EditorPaneColumn" Width="0" MinWidth="0"/>
                </Grid.ColumnDefinitions>
                <v:HomeView Grid.Column="0" DataContext="{Binding Home}"/>
                <GridSplitter x:Name="HabitScreenSplitter"
                              Grid.Column="1"
                              Width="4"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext"
                              Background="{DynamicResource Brush.Border}"
                              ShowsPreview="False"
                              Visibility="{Binding Home.SelectedRow,
                                           RelativeSource={RelativeSource AncestorType=Window},
                                           Converter={StaticResource NullToVisibility}}"
                              DragCompleted="OnHabitScreenSplitterDragCompleted"/>
                <vhs:HabitScreen Grid.Column="2"
                                 DataContext="{Binding HabitScreen}"
                                 Visibility="{Binding Home.SelectedRow,
                                              RelativeSource={RelativeSource AncestorType=Window},
                                              Converter={StaticResource NullToVisibility}}"/>
                <GridSplitter x:Name="EditorPaneSplitter"
                              Grid.Column="3"
                              Width="4"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext"
                              Background="{DynamicResource Brush.Border}"
                              ShowsPreview="False"
                              Visibility="{Binding Editor.HasNode, Converter={StaticResource BoolToVisible}}"
                              DragCompleted="OnEditorPaneSplitterDragCompleted"/>
                <v:EditorPane Grid.Column="4"
                              DataContext="{Binding Editor}"
                              Visibility="{Binding Editor.HasNode, Converter={StaticResource BoolToVisible}}"/>
                <Popup x:Name="SettingsPopupHost"
                       Grid.Column="0" Grid.ColumnSpan="5"
                       StaysOpen="False"
                       Placement="MousePoint"
                       AllowsTransparency="True">
                    <v:SettingsPopup DataContext="{Binding Settings}"/>
                </Popup>
            </Grid>

            <v:ChartsView DataContext="{Binding Charts}"
                          Visibility="{Binding DataContext.IsChartsWorkspace,
                                       RelativeSource={RelativeSource AncestorType=Window},
                                       Converter={StaticResource BoolToVisible}}"/>
        </Grid>

        <vt:TimerStatusBar Grid.Row="2" DataContext="{Binding TimerStatusBar}"/>
    </Grid>
</Window>
