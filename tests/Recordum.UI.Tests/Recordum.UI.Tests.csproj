<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Avalonia.Headless.XUnit 12.1.2 depends on xunit.v3 (xunit.v3.extensibility.core 3.2.2),
         non su xunit v2: il pacchetto "xunit" 2.9.3 usato altrove nel repo (Recordum.Data.Tests)
         non è compatibile con l'attributo [AvaloniaFact]. Serve "xunit.v3", e il runner v3
         out-of-process richiede un apphost nativo (OutputType Exe), non la classica libreria
         di test in-process di VSTest v2. -->
    <OutputType>Exe</OutputType>
    <!-- xunit v3 fallisce la build senza apphost nativo (vedi sopra). Directory.Build.props
         imposta UseAppHost=false di default (workaround DriveFS sulla VM Windows): qui lo
         sovrascriviamo a true, ed essendo entrambe property di progetto vince davvero — a
         differenza di un -p:UseAppHost=false passato da riga di comando, che è una "global
         property" e batte qualunque assegnazione nel .csproj (per questo il default vive nel
         .props, sovrascrivibile per-progetto, e non si passa più a mano da riga di comando). -->
    <UseAppHost>true</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Recordum.UI/Recordum.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Il sorgente delle icone come risorsa incorporata di QUESTO assembly. Il compilatore Avalonia
         non lascia il testo di un .axaml leggibile da AssetLoader nell'assembly di produzione, e i
         test dei tratti (IconCatalogTests) hanno bisogno delle stringhe dei path per guardarne i
         segmenti. È lo stesso file, non una copia: se cambia, cambia anche qui. -->
    <EmbeddedResource Include="../../src/Recordum.UI/Themes/Icons.axaml" LogicalName="Icons.axaml" />
  </ItemGroup>
</Project>
