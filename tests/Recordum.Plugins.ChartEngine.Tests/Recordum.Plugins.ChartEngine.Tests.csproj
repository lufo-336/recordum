<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- NU1701: suppress transitive OpenTK / SkiaSharp.Views.WPF compatibility
         warning (same reason as in Recordum.Plugins.ChartEngine.csproj). -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Xunit.StaFact" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Recordum.Plugins.ChartEngine\Recordum.Plugins.ChartEngine.csproj" />
    <ProjectReference Include="..\..\src\Recordum.Plugins\Recordum.Plugins.csproj" />
  </ItemGroup>

</Project>
