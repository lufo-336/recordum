{
  "permissions": {
    "allow": [
      "Bash(cygpath *)",
      "Bash(tasklist)",
      "Bash(tasklist *)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Get-Process *)",
      "PowerShell(Write-Output *)",
      "PowerShell(Select-String *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard-main.js\"",
            "statusMessage": "Guardrail: branch check"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard-userdata.js\"",
            "statusMessage": "Guardrail: dati utente"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard-generated.js\"",
            "statusMessage": "Guardrail: file EF generati"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/stop-dirty.js\""
          }
        ]
      }
    ]
  }
}
