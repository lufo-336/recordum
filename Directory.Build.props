<Project>
  <PropertyGroup>
    <!-- Licensing: MIT. Full text in /LICENSE. -->
    <Authors>Luca Foglia</Authors>
    <Copyright>Copyright (c) 2026 Luca Foglia</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <LangVersion>13</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <NeutralLanguage>en-US</NeutralLanguage>
    <!-- Un RID solo, quello della macchina che builda: ogni build è RID-specific ed emette solo
         i nativi che servono (SkiaSharp/sqlcipher/QuestPDF), invece di copiarli per ~8 RID
         (osx/linux/win-x86/arm64…) in bin/ — la differenza è ~530 MB contro ~2.6 GB.
         Framework-dependent (SelfContained=false) tiene l'output piccolo: nessun runtime .NET
         incluso. Le fasi 5 (mobile) e 6 costruiscono i propri progetti e ri-risolvono i RID che
         servono a loro.
         Windows resta fissato a win-x64 (è la macchina di sviluppo primaria e il target di
         spedizione). Altrove si prende il RID dell'host, così Core/Data/Plugins — che sono
         net10.0 e portabili per progetto — si costruiscono e si testano davvero su Linux e su
         macOS, nativi inclusi. Un RID esplicito da riga di comando vince su entrambi. -->
    <!-- NB: qui NON si può usare $(NETCoreSdkPortableRuntimeIdentifier) — il .NET SDK lo definisce
         dopo Directory.Build.props, quindi arriverebbe vuoto e il RID sparirebbe del tutto, che è
         esattamente il build "tutti i RID" che questo blocco evita (misurato: output senza
         sottocartella RID). L'architettura la si chiede a RuntimeInformation, che è valutabile qui. -->
    <_HostArch>$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</_HostArch>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">linux-$(_HostArch)</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">osx-$(_HostArch)</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- UseAppHost=false di default: workaround per il lock CreateAppHost di DriveFS sulla VM
         Windows primaria (mount Google Drive), non serve/non nuoce sulle altre macchine. Sta qui
         come PROPERTY DI PROGETTO — sovrascrivibile da un singolo .csproj (es. un progetto xunit
         v3, che pretende l'apphost nativo e fallisce la build senza) — e non da riga di comando:
         una property globale (-p:UseAppHost=false) vince sempre su qualunque assegnazione nel
         .csproj, quindi passarla a mano rompe di nuovo quel progetto. Il default vive qui apposta
         perché sia raggirabile per-progetto quando serve. -->
    <UseAppHost>false</UseAppHost>
    <!-- NU1903: SQLitePCLRaw.lib.e_sqlite3 (transitive via EF Core Sqlite) is flagged for
         CVE-2025-6965 (SQLite < 3.50.2 memory corruption). It affects ALL 2.1.x releases and
         NO patched SQLitePCLRaw package exists yet, so it cannot be resolved by upgrading.
         Practical risk for Recordum is low: offline-first, local encrypted DB, no user-supplied
         SQL (the CVE needs crafted SQL). Keep it a VISIBLE warning (not silenced via NoWarn) so
         it stays on the radar, but don't fail the build. REMOVE this line once SQLitePCLRaw
         ships SQLite >= 3.50.2 and bump the package. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1903</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
